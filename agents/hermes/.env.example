# agents/hermes/.env.example — template for agents/hermes/.env (SECRETS).
# NEVER commit the real .env; it holds live keys. v0.22.2 (Task 12 migration).
# The migration script (migrate-to-v0.22.2.sh --apply) auto-generates the one
# NEW required variable (HERMES_API_SERVER_KEY) if it is missing.

# ── Required ────────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather (enables the Telegram gateway).
TELEGRAM_BOT_TOKEN=

# Telegram USER ID allowed to talk to the bot (the allowlist is user IDs in
# v0.22.2 — TELEGRAM_CHAT_ID is no longer read). For private chats the chat id
# equals the peer user id, so the previous TELEGRAM_ZMOR_CHAT_ID value is a
# valid allowlist entry. Multiple users: comma-separated.
TELEGRAM_ZMOR_CHAT_ID=

# LiteLLM master key (injected as OPENAI_API_KEY into the container).
LITELLM_MASTER_KEY=

# ── New in v0.22.2 ──────────────────────────────────────────────────────────

# Bearer key for the OpenAI-compatible API server (container-loopback only;
# serves GET /health used by the Docker healthcheck). Upstream REQUIRES a key
# (min 8 chars) whenever API_SERVER_ENABLED=true — the server refuses to start
# without one. Generate with: openssl rand -hex 32
HERMES_API_SERVER_KEY=

# ── Optional ────────────────────────────────────────────────────────────────

# Host UID/GID that owns ./config — the image remaps its internal `hermes`
# user to these values so files created in the container stay readable and
# writable on the host. Must be 1–65534 (non-root). Uncomment and set to
# `id -u` / `id -g` of the deployment user if you run Hermes as a non-root
# workflow (defaults to the image's internal UID 10000 otherwise).
#HERMES_UID=1000
#HERMES_GID=1000
