# ============================================================================
# SCARLIX OS v19.3.1 — EndeavourOS Edition
# Package list for bootstrap installer (install.sh)
#
# v17.9.7: multilib auto-enabled by install.sh (before steam/wine/lib32-*)
# v17.5: ISO profile removed — this list is used by install.sh (not mkarchiso)
#   - No calamares (ISO-only)
#   - No yay (installed via git clone + makepkg in install.sh)
#   - No archiso (build-only, not needed)
#   - nvidia-container-toolkit via yay (AUR) in install.sh Phase 3
#   - yq = python-yq (kislyuk) — supports jq syntax used by scarlix-mode/doctor.
#     install.sh Phase 1 verifies yq is functional; if broken, crit (fail-hard).
# ============================================================================

# === Base system ===
base
base-devel
pciutils  # v18.9.7 P0: Required for lspci GPU detection (bootstrap install before Phase 1)
linux
linux-headers
linux-lts
linux-lts-headers
linux-firmware
btrfs-progs
efibootmgr
grub
os-prober

# === Snapper / recovery ===
snapper
snap-pac

# === ZRAM ===
zram-generator

# === Docker ===
docker
docker-compose

# === Network / security / time ===
networkmanager
ufw
fail2ban
chrony
openssh

# === Development tools ===
git
curl
wget
jq
yq
bc
python
python-pip
python-virtualenv

# === Terminal / editors ===
neovim
tmux
htop
btop
rsync
restic
unzip
zip

# === Gaming (native — optional, can remove if AI-only server) ===
# This block IS the gaming-minimal profile. Opt-in extras (RetroArch,
# Gamescope, MangoHud, GameMode, Heroic, itch, Bottles) live in
# files/usr/local/share/scarlix/gaming-packages.conf and are installed ONLY
# via `scarlix-gaming-install --profile full` (never by install.sh).
# AI/server-only host: comment this block out before running install.sh
# (gaming-headless, see gaming/README.md).
steam
wine
wine-gecko
wine-mono
lutris

# === Audio (Pipewire stack) ===
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber
alsa-utils
portaudio

# === Bluetooth ===
bluez
bluez-utils
blueman

# === Utils ===
nano
whiptail

# === NOT in this list (installed by install.sh) ===
# yay — git clone + makepkg (AUR helper)
# nvidia-container-toolkit — via yay (AUR)
# downgrade — via yay (AUR, optional)
# nvidia* cuda* cudnn* — install.sh Phase 2
