# SCARLIX OS — Environment Variables (version from /etc/scarlix/VERSION)
# Copy to .env and fill in! NEVER commit .env!
# Generate secrets: openssl rand -hex 32
# NOTE: install.sh auto-generates /etc/scarlix/.env (secrets) + /opt/scarlix/.env (model paths)
# This template is for REFERENCE only — actual .env is auto-generated by generate-env.sh

# === ScarliHQ Auth (auto-generated by install.sh) ===
SCARLIHQ_TOKEN=  # openssl rand -hex 32 — required for dashboard API

# === Media Tools (auto-generated by install.sh, v19.6.7) ===
MEDIA_TOOLS_TOKEN=  # openssl rand -hex 32 — /convert stays 503-closed without it (KPK-19.6.6-P2-03)

# === ScarliHQ Per-Profile Authentication (v19.6.7, KPK-19.6.6-P1-01) ===
# Household isolation is a DELIBERATE act (single-user is the honest default):
# create /etc/scarlix/profile-tokens.conf (profile:token per line, chown
# 65532:65532 + chmod 400 — the .template install.sh ships) and restart, or
# declare the inline form here. One token = one identity; a family token can
# never select a foreign profile or skip its own policy; SCARLIHQ_TOKEN stays
# the ADMIN identity — rotate it if it was ever shared.
# SCARLIHQ_PROFILE_TOKENS=hugo:token,mon:token,xox:token
# SCARLIHQ_PROFILE_TOKENS_FILE=/etc/scarlix/profile-tokens.conf
# SCARLIHQ_SINGLE_USER=true  # logs the single-user mode explicitly

# === ScarliHQ AI Runtime — enforced monthly token budget (v19.6.7, KPK-19.6.6-P2-02) ===
# Default: /var/lib/scarlihq-budget/token-budget.json (compose mounts it rw;
# install.sh prepares the dir 0700/uid 65532). An EXPLICIT path that fails to
# load aborts startup; an unwritable default degrades budgets to loudly-warned
# informational metadata. Enforcement: reserve-before-forward, settle the
# provider-reported usage, failed attempts not billed, 429 on exhaustion.
# SCARLIHQ_AIRUNTIME_BUDGET_LEDGER=/var/lib/scarlihq-budget/token-budget.json

