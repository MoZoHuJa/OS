# SCARLIX OS — Buzz Nostr Relay workspace — FORMALLY DISABLED (v19.4.3, KPK-03)
#
# This compose file is RENAMED (docker-compose.yml -> docker-compose.yml.disabled)
# so no compose tooling can start it (CI compose-validation and smoke check_03
# globs match *.yml only — this file is deliberately out of every deploy path).
#
# Reason: the buzz-minio service pinned minio/minio:RELEASE.2024-10-13T13-34-50Z
# and upstream MinIO has discontinued ALL official artifact channels.
# Independently re-verified 2026-10-22 (KPK-03, fresh probes — not just the audit doc):
#   - Docker Hub repository minio/minio  -> HTTP 404 (repo deleted). The v2 registry
#     API answers 401 UNAUTHORIZED even with a valid anonymous pull token — which
#     means the repository is gone (control: library/redis answers 200 with the same
#     method — see docs/KPK_2026-10-22_REMEDIATION.md).
#   - quay.io/minio/minio                -> no public tags (401 with anonymous token)
#   - dl.min.io release + archive        -> HTTP 410 Gone
#   - github.com/minio/minio              -> ARCHIVED 2026-04-24; last source tag
#     RELEASE.2025-10-15T17-29-55Z (build-at-own-risk, no upstream support or
#     security updates — deliberately NOT pinned here)
# A clean `docker compose --profile buzz up` would therefore FAIL at image pull.
#
# Remediation decision (KpK review decision tree): formally disable the profile
# instead of switching to an unverified third-party mirror or a guessed version.
# Guarded by smoke check_19 (scarlix-smoke-test.sh) — the profile cannot be
# silently re-enabled without failing CI.
#
# To re-enable (host decision, docs/DEPENDENCY_AUDIT_2026-10-21.md §9):
#   1. Choose a supported S3-compatible image, or build MinIO from the last
#      archived source tag accepting the no-upstream-support risk.
#   2. Verify it exists: docker manifest inspect <image:tag>
#   3. Rename this file back to docker-compose.yml, re-pin buzz-minio,
#      and add the new pin to check_07 in files/usr/local/bin/scarlix-smoke-test.sh.
#
# Historical notes (preserved verbatim below):
#   v18.8.2 P1 (B-a/c): all buzz services marked profiles: [buzz] (was :latest
#     in default stack -> non-reproducible + ran by default).
#   v19.0.3 P1-3: buzz-relay image corrected to ghcr.io/block/buzz (the official
#     image; the -relay repo does not exist).
services:
  buzz-relay:
    # v18.8.2 P1: :latest — could NOT pin (GHCR API NO_ACCESS). Experimental profile.
    image: ghcr.io/block/buzz:latest
    # v19.0.3 P1-3: was ghcr.io/block/buzz-relay:latest (DENIED — repo doesn't exist).
    #   Official image is ghcr.io/block/buzz (verified: latest, main, sha-* tags).
    container_name: buzz-relay
    restart: unless-stopped
    # v18.8.2 P1: experimental profile — does NOT start in default compose up
    profiles: ["buzz"]
    ports:
      - "100.64.0.1:3000:3000"
    volumes:
      - ./data:/data
    environment:
      - BUZZ_RELAY_URL=ws://100.64.0.1:3000
      - BUZZ_DOMAIN=scarlix.local
      - POSTGRES_HOST=buzz-postgres
      - POSTGRES_PASSWORD=${BUZZ_POSTGRES_PASSWORD}
      - REDIS_URL=redis://buzz-redis:6379
      - MINIO_ENDPOINT=buzz-minio:9000
    depends_on: [buzz-postgres, buzz-redis, buzz-minio]
    networks: [scarlix-net]

  buzz-postgres:
    image: postgres:16-alpine
    container_name: buzz-postgres
    restart: unless-stopped
    # v18.8.2 P1: experimental profile — only starts with --profile buzz
    profiles: ["buzz"]
    volumes:
      - ./postgres/data:/var/lib/postgresql/data
    environment:
      - POSTGRES_PASSWORD=${BUZZ_POSTGRES_PASSWORD}
      - POSTGRES_DB=buzz
    networks: [scarlix-net]
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres"]
      interval: 10s
      timeout: 5s
      retries: 5

  buzz-redis:
    image: redis:7-alpine
    container_name: buzz-redis
    restart: unless-stopped
    # v18.8.2 P1: experimental profile — only starts with --profile buzz
    profiles: ["buzz"]
    networks: [scarlix-net]

  buzz-minio:
    # v18.8.2 P1: :latest — could NOT pin (Docker Hub API no tags). Experimental profile.
    # v19.4.2 P0-OPEN -> v19.4.3 KPK-03 RESOLVED-BY-DISABLEMENT: the pinned tag is
    #   pruned AND upstream discontinued ALL official channels (re-verified
    #   2026-10-22 — see file header). This whole compose file is disabled
    #   (renamed .disabled); the pin below is quarantined for reference ONLY.
    #   It is NOT deployable and NOT covered by registry checks (check_07)
    #   because no compose tooling can reach this file anymore.
    image: minio/minio:RELEASE.2024-10-13T13-34-50Z
    container_name: buzz-minio
    restart: unless-stopped
    # v18.8.2 P1: experimental profile — only starts with --profile buzz
    profiles: ["buzz"]
    ports:
      - "127.0.0.1:9000:9000"
    volumes:
      - ./minio/data:/data
    environment:
      - MINIO_ROOT_USER=scarlix
      - MINIO_ROOT_PASSWORD=${BUZZ_MINIO_PASSWORD}
    command: server /data
    networks: [scarlix-net]
networks:
  scarlix-net: { external: true }
