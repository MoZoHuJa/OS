#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v17.2 — EndeavourOS Edition — Setup Wizard
# Q8a: Added --skip-models + --experimental flags

TITLE="SCARLIX OS v17.2 Setup"

# Auto-detect NVIDIA dGPU (Q5a — ignore Intel iGPU)
NVIDIA_DGPU_COUNT=$(lspci -nn 2>/dev/null | grep -iE 'NVIDIA.*(VGA|3D)' | wc -l || echo 0)
if [ "$NVIDIA_DGPU_COUNT" -gt 0 ]; then
  SUGGESTED_TYPE="ai_server"
  SUGGESTED_DESC="Auto-detected: ${NVIDIA_DGPU_COUNT} NVIDIA dGPU(s)"
else
  SUGGESTED_TYPE="dev_workstation"
  SUGGESTED_DESC="Auto-detected: no NVIDIA dGPU"
fi

whiptail --title "$TITLE" --msgbox \
  "Vitaj v SCARLIX OS v17.2 (EndeavourOS Edition)!\n\n\
Minimal Working Baseline — 2-tier inference default.\n\
Base: EndeavourOS (near-vanilla Arch)\n\
Kernel: linux + linux-lts (fallback)\n\
BTRFS + Snapper · Pipewire · ZRAM min(ram/2, 16GB)\n\n\
Stlac Enter pre pokracovanie." 22 70

# PC type selection (auto-detect + override)
PC_TYPE=$(whiptail --title "$TITLE" --menu \
  "Vyber typ tohto PC:\n\n$SUGGESTED_DESC" 18 70 2 \
  "$SUGGESTED_TYPE" "← Auto-detected (odporúčané)" \
  "ai_server" "AI Server (EndeavourOS + NVIDIA + AI + Gaming)" \
  "dev_workstation" "Dev Workstation (Headless — coding + files)" 3>&1 1>&2 2>&3) || PC_TYPE="$SUGGESTED_TYPE"

DEFAULT_IP="192.168.1.100"
[ "$PC_TYPE" = "dev_workstation" ] && DEFAULT_IP="192.168.1.101"
IP=$(whiptail --title "$TITLE" --inputbox "IP adresa:" 10 50 "$DEFAULT_IP" 3>&1 1>&2 2>&3)

PASS=$(whiptail --title "$TITLE" --passwordbox "Heslo pre scarlix user:" 10 50 3>&1 1>&2 2>&3)

TG_TOKEN=$(whiptail --title "$TITLE" --inputbox "Telegram Bot Token (prazdne = preskoc):" 10 60 "" 3>&1 1>&2 2>&3)
TG_CHAT_ID=""
[ -n "$TG_TOKEN" ] && TG_CHAT_ID=$(whiptail --title "$TITLE" --inputbox "Telegram Chat ID:" 10 50 "" 3>&1 1>&2 2>&3)

# Q8a: Model download opt-in (default: skip, user opts in)
DOWNLOAD_MODELS=$(whiptail --title "$TITLE" --menu \
  "Stiahnuť AI modely (50-150GB) pri first-boot?" 15 70 2 \
  "skip" "Preskočiť (rýchlejšia inštalácia, stiahnem neskôr)" \
  "download" "Áno, stiahnuť na pozadí (trvá hodiny)" 3>&1 1>&2 2>&3) || DOWNLOAD_MODELS="skip"

# Q3a: Experimental mode opt-in (vLLM/FreeToken/Laya)
EXPERIMENTAL=$(whiptail --title "$TITLE" --menu \
  "Experimental inference backends?\n(vLLM Multi-LoRA, FreeToken MoE, Laya router)" 15 70 2 \
  "no" "Nie — 2-tier default (SGLang + BeeLlama) — odporúčané" \
  "yes" "Áno — zapnúť experimentálne (potrebuje 2+ GPU)" 3>&1 1>&2 2>&3) || EXPERIMENTAL="no"

# Save config
echo "$PC_TYPE" | sudo tee /etc/scarlix/pc_type >/dev/null
sudo mkdir -p /etc/scarlix /var/lib/scarlix 2>/dev/null

if [ "$DOWNLOAD_MODELS" = "skip" ]; then
  sudo touch /etc/scarlix/.skip-models
fi
if [ "$EXPERIMENTAL" = "yes" ]; then
  sudo touch /etc/scarlix/.experimental
fi

# Static IP
sudo nmcli connection modify "Wired connection 1" \
  ipv4.addresses "$IP/24" \
  ipv4.gateway 192.168.1.1 \
  ipv4.dns "1.1.1.1 8.8.8.8" \
  ipv4.method manual 2>/dev/null || true

# Generate .env
export TELEGRAM_BOT_TOKEN="$TG_TOKEN"
export TELEGRAM_ZMOR_CHAT_ID="$TG_CHAT_ID"
sudo /etc/systemd/system/generate-env.sh

# Copy SCARLIX source
if [ -d /opt/scarlix-src ]; then
  sudo cp -r /opt/scarlix-src/* /opt/scarlix/ 2>/dev/null || true
fi

# Enable first-boot service
sudo systemctl enable scarlix-first-boot.service

# Enable model-manager timer
[ -f /etc/systemd/system/model-manager.timer ] && sudo systemctl enable model-manager.timer 2>/dev/null

# Confirm
whiptail --title "$TITLE" --yesno \
  "PC Typ: $PC_TYPE\nIP: $IP\nModely: $DOWNLOAD_MODELS\nExperimental: $EXPERIMENTAL\n\nFirst-boot: ENABLED (3-phase, auto-resume)\nReboot for automatic setup?" 20 60 3>&1 1>&2 2>&3

echo ""
echo "========================================"
echo "  SCARLIX OS v17.2 — EndeavourOS Edition"
echo "  Setup complete!"
echo "  PC Type: $PC_TYPE"
echo "  Models: $DOWNLOAD_MODELS"
echo "  Experimental: $EXPERIMENTAL"
echo "  First-boot: ENABLED (3-phase checkpointed, Restart=on-failure)"
echo "  Reboot to start automatic setup."
echo "  Dashboard: http://$IP:8090"
echo "========================================"
