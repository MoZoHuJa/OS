[Unit]
Description=SCARLIX OS v17.2.1 First Boot (3-phase checkpointed, auto-resume)
After=network-online.target docker.service
Wants=network-online.target
[Service]
Type=oneshot
ExecStart=/etc/systemd/system/first-boot.sh
RemainAfterExit=yes
TimeoutStartSec=3600
Restart=on-failure
RestartSec=30s
StartLimitBurst=5
[Install]
WantedBy=multi-user.target
