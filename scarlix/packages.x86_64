# ============================================================================
# SCARLIX OS v17.0 — EndeavourOS Edition
# archiso packages.x86_64
#
# v17.0 changes vs v16.5:
#   - Removed all garuda-* packages (Garuda → EndeavourOS)
#   - Removed linux-zen (default = vanilla linux, fallback = linux-lts)
#   - Switched audio: pulseaudio → pipewire stack
#   - Added: efibootmgr, grub, os-prober, openssh, btop, unzip, zip, snap-pac-grub
#   - NVIDIA + CUDA intentionally ABSENT (post-install via first-boot.sh)
# ============================================================================

# === Base system ===
base
base-devel
linux
linux-headers
linux-lts
linux-lts-headers
linux-firmware
btrfs-progs
efibootmgr
grub
os-prober

# === Snapper / recovery ===
snapper
snap-pac
snap-pac-grub

# === ZRAM ===
zram-generator

# === Docker ===
