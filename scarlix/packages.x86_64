git
curl
wget
jq
bc
python
python-pip

# === Terminal / editors ===
neovim
tmux
htop
btop
rsync
restic
unzip
zip

# === Gaming (native) ===
steam
wine
wine-gecko
wine-mono
lutris

# === Audio (Pipewire stack) ===
pipewire
pipewire-pulse
pipewire-alsa
pipewire-jack
wireplumber
alsa-utils
portaudio

# === Bluetooth ===
