# ============================================================================
# SCARLIX OS v17.2 — EndeavourOS Edition — Minimal Working Baseline
# archiso packages.x86_64
#
# v17.2 CORRECTION (vs v17.1):
#   - REMOVED: yay (was AUR, broke mkarchiso — P0 blocker)
#   - first-boot installs yay via git clone (git is in ISO)
#   - nvidia-container-toolkit from Docker official repo (not AUR)
#   - downgrade = optional (git install if user opts in)
#
# 2-tier default: SGLang + BeeLlama.cpp
# vLLM/FreeToken/Laya behind --profile experimental (opt-in)
# ============================================================================

# === Base system ===
base
base-devel
linux
linux-headers
linux-lts
linux-lts-headers
linux-firmware
btrfs-progs
efibootmgr
grub
os-prober

# === Snapper / recovery ===
snapper
snap-pac

# === ZRAM ===
zram-generator

# === Docker ===
docker
docker-compose

# === Network / security / time ===
networkmanager
ufw
fail2ban
chrony
openssh

