# ============================================================================
# SCARLIX OS v17.1 — EndeavourOS Edition
# archiso packages.x86_64
#
# v17.1 changes vs v17.0:
#   - Removed: snap-pac-grub (AUR), downgrade (AUR), archiso (build-only)
#   - Added: yay (AUR helper for first-boot AUR installs)
#   - Kept: snap-pac (sufficient for GRUB snapshots), all v17.0 packages
# ============================================================================

# === Base system ===
base
base-devel
linux
linux-headers
linux-lts
linux-lts-headers
linux-firmware
btrfs-progs
efibootmgr
grub
os-prober

# === Snapper / recovery ===
snapper
snap-pac

# === ZRAM ===
zram-generator

# === Docker ===
docker
docker-compose

# === AUR helper (first-boot installs downgrade + AUR packages) ===
yay

# === Network / security / time ===
networkmanager
ufw
fail2ban
chrony
openssh

# === Development tools ===
git
curl
wget
jq
bc
python
python-pip

# === Terminal / editors ===
neovim
tmux
htop
btop
rsync
restic
