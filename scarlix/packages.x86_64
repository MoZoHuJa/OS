bluez-utils
blueman

# === Installer ===
# v17.4: Calamares REMOVED (ISO-only, not needed for bootstrap install)
# calamares

# === Utils ===
nano
whiptail

# === Explicitly NOT in ISO ===
# yay — AUR package, breaks mkarchiso. Installed via git clone in first-boot.sh
# nvidia* cuda* cudnn* — post-install via first-boot.sh
# archiso — build-host only
# nvidia-container-toolkit — from Docker official repo (added to pacman.conf), not AUR
# downgrade — optional, installed via yay if user opts in
# vllm/freetoken/laya docker images — pulled on demand if --experimental
