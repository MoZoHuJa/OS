#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v18.4 — EndeavourOS Edition — Setup Wizard
# v18.4: gateway prompt (was hardcoded 192.168.1.1), version unified
# v17.5: Creates .experimental if 2+ GPU (Q3a — vLLM starts without --profile gate)

TITLE="SCARLIX OS v18.4 Setup"

NVIDIA_DGPU_COUNT=$(lspci -nn 2>/dev/null | grep -iE 'NVIDIA.*(VGA|3D)' | wc -l || echo 0)
if [ "$NVIDIA_DGPU_COUNT" -gt 0 ]; then
  SUGGESTED_TYPE="ai_server"
  SUGGESTED_DESC="Auto-detected: ${NVIDIA_DGPU_COUNT} NVIDIA dGPU(s)"
else
  SUGGESTED_TYPE="dev_workstation"
  SUGGESTED_DESC="Auto-detected: no NVIDIA dGPU"
fi

whiptail --title "$TITLE" --msgbox --ok-button "OK" \
  "Vitaj v SCARLIX OS v18.4 (EndeavourOS Edition)!\n\n\
Working AI Path — model-aware, fail-hard.\n\
Base: EndeavourOS (near-vanilla Arch)\n\
Kernel: linux + linux-lts (fallback)\n\
BTRFS + Snapper · Pipewire · ZRAM min(ram/2, 16GB)\n\n\
Detected: ${NVIDIA_DGPU_COUNT} NVIDIA dGPU(s)\n\
$([ "$NVIDIA_DGPU_COUNT" -ge 2 ] && echo "→ SGLang GPU0 + vLLM GPU1 (TP=1, mixed arch safe)" || echo "→ SGLang + BeeLlama")\n\n\
Stlac Enter pre pokracovanie." 22 70

PC_TYPE=$(whiptail --title "$TITLE" --menu \
  "Vyber typ tohto PC:\n\n$SUGGESTED_DESC" 18 70 2 \
  "$SUGGESTED_TYPE" "← Auto-detected (odporúčané)" \
  "ai_server" "AI Server (EndeavourOS + NVIDIA + AI + Gaming)" \
  "dev_workstation" "Dev Workstation (Headless — coding + files)" 3>&1 1>&2 2>&3) || PC_TYPE="$SUGGESTED_TYPE"

# v18.4 P2: whiptail ESC/Cancel handling (was: set -e aborts whole script)
DEFAULT_IP="192.168.1.100"
[ "$PC_TYPE" = "dev_workstation" ] && DEFAULT_IP="192.168.1.101"
IP=$(whiptail --title "$TITLE" --inputbox "IP adresa:" 10 50 "$DEFAULT_IP" 3>&1 1>&2 2>&3) || { echo "Wizard cancelled."; exit 0; }
# v18.4 P2: validate IP (empty if user just pressed Enter on empty box)
[ -z "$IP" ] && IP="$DEFAULT_IP"

# v18.4 P2: whiptail ESC handling
GATEWAY=$(whiptail --title "$TITLE" --inputbox "Gateway (router) IP:" 10 50 "$DEFAULT_GW" 3>&1 1>&2 2>&3) || GATEWAY="$DEFAULT_GW"
[ -z "$GATEWAY" ] && GATEWAY="$DEFAULT_GW"

# v17.9.6: PASS removed (was never applied to user — misleading input)
# User sets password during EndeavourOS Calamares install

# v18.4 P2: whiptail ESC handling
TG_TOKEN=$(whiptail --title "$TITLE" --inputbox "Telegram Bot Token (prazdne = preskoc):" 10 60 "" 3>&1 1>&2 2>&3) || TG_TOKEN=""
TG_CHAT_ID=""
[ -n "$TG_TOKEN" ] && { TG_CHAT_ID=$(whiptail --title "$TITLE" --inputbox "Telegram Chat ID:" 10 50 "" 3>&1 1>&2 2>&3) || TG_CHAT_ID=""; }

DOWNLOAD_MODELS=$(whiptail --title "$TITLE" --menu \
  "Stiahnuť AI modely (50-150GB) po inštalácii?" 15 70 2 \
  "skip" "Preskočiť (stiahnem neskôr cez download-models.sh)" \
  "download" "Áno, spusti download-models.sh po inštalácii" 3>&1 1>&2 2>&3) || DOWNLOAD_MODELS="skip"

# Q3a: If 2+ GPU, auto-suggest experimental (creates .experimental flag)
if [ "$NVIDIA_DGPU_COUNT" -ge 2 ]; then
  DEFAULT_EXPERIMENTAL="yes"
  EXP_DESC="2+ GPU detekované → vLLM TP=1 odporúčané"
else
  DEFAULT_EXPERIMENTAL="no"
  EXP_DESC="${NVIDIA_DGPU_COUNT} GPU → 2-tier default"
fi

EXPERIMENTAL=$(whiptail --title "$TITLE" --menu \
  "vLLM backend? ($EXP_DESC)" 15 70 2 \
  "$DEFAULT_EXPERIMENTAL" "← Odporúčané" \
  "yes" "Áno — vLLM (TP=1, GPU1)" \
  "no" "Nie — SGLang + BeeLlama only" 3>&1 1>&2 2>&3) || EXPERIMENTAL="$DEFAULT_EXPERIMENTAL"

# Save config
echo "$PC_TYPE" | sudo tee /etc/scarlix/pc_type >/dev/null
sudo mkdir -p /etc/scarlix /var/lib/scarlix 2>/dev/null

if [ "$DOWNLOAD_MODELS" = "skip" ]; then
  sudo touch /etc/scarlix/.skip-models
fi
# Q3a: Create .experimental flag (vLLM starts without --profile gate)
if [ "$EXPERIMENTAL" = "yes" ]; then
  sudo touch /etc/scarlix/.experimental
fi

# Static IP
sudo nmcli connection modify "Wired connection 1" \
  ipv4.addresses "$IP/24" \
  ipv4.gateway "$GATEWAY" \
  ipv4.dns "1.1.1.1 8.8.8.8" \
  ipv4.method manual 2>/dev/null || true

export TELEGRAM_BOT_TOKEN="$TG_TOKEN"
export TELEGRAM_ZMOR_CHAT_ID="$TG_CHAT_ID"
sudo /etc/systemd/system/generate-env.sh

if [ -d /opt/scarlix-src ]; then
  sudo cp -r /opt/scarlix-src/* /opt/scarlix/ 2>/dev/null || true
fi

# Enable model-manager timer only (no first-boot service in v17.5)
[ -f /etc/systemd/system/model-manager.timer ] && sudo systemctl enable model-manager.timer 2>/dev/null

TIER_DESC="SGLang + BeeLlama"
[ "$EXPERIMENTAL" = "yes" ] && TIER_DESC="SGLang + vLLM (TP=1) + BeeLlama"

whiptail --title "$TITLE" --yesno \
  "PC Typ: $PC_TYPE\nIP: $IP\nGPU count: ${NVIDIA_DGPU_COUNT} NVIDIA\nModely: $DOWNLOAD_MODELS\nInference: $TIER_DESC\n\nPo inštalácii:\n  1. Reboot\n  2. download-models.sh\n  3. scarlix-mode ai" 22 65 3>&1 1>&2 2>&3

echo ""
echo "========================================"
echo "  SCARLIX OS v18.4 — EndeavourOS Edition"
echo "  Setup complete!"
echo "  PC Type: $PC_TYPE"
echo "  IP: $IP (gw: $GATEWAY)"
echo "  GPU: ${NVIDIA_DGPU_COUNT} NVIDIA dGPU(s)"
echo "  Models: $DOWNLOAD_MODELS"
echo "  Inference: $TIER_DESC"
echo "========================================"
echo "  NEXT STEPS:"
echo "    1. Reboot (activate NVIDIA driver)"
echo "    2. Download models: download-models.sh"
echo "    3. Start AI: scarlix-mode ai"
echo "========================================"
