#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v17.9.1 — Self-Diagnostic (scarlix-doctor)
# Checks: OS, kernel, NVIDIA, Docker, GPU, network, models, .env, health

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
PASS=0; FAIL=0; WARN=0

pass() { echo -e "  ${GREEN}✓ PASS${NC} $1"; PASS=$((PASS+1)); }
fail() { echo -e "  ${RED}✗ FAIL${NC} $1"; FAIL=$((FAIL+1)); }
warn() { echo -e "  ${YELLOW}⚠ WARN${NC} $1"; WARN=$((WARN+1)); }

echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║  SCARLIX OS v17.9.1 — System Diagnostic                      ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""

# === OS ===
echo "=== System ==="
[ -f /etc/arch-release ] && pass "Arch/EndeavourOS detected" || fail "Not Arch/EndeavourOS"
echo "  Kernel: $(uname -r)"
pacman -Q linux-lts >/dev/null 2>&1 && pass "linux-lts installed: $(pacman -Q linux-lts)" || warn "linux-lts not installed"

# === NVIDIA ===
echo ""
echo "=== NVIDIA ==="
if command -v nvidia-smi >/dev/null 2>&1; then
  pass "nvidia-smi available"
  GPU_COUNT=$(nvidia-smi --query-gpu=count --format=csv,noheader 2>/dev/null | head -1 || echo 0)
  pass "GPU count: $GPU_COUNT"
  nvidia-smi --query-gpu=index,name,memory.total,compute_cap --format=csv,noheader 2>/dev/null | while IFS=',' read -r idx name mem cap; do
    echo "    GPU $idx: $(echo $name | xargs) — $(echo $mem | xargs) MiB — sm_$(echo $cap | xargs)"
  done
else
  fail "nvidia-smi not available — driver not installed"
fi

pacman -Q nvidia-open >/dev/null 2>&1 && pass "nvidia-open: $(pacman -Q nvidia-open)" || pacman -Q nvidia >/dev/null 2>&1 && pass "nvidia: $(pacman -Q nvidia)" || fail "No NVIDIA driver package"

# === Docker ===
echo ""
echo "=== Docker ==="
if command -v docker >/dev/null 2>&1; then
  pass "Docker installed"
  if docker info >/dev/null 2>&1; then
    pass "Docker running"
    docker info 2>/dev/null | grep -qi "Runtimes.*nvidia" && pass "Docker NVIDIA runtime" || warn "Docker NVIDIA runtime not detected"
  else
    fail "Docker not running (start: sudo systemctl start docker)"
  fi
  docker network inspect scarlix-net >/dev/null 2>&1 && pass "Docker network: scarlix-net" || fail "Docker network scarlix-net missing (create: docker network create scarlix-net)"
else
  fail "Docker not installed"
fi

# === yq ===
echo ""
echo "=== Tools ==="
command -v yq >/dev/null 2>&1 && pass "yq installed: $(yq --version 2>&1 | head -1)" || fail "yq not installed (run: sudo pacman -S yq)"

# === Models ===
echo ""
echo "=== Models ==="
MODELS_YAML="/etc/scarlix/models.yaml"
if [ -f "$MODELS_YAML" ]; then
  pass "models.yaml exists: $MODELS_YAML"
  if command -v yq >/dev/null 2>&1; then
    SGLANG_PATH=$(yq -r '.sglang.model_path' "$MODELS_YAML" 2>/dev/null || echo "")
    [ -n "$SGLANG_PATH" ] && [ "$SGLANG_PATH" != "null" ] && pass "SGLang model_path: $SGLANG_PATH" || fail "SGLang model_path empty/null"
    [ -d "$SGLANG_PATH" ] && [ -f "$SGLANG_PATH/config.json" ] && pass "SGLang model exists (config.json found)" || warn "SGLang model not downloaded yet — run: download-models.sh"

    BEE_FILE=$(yq -r '.beellama.hf_file' "$MODELS_YAML" 2>/dev/null || echo "")
    BEE_PATH="/models/${BEE_FILE}"
    [ -f "$BEE_PATH" ] && pass "BeeLlama model exists: $BEE_PATH" || warn "BeeLlama model not downloaded yet"

    HF_REPO=$(yq -r '.sglang.hf_repo' "$MODELS_YAML" 2>/dev/null || echo "")
    [ -n "$HF_REPO" ] && [ "$HF_REPO" != "null" ] && pass "SGLang hf_repo: $HF_REPO" || warn "SGLang hf_repo not set"
  fi
else
  fail "models.yaml not found at $MODELS_YAML"
fi

# === .env ===
echo ""
echo "=== Environment ==="
ENV_FILE="/opt/scarlix/.env"
if [ -f "$ENV_FILE" ]; then
  pass ".env exists: $ENV_FILE"
  [ -r "$ENV_FILE" ] && pass ".env readable" || fail ".env not readable"
else
  fail ".env not found (run: scarlix-mode ai to generate)"
fi

# === Containers ===
echo ""
echo "=== Containers ==="
for c in sglang vllm beellama ollama-agent; do
  STATUS=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "not_found")
  if [ "$STATUS" = "not_found" ]; then
    echo "  • $c: not created"
  elif [ "$STATUS" = "running" ]; then
    HEALTH=$(docker inspect -f '{{.State.Health.Status}}' "$c" 2>/dev/null || echo "none")
    pass "$c: running (health: $HEALTH)"
  else
    warn "$c: $STATUS (not running)"
  fi
done

# === Disk ===
echo ""
echo "=== Disk ==="
[ -d /models ] && pass "/models exists ($(du -sh /models 2>/dev/null | cut -f1 || echo 'empty'))" || warn "/models not found"
df -h /models 2>/dev/null | tail -1 | awk '{print "  /models disk: "$3" used / "$4" avail ("$5")"}'

# === Summary ===
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  PASS: $PASS${NC}"
[ "$WARN" -gt 0 ] && echo -e "${YELLOW}║  WARN: $WARN${NC}"
[ "$FAIL" -gt 0 ] && echo -e "${RED}║  FAIL: $FAIL${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"

if [ "$FAIL" -gt 0 ]; then
  echo -e "${RED}System NOT ready — fix FAIL items above.${NC}"
  exit 1
elif [ "$WARN" -gt 0 ]; then
  echo -e "${YELLOW}System partially ready — check WARN items.${NC}"
  exit 0
else
  echo -e "${GREEN}System ready! Run 'scarlix-mode ai' to start AI.${NC}"
  exit 0
fi
