#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v18.9.1 — Self-Diagnostic (scarlix-doctor)
# v18.5: http_ok() with -k/--no-check-certificate fallback; host-bridge check; version unified
# v17.9.2: unhealthy = FAIL (not PASS), --fix mode, API healthcheck, docker group check

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; CYAN='\033[0;36m'; NC='\033[0m'
PASS=0; FAIL=0; WARN=0
FIX_MODE=0
STRICT_MODE=0
# v18.8.3 P1 (P1-7): Proper arg parser (was: `[[ "$1" == "--fix" ]]` only
#   checked $1 → `--fix --strict` combo didn't work. Now: while/case loop
#   supports any combination: --fix, --strict, --fix --strict, --strict --fix.)
while [ $# -gt 0 ]; do
  case "$1" in
    --fix) FIX_MODE=1 ;;
    --strict) STRICT_MODE=1 ;;
    -h|--help)
      echo "Usage: scarlix-doctor [--fix] [--strict]"
      echo "  --fix    : attempt automatic fixes for FAIL items"
      echo "  --strict : treat WARN as FAIL (exit 1 on any warning)"
      exit 0
      ;;
    *) echo "Unknown option: $1 (use --help)" >&2; exit 1 ;;
  esac
  shift
done

pass() { echo -e "  ${GREEN}✓ PASS${NC} $1"; PASS=$((PASS+1)); }
fail() { echo -e "  ${RED}✗ FAIL${NC} $1"; FAIL=$((FAIL+1)); }
# v18.8.2 P1: warn() promotes to fail in --strict mode
warn() {
  if [ "$STRICT_MODE" -eq 1 ]; then
    echo -e "  ${RED}✗ FAIL${NC} $1 (strict)"
    FAIL=$((FAIL+1))
  else
    echo -e "  ${YELLOW}⚠ WARN${NC} $1"
    WARN=$((WARN+1))
  fi
}

# P1 v18.5: HTTP check with curl -k → wget --no-check-certificate fallback (self-signed proxy safe)
http_ok() {
  local url="$1"
  if command -v curl >/dev/null 2>&1; then
    curl -sfk "$url" >/dev/null 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- --no-check-certificate "$url" >/dev/null 2>&1
  else
    return 127  # no http tool
  fi
}

# v18.5 P1: HTTP check WITH Bearer token (for authenticated API endpoints)
http_ok_with_token() {
  local url="$1" token="$2"
  if command -v curl >/dev/null 2>&1; then
    curl -sfk -H "Authorization: Bearer $token" "$url" >/dev/null 2>&1
  elif command -v wget >/dev/null 2>&1; then
    wget -qO- --no-check-certificate --header="Authorization: Bearer $token" "$url" >/dev/null 2>&1
  else
    return 127
  fi
}

# v18.8.2 P1 (P1-12): Named fix functions (was: `bash -c "$2"` — dynamically
#   executed shell string in privileged doctor. Even though strings were hardcoded,
#   it's not statically audit-friendly. Now: dispatch table maps fix name → named
#   function. Each fix is a standalone function, auditable with grep/static analysis.
fix_create_nvidia_runtime() {
  nvidia-ctk runtime configure --runtime=docker && systemctl restart docker
}
fix_start_docker() { systemctl start docker; }
fix_create_scarlix_net() { docker network create scarlix-net; }
fix_remove_old_scarlix_net() { docker network rm scarlix_net; }
fix_add_docker_group() { usermod -aG docker "$CURRENT_USER"; }
fix_install_yq() { pacman -S --noconfirm yq; }
# v18.8.3 P1 (P1-8): fix_generate_env now delegates to generate-env.sh (was: own
#   implementation that only wrote 3 model paths → would overwrite/lose SGLANG_*
#   runtime vars. Now: calls the canonical /etc/systemd/system/generate-env.sh
#   which is the single source of truth for /etc/scarlix/.env secrets. For
#   /opt/scarlix/.env model paths, scarlix-mode regenerates them on next run.)
# v18.8.5 P1 (P1-1): Fallback writes to /etc/scarlix/.env (secrets), NOT
#   /opt/scarlix/.env (was: fallback wrote model paths to /opt/scarlix/.env
#   → if doctor was called to fix missing /etc/scarlix/.env, fallback created
#   the WRONG file. Doctor said "Fixed" but /etc/scarlix/.env stayed missing.
#   Now: fallback writes minimal secrets (SCARLIHQ_TOKEN + LITELLM_MASTER_KEY)
#   to /etc/scarlix/.env, which is what the doctor check below expects.)
fix_generate_env() {
  if [ -f /etc/systemd/system/generate-env.sh ]; then
    /etc/systemd/system/generate-env.sh
  else
    # Fallback: minimal secrets to /etc/scarlix/.env (was: model paths to /opt/scarlix/.env)
    mkdir -p /etc/scarlix
    printf 'SCARLIHQ_TOKEN=%s\nLITELLM_MASTER_KEY=sk-scarlix-%s\n' \
      "$(openssl rand -hex 32)" "$(openssl rand -hex 32)" \
      > /etc/scarlix/.env && chmod 600 /etc/scarlix/.env
  fi
}
fix_add_scarlihq_token() {
  echo "SCARLIHQ_TOKEN=$(openssl rand -hex 32)" >> /etc/scarlix/.env
}
# v18.9.0 P1: Regenerate /etc/scarlix/.env when it contains orphan lines (was: old
#   base64-64 multiline writes left orphan lines that broke backup hook sourcing
#   under set -euo pipefail. Now: delegate to generate-env.sh if present, else
#   strip non-assignment lines in place.)
# v18.9.1 P1-2: fix_regenerate_env now actually sanitizes orphan lines (was:
#   called generate-env.sh which only adds missing keys → orphans remained →
#   doctor still FAIL on next run. Now: filter valid lines into temp, atomic mv.)
fix_regenerate_env() {
  local secrets_env="/etc/scarlix/.env"
  local tmp
  tmp=$(mktemp "${secrets_env}.XXXXXX") || return 1
  # Keep only valid lines: KEY=value, comments (#), or empty lines
  grep -E '^([A-Z_][A-Z0-9_]*=|#|$)' "$secrets_env" > "$tmp" 2>/dev/null || true
  chmod 600 "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  chown root:root "$tmp" 2>/dev/null || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$secrets_env" 2>/dev/null || { rm -f "$tmp"; return 1; }
  # Also ensure all required keys exist (generate-env.sh adds missing)
  if [ -f /etc/systemd/system/generate-env.sh ]; then
    /etc/systemd/system/generate-env.sh
  fi
}
fix_enable_host_bridge_timer() { systemctl enable --now scarlix-host-bridge.timer; }

fix() {
  if [ "$FIX_MODE" -eq 1 ]; then
    echo -e "  ${CYAN}🔧 FIX${NC} $1"
    # v18.8.2 P1: Dispatch to named function (was: bash -c "$2")
    local fn="$2"
    if command -v "$fn" >/dev/null 2>&1; then
      "$fn" 2>/dev/null && echo -e "  ${GREEN}  ✓ Fixed${NC}" || echo -e "  ${RED}  ✗ Fix failed${NC}"
    else
      echo -e "  ${RED}  ✗ Unknown fix function: $fn${NC}"
    fi
  fi
}

echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║  SCARLIX OS v18.9.1 — System Diagnostic                      ║${NC}"
[ "$FIX_MODE" -eq 1 ] && echo -e "${CYAN}║  (--fix mode: will attempt automatic fixes)                  ║${NC}"
[ "$STRICT_MODE" -eq 1 ] && echo -e "${CYAN}║  (--strict mode: WARN → FAIL, exit 1 on any warning)         ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
echo ""

# === OS ===
echo "=== System ==="
[ -f /etc/arch-release ] && pass "Arch/EndeavourOS detected" || fail "Not Arch/EndeavourOS"
echo "  Kernel: $(uname -r)"
pacman -Q linux-lts >/dev/null 2>&1 && pass "linux-lts: $(pacman -Q linux-lts)" || warn "linux-lts not installed"

# === NVIDIA ===
echo ""
echo "=== NVIDIA ==="
if command -v nvidia-smi >/dev/null 2>&1; then
  pass "nvidia-smi available"
  GPU_COUNT=$(nvidia-smi -L 2>/dev/null | wc -l || echo 0)
  pass "GPU count: $GPU_COUNT"
  nvidia-smi --query-gpu=index,name,memory.total,compute_cap --format=csv,noheader 2>/dev/null | while IFS=',' read -r idx name mem cap; do
    echo "    GPU $(echo $idx | xargs): $(echo $name | xargs) — $(echo $mem | xargs) MiB — sm_$(echo $cap | xargs)"
  done
else
  fail "nvidia-smi not available — driver not installed"
fi

# === Docker ===
echo ""
echo "=== Docker ==="
if command -v docker >/dev/null 2>&1; then
  pass "Docker installed"
  if docker info >/dev/null 2>&1; then
    pass "Docker running"
    docker info 2>/dev/null | grep -qi "Runtimes.*nvidia" && pass "Docker NVIDIA runtime" || { warn "Docker NVIDIA runtime not detected"; fix "create nvidia runtime" fix_create_nvidia_runtime; }
  else
    fail "Docker not running"
    fix "start docker" fix_start_docker
  fi
  docker network inspect scarlix-net >/dev/null 2>&1 && pass "Docker network: scarlix-net" || { fail "scarlix-net missing"; fix "create scarlix-net" fix_create_scarlix_net; }
  # Check for old scarlix_net
  docker network inspect scarlix_net >/dev/null 2>&1 && { warn "Old network scarlix_net found (should be scarlix-net)"; fix "remove old scarlix_net" fix_remove_old_scarlix_net; } || true
else
  fail "Docker not installed"
fi

# === Docker group ===
echo ""
echo "=== Docker Group ==="
CURRENT_USER="${SUDO_USER:-${USER:-$(whoami 2>/dev/null || echo '')}}"
if [ -n "$CURRENT_USER" ]; then
  if id -nG "$CURRENT_USER" 2>/dev/null | grep -qw docker; then
    pass "$CURRENT_USER in docker group"
  else
    warn "$CURRENT_USER not in docker group (needs: sudo usermod -aG docker $CURRENT_USER && re-login)"
    fix "add to docker group" fix_add_docker_group
  fi
fi

# === yq ===
echo ""
echo "=== Tools ==="
command -v yq >/dev/null 2>&1 && pass "yq: $(yq --version 2>&1 | head -1)" || { fail "yq not installed"; fix "install yq" fix_install_yq; }

# === Models ===
echo ""
echo "=== Models ==="
MODELS_YAML="/etc/scarlix/models.yaml"
if [ -f "$MODELS_YAML" ]; then
  pass "models.yaml exists"
  if command -v yq >/dev/null 2>&1; then
    SGLANG_PATH=$(yq -r '.sglang.model_path' "$MODELS_YAML" 2>/dev/null || echo "")
    [ -n "$SGLANG_PATH" ] && [ "$SGLANG_PATH" != "null" ] && pass "SGLang path: $SGLANG_PATH" || fail "SGLang model_path empty"
    [ -d "$SGLANG_PATH" ] && [ -f "$SGLANG_PATH/config.json" ] && pass "SGLang model exists" || warn "SGLang model not downloaded — run: download-models.sh"

    BEE_FILE=$(yq -r '.beellama.hf_file' "$MODELS_YAML" 2>/dev/null || echo "")
    [ -f "/models/${BEE_FILE}" ] && pass "BeeLlama model exists: /models/${BEE_FILE}" || warn "BeeLlama model not downloaded"

    HF_REPO=$(yq -r '.sglang.hf_repo' "$MODELS_YAML" 2>/dev/null || echo "")
    [ -n "$HF_REPO" ] && [ "$HF_REPO" != "null" ] && pass "SGLang hf_repo: $HF_REPO" || warn "SGLang hf_repo not set"
  fi
else
  fail "models.yaml not found"
fi

# === .env ===
echo ""
echo "=== Environment ==="
ENV_FILE="/opt/scarlix/.env"
if [ -f "$ENV_FILE" ]; then
  pass ".env exists (/opt/scarlix/.env — model paths)"
  [ -r "$ENV_FILE" ] && pass ".env readable" || fail ".env not readable"
else
  fail ".env not found"
  fix "generate .env" fix_generate_env
fi
# v18.5: /etc/scarlix/.env (secrets + SCARLIHQ_TOKEN)
SECRETS_ENV="/etc/scarlix/.env"
if [ -f "$SECRETS_ENV" ]; then
  pass "/etc/scarlix/.env exists (secrets + SCARLIHQ_TOKEN)"
  if grep -q "^SCARLIHQ_TOKEN=" "$SECRETS_ENV" 2>/dev/null; then
    pass "SCARLIHQ_TOKEN present (dashboard auth)"
  else
    fail "SCARLIHQ_TOKEN missing — dashboard will reject all API requests"
    fix "add SCARLIHQ_TOKEN" fix_add_scarlihq_token
  fi
else
  fail "/etc/scarlix/.env not found (run generate-env.sh)"
fi
# v18.9.0 P1: Check .env for orphan/invalid lines (was: old base64 64 multiline
#   orphans could break backup hook sourcing under set -euo pipefail)
if [ -f "$SECRETS_ENV" ]; then
  bad_lines=$(grep -vnE '^([A-Z_][A-Z0-9_]*=|#|$)' "$SECRETS_ENV" 2>/dev/null || echo "")
  if [ -n "$bad_lines" ]; then
    fail "/etc/scarlix/.env has invalid lines (orphan from old base64?):"
    echo "$bad_lines" | head -5 | sed 's/^/    /'
    fix "regenerate .env" fix_regenerate_env
  fi
fi

# === Host Bridge (v18.5) ===
echo ""
echo "=== Host Bridge (ScarliHQ dashboard backend) ==="
if systemctl is-active scarlix-host-bridge.timer >/dev/null 2>&1; then
  pass "scarlix-host-bridge.timer active"
else
  fail "scarlix-host-bridge.timer NOT active (dashboard will show stale/empty data)"
  fix "enable host-bridge timer" fix_enable_host_bridge_timer
fi
if [ -f /var/lib/scarlix/host-status.json ]; then
  STATUS_AGE=$(( $(date +%s) - $(stat -c %Y /var/lib/scarlix/host-status.json 2>/dev/null || echo 0) ))
  if [ "$STATUS_AGE" -lt 30 ]; then
    pass "host-status.json fresh (${STATUS_AGE}s old)"
  else
    warn "host-status.json stale (${STATUS_AGE}s old — timer may have stopped)"
  fi
else
  warn "host-status.json not found (first run may take 10s after timer start)"
fi

# === ScarliHQ Dashboard ===
echo ""
echo "=== ScarliHQ Dashboard ==="
SCARLIHQ_STATUS=$(docker inspect -f '{{.State.Status}}' scarlihq 2>/dev/null || echo "not_found")
if [ "$SCARLIHQ_STATUS" = "running" ]; then
  pass "scarlihq container: running"
  # Check if SCARLIHQ_TOKEN is set in the container env
  if docker inspect scarlihq 2>/dev/null | grep -q "SCARLIHQ_TOKEN"; then
    pass "SCARLIHQ_TOKEN configured in container"
  else
    fail "SCARLIHQ_TOKEN NOT in container env — API will return 503"
  fi
  # v18.5 P1: API health WITH token (was: no token → 401 → "not responding" false negative)
  SCARLIHQ_TOKEN_VAL=""
  [ -f /etc/scarlix/.env ] && SCARLIHQ_TOKEN_VAL=$(grep '^SCARLIHQ_TOKEN=' /etc/scarlix/.env 2>/dev/null | cut -d= -f2)
  if [ -n "$SCARLIHQ_TOKEN_VAL" ]; then
    # Test with Bearer token (should get 200)
    if http_ok_with_token http://127.0.0.1:8090/api/health "$SCARLIHQ_TOKEN_VAL"; then
      pass "ScarliHQ :8090 API healthy (200 with token)"
    else
      fail "ScarliHQ :8090 API not responding with valid token (check logs)"
    fi
    # Also verify version matches
    API_VER=$(curl -sfk -H "Authorization: Bearer $SCARLIHQ_TOKEN_VAL" http://127.0.0.1:8090/api/health 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin).get('version','?'))" 2>/dev/null || echo "?")
    if [ "$API_VER" != "?" ]; then
      info "  API version: $API_VER"
      [ "$API_VER" = "$(cat /etc/scarlix/VERSION 2>/dev/null || echo '?')" ] && pass "API version matches VERSION file" || warn "API version ($API_VER) ≠ VERSION file ($(cat /etc/scarlix/VERSION 2>/dev/null))"
    fi
  else
    # No token — just check port responds (will get 401)
    if http_ok http://127.0.0.1:8090/api/health; then
      pass "ScarliHQ :8090 responding (need token for /api/*)"
    else
      # 401 is expected without token — check if port is open
      if curl -sfk -o /dev/null http://127.0.0.1:8090/ 2>/dev/null; then
        pass "ScarliHQ :8090 responding (401 expected — token required)"
      else
        warn "ScarliHQ :8090 not responding (may still be starting)"
      fi
    fi
  fi
else
  warn "scarlihq container: $SCARLIHQ_STATUS (dashboard optional — run: docker compose -f /opt/scarlix/scarlihq/docker-compose.yml up -d)"
fi

# === Containers + API Health ===
echo ""
echo "=== AI Containers + API Health ==="
for c in sglang vllm beellama ollama-agent; do
  STATUS=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "not_found")
  if [ "$STATUS" = "not_found" ]; then
    echo "  • $c: not created"
    continue
  fi
  if [ "$STATUS" != "running" ]; then
    fail "$c: $STATUS (not running)"
    continue
  fi
  HEALTH=$(docker inspect -f '{{.State.Health.Status}}' "$c" 2>/dev/null || echo "none")
  # P0-6 v17.9.2: unhealthy = FAIL (was PASS)
  case "$HEALTH" in
    healthy)
      pass "$c: healthy"
      ;;
    starting)
      warn "$c: starting (health check in progress)"
      ;;
    unhealthy)
      fail "$c: unhealthy"
      ;;
    *)
      # No Docker healthcheck defined — try API health
      case "$c" in
        sglang)
          http_ok http://127.0.0.1:30000/health && pass "$c: API healthy" || warn "$c: running, API not responding"
          ;;
        vllm)
          http_ok http://127.0.0.1:8089/v1/models && pass "$c: API healthy" || warn "$c: running, API not responding"
          ;;
        beellama)
          http_ok http://127.0.0.1:11438/health && pass "$c: API healthy" || warn "$c: running, API not responding"
          ;;
        ollama-agent)
          http_ok http://127.0.0.1:11435/api/tags && pass "$c: API healthy" || warn "$c: running, API not responding"
          ;;
      esac
      ;;
  esac
done

# v18.8.1 P1: LiteLLM gateway check (was: doctor only checked individual engines,
#   not the unified gateway. If LiteLLM is down or routing is broken, clients
#   can't reach any backend even though SGLang/Ollama are healthy. Now: check
#   container + /health + /v1/models + logical model scarlix-default exists.)
echo ""
echo "=== LiteLLM Gateway ==="
LITELLM_STATUS=$(docker inspect -f '{{.State.Status}}' litellm 2>/dev/null || echo "not_found")
if [ "$LITELLM_STATUS" = "not_found" ]; then
  warn "litellm: not created (optional — unified gateway. Run: docker compose -f /opt/scarlix/ai/litellm/docker-compose.yml up -d)"
elif [ "$LITELLM_STATUS" != "running" ]; then
  warn "litellm: $LITELLM_STATUS (not running — gateway unavailable, direct backend access still works)"
else
  LITELLM_HEALTH=$(docker inspect -f '{{.State.Health.Status}}' litellm 2>/dev/null || echo "none")
  case "$LITELLM_HEALTH" in
    healthy)
      pass "litellm: healthy"
      ;;
    starting)
      warn "litellm: starting"
      ;;
    unhealthy)
      fail "litellm: unhealthy"
      ;;
    *)
      # No healthcheck — probe /health/liveliness directly (v18.8.6 P0:
      #   /health requires auth when master_key is set → 401 false-negative;
      #   /health/liveliness is unauthed liveness probe).
      if http_ok http://127.0.0.1:4001/health/liveliness; then
        pass "litellm: API healthy"
      else
        warn "litellm: running, /health/liveliness not responding"
      fi
      ;;
  esac
  # Check logical model scarlix-default exists in LiteLLM routing
  if [ -n "${LITELLM_MASTER_KEY:-}" ] || [ -f /etc/scarlix/.env ]; then
    # v18.8.2 P1: Read LITELLM_MASTER_KEY from /etc/scarlix/.env (was: /opt/scarlix/.env
    #   — that file holds only model paths, not secrets. Secrets are in /etc/scarlix/.env
    #   root:root 600. This was a direct consequence of P0-1 — the key wasn't generated
    #   at all, and even if it were, doctor looked in the wrong file.)
    LITELLM_KEY="${LITELLM_MASTER_KEY:-$(grep '^LITELLM_MASTER_KEY=' /etc/scarlix/.env 2>/dev/null | cut -d= -f2 || echo '')}"
    if [ -n "$LITELLM_KEY" ]; then
      if curl -sf --max-time 3 -H "Authorization: Bearer $LITELLM_KEY" http://127.0.0.1:4001/v1/models 2>/dev/null | grep -q "scarlix-default"; then
        pass "litellm: logical model 'scarlix-default' available"
      else
        warn "litellm: 'scarlix-default' not in /v1/models (routing config issue?)"
      fi
    fi
  fi

  # v18.8.2 P1 (P1-14): Verify SGLang backend model ID matches LiteLLM config
  # (was: doctor only checked 'scarlix-default' exists, not that the real backend
  #   model ID matches. LiteLLM config says openai/Qwen3-14B-AWQ, but SGLang might
  #   serve a different id depending on --model-path --served-model-name. If they
  #   don't match, LiteLLM primary always fails with "model not found".)
  if [ "$LITELLM_STATUS" = "running" ]; then
    SGLANG_STATUS=$(docker inspect -f '{{.State.Status}}' sglang 2>/dev/null || echo "not_found")
    if [ "$SGLANG_STATUS" = "running" ]; then
      # Get real model ID from SGLang /v1/models
      SGLANG_MODEL_ID=$(curl -sf --max-time 3 http://127.0.0.1:30000/v1/models 2>/dev/null | python3 -c "import json,sys; d=json.load(sys.stdin); print(d['data'][0]['id'] if d.get('data') else '')" 2>/dev/null || echo "")
      if [ -n "$SGLANG_MODEL_ID" ]; then
        # Check if LiteLLM config references this model
        if grep -q "model: openai/$SGLANG_MODEL_ID" /opt/scarlix/ai/litellm/config.yaml 2>/dev/null; then
          pass "sglang backend model ID '$SGLANG_MODEL_ID' matches LiteLLM config"
        else
          warn "sglang serves '$SGLANG_MODEL_ID' but LiteLLM config expects different ID (routing may fail)"
        fi
      fi
    fi
  fi
fi

# === Disk ===
echo ""
echo "=== Disk ==="
[ -d /models ] && pass "/models exists ($(du -sh /models 2>/dev/null | cut -f1 || echo 'empty'))" || warn "/models not found"
df -h /models 2>/dev/null | tail -1 | awk '{printf "  /models disk: %s used / %s avail (%s)\n", $3, $4, $5}'

# === Summary ===
echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  PASS: $PASS${NC}"
[ "$WARN" -gt 0 ] && echo -e "${YELLOW}║  WARN: $WARN${NC}"
[ "$FAIL" -gt 0 ] && echo -e "${RED}║  FAIL: $FAIL${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"

if [ "$FAIL" -gt 0 ]; then
  echo -e "${RED}System NOT ready — fix FAIL items above.${NC}"
  [ "$FIX_MODE" -eq 0 ] && echo "  Tip: run 'scarlix-doctor --fix' for automatic fixes, or '--strict' to treat warnings as failures."
  exit 1
elif [ "$WARN" -gt 0 ]; then
  echo -e "${YELLOW}System partially ready — check WARN items.${NC}"
  exit 0
else
  echo -e "${GREEN}System ready! Run 'scarlix-mode ai' to start AI.${NC}"
  exit 0
fi
