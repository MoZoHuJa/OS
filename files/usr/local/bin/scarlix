#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v19.1.17 — Unified CLI (read-only discovery)
#
# Purpose: Unified read-only discovery entry point. Lists GPUs, inference
# runtimes, models, and a system summary. Does NOT start/stop services, does
# NOT modify configs, does NOT allocate resources. Authoritative write tools
# (scarlix-mode, scarlix-doctor, scarlix-wizard, scarlix-host-bridge) remain
# unchanged — this binary DELEGATES to or READS FROM them.
#
# Design (ScaRgeN master guide §7, §100):
#   - READ-ONLY. Only discovery and status.
#   - Extend the existing CLI; do not compete with it.
#   - Graceful degradation: every external tool (nvidia-smi, docker, yq,
#     python3, curl/wget) is probed with `command -v` before use; missing
#     tools WARN rather than crash.
#   - Data sources prioritise runtime state (nvidia-smi, docker ps) over
#     static config.
#
# Usage:
#   scarlix [--json] <group> <action> [--help|-h]
#   scarlix --help | -h
#   scarlix

readonly SCARLIX_CLI_VERSION="19.1.17"

# --- colour helpers (matching scarlix-doctor style) -----------------------
if [ -t 1 ]; then
  RED=$'\033[0;31m'; GREEN=$'\033[0;32m'; YELLOW=$'\033[1;33m'
  CYAN=$'\033[0;36m'; BOLD=$'\033[1m'; NC=$'\033[0m'
else
  RED=''; GREEN=''; YELLOW=''; CYAN=''; BOLD=''; NC=''
fi
warn() { printf '%sWARN%s %s\n' "$YELLOW" "$NC" "$1" >&2; }
err()  { printf '%sERR %s %s\n' "$RED" "$NC" "$1" >&2; }

JSON_MODE=0

# --- usage -----------------------------------------------------------------
usage() {
  cat <<EOF
${BOLD}scarlix${NC} ${CYAN}v${SCARLIX_CLI_VERSION}${NC} — SCARLIX OS unified read-only CLI

${BOLD}USAGE${NC}
  scarlix [--json] <group> <action> [--help|-h]
  scarlix --help | -h
  scarlix

${BOLD}SUBCOMMANDS${NC} (all read-only)
  ${CYAN}system${NC} status    Overall system summary (version, mode, uptime, docker
                  container count, health probes for ScarliHQ/SGLang/vLLM).
  ${CYAN}gpu${NC} list          List NVIDIA GPUs (index, name, VRAM total, compute cap).
  ${CYAN}gpu${NC} status        Detailed per-GPU state (VRAM total/used/free, util,
                  temp, power, driver, CUDA version, compute cap).
  ${CYAN}runtime${NC} list      List inference runtimes (sglang, vllm, beellama,
                  ollama, litellm) with status, port, image.
  ${CYAN}model${NC} list        List configured models (models.yaml) vs files
                  present in /models/.

${BOLD}GLOBAL FLAGS${NC}
  --json          Emit normalised JSON instead of a human-readable table.
                  May appear before OR after the subcommand:
                    scarlix --json gpu list
                    scarlix gpu list --json

${BOLD}EXIT CODES${NC}
  0   success (or usage)
  2   unknown subcommand / bad arguments
EOF
}

group_help() {
  case "$1" in
    system)
      cat <<EOF
${BOLD}scarlix system${NC} — system summary

${BOLD}ACTIONS${NC}
  status   SCARLIX version, current mode, host uptime, running Docker
           container count, and quick health probes (ScarliHQ :8090,
           SGLang :30000, vLLM :8089). All probes are HTTP GET with a
           2s timeout; "down" = connection refused / timeout / non-2xx.

${BOLD}EXAMPLES${NC}
  scarlix system status
  scarlix --json system status
EOF
      ;;
    gpu)
      cat <<EOF
${BOLD}scarlix gpu${NC} — NVIDIA GPU discovery

${BOLD}ACTIONS${NC}
  list     One line per GPU: index, name, VRAM total (MiB), compute cap.
  status   Detailed per-GPU: VRAM total/used/free, utilisation %, temp,
           power draw, driver version, CUDA version, compute cap.

${BOLD}DATA SOURCES${NC}
  Primary : nvidia-smi --query-gpu=...
  Cached  : /var/lib/scarlix/gpu-layout (written once by install.sh) —
            used only when nvidia-smi is unavailable.

${BOLD}EXAMPLES${NC}
  scarlix gpu list
  scarlix --json gpu status
EOF
      ;;
    runtime)
      cat <<EOF
${BOLD}scarlix runtime${NC} — inference runtime discovery

${BOLD}ACTIONS${NC}
  list    One row per runtime (sglang, vllm, beellama, ollama, litellm):
          name, status (running/down), host port, image.

${BOLD}DATA SOURCES${NC}
  docker ps --filter name=<container> --format '{{.Status}}'
  Image + port mappings: hard-coded from the v19.0.7 compose files
  (ai/{sglang,vllm,llamacpp,ollama,litellm}/docker-compose.yml).

${BOLD}EXAMPLES${NC}
  scarlix runtime list
  scarlix --json runtime list
EOF
      ;;
    model)
      cat <<EOF
${BOLD}scarlix model${NC} — model configuration discovery

${BOLD}ACTIONS${NC}
  list    Configured models from models.yaml (sglang/vllm/beellama/ollama)
          vs files actually present in /models/.

${BOLD}DATA SOURCES${NC}
  Config truth : /etc/scarlix/models.yaml (fallback: \$SCARLIX_REPO/models.yaml,
                 then \$PWD/models.yaml).
  Filesystem   : /models/ directory listing.

${BOLD}EXAMPLES${NC}
  scarlix model list
  scarlix --json model list
EOF
      ;;
  esac
}

# --- helpers ---------------------------------------------------------------
# json_str escapes a string for JSON output (backslash, quote, control chars).
json_str() {
  local s="$1"
  s="${s//\\/\\\\}"; s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"; s="${s//$'\r'/\\r}"; s="${s//$'\t'/\\t}"
  printf '"%s"' "$s"
}

# trim leading/trailing whitespace from a single-line value
trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

health_badge() {
  if [ "$1" = "up" ]; then printf '%sup%s' "$GREEN" "$NC"
  else printf '%sdown%s' "$RED" "$NC"; fi
}

fmt_uptime() {
  local s="$1" d h m
  d=$((s / 86400)); s=$((s % 86400))
  h=$((s / 3600));  s=$((s % 3600))
  m=$((s / 60));    s=$((s % 60))
  if [ "$d" -gt 0 ]; then printf '%dd %dh %dm' "$d" "$h" "$m"
  elif [ "$h" -gt 0 ]; then printf '%dh %dm' "$h" "$m"
  else printf '%dm %ds' "$m" "$s"; fi
}

# --- arg parsing -----------------------------------------------------------
# Strip --json from anywhere in argv (friendly to both `scarlix --json gpu list`
# and `scarlix gpu list --json`).
argv=()
for a in "$@"; do
  if [ "$a" = "--json" ]; then JSON_MODE=1; else argv+=("$a"); fi
done
if [ ${#argv[@]} -eq 0 ]; then set --
else set -- "${argv[@]}"; fi

# empty / --help / -h  → usage
if [ $# -eq 0 ] || [ "$1" = "--help" ] || [ "$1" = "-h" ]; then
  usage; exit 0
fi

GROUP="$1"; shift || true
case "$GROUP" in
  system|gpu|runtime|model) ;;
  *)
    err "unknown subcommand: $GROUP"
    usage >&2
    exit 2
    ;;
esac

# `scarlix <group>` alone, or with --help/-h  → group help
if [ $# -eq 0 ] || [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  group_help "$GROUP"; exit 0
fi

ACTION="$1"; shift || true
case "$GROUP/$ACTION" in
  system/status|gpu/list|gpu/status|runtime/list|model/list) ;;
  *)
    err "unknown action '$ACTION' for group '$GROUP'"
    group_help "$GROUP" >&2
    exit 2
    ;;
esac

if [ $# -gt 0 ]; then
  err "unexpected argument: $*"
  exit 2
fi

# ============================================================================
# Subcommand: system status
# ============================================================================
cmd_system_status() {
  local version="unknown" mode="unknown" uptime_s=0 docker_count=0
  if [ -f /etc/scarlix/VERSION ]; then
    version=$(tr -d '[:space:]' < /etc/scarlix/VERSION 2>/dev/null || true)
    [ -z "$version" ] && version="unknown"
  fi
  if [ -f /var/lib/scarlix/current-mode ]; then
    mode=$(tr -d '[:space:]' < /var/lib/scarlix/current-mode 2>/dev/null || true)
    [ -z "$mode" ] && mode="unknown"
  fi
  if [ -r /proc/uptime ]; then
    uptime_s=$(awk '{printf "%d", $1}' /proc/uptime 2>/dev/null || echo 0)
  fi
  if command -v docker >/dev/null 2>&1; then
    docker_count=$(docker ps -q 2>/dev/null | wc -l)
    docker_count=${docker_count// /}
  else
    warn "docker not available — container count will be 0"
  fi

  local scarlihq="down" sglang="down" vllm="down"
  if command -v curl >/dev/null 2>&1; then
    if curl -sf --max-time 2 -o /dev/null http://127.0.0.1:8090/ 2>/dev/null; then scarlihq="up"; fi
    if curl -sf --max-time 2 -o /dev/null http://127.0.0.1:30000/health 2>/dev/null; then sglang="up"; fi
    if curl -sf --max-time 2 -o /dev/null http://127.0.0.1:8089/v1/models 2>/dev/null; then vllm="up"; fi
  elif command -v wget >/dev/null 2>&1; then
    if wget -qO- --timeout=2 http://127.0.0.1:8090/ >/dev/null 2>&1; then scarlihq="up"; fi
    if wget -qO- --timeout=2 http://127.0.0.1:30000/health >/dev/null 2>&1; then sglang="up"; fi
    if wget -qO- --timeout=2 http://127.0.0.1:8089/v1/models >/dev/null 2>&1; then vllm="up"; fi
  else
    warn "curl/wget not available — health probes skipped"
  fi

  if [ "$JSON_MODE" -eq 1 ]; then
    printf '{"version":%s,"mode":%s,"uptime_seconds":%d,"docker_containers":%d,"health":{"scarlihq":%s,"sglang":%s,"vllm":%s}}\n' \
      "$(json_str "$version")" "$(json_str "$mode")" "${uptime_s:-0}" "${docker_count:-0}" \
      "$(json_str "$scarlihq")" "$(json_str "$sglang")" "$(json_str "$vllm")"
    return 0
  fi

  printf '=== SCARLIX OS v%s — system status ===\n' "$version"
  printf '  %-22s %s\n' "Version:" "$version"
  printf '  %-22s %s\n' "Mode:" "$mode"
  printf '  %-22s %s\n' "Uptime:" "$(fmt_uptime "${uptime_s:-0}")"
  printf '  %-22s %s\n' "Docker containers:" "${docker_count:-0} running"
  printf '\n  Quick health (2s timeout):\n'
  printf '    %-20s %s\n' "ScarliHQ :8090" "$(health_badge "$scarlihq")"
  printf '    %-20s %s\n' "SGLang :30000" "$(health_badge "$sglang")"
  printf '    %-20s %s\n' "vLLM :8089" "$(health_badge "$vllm")"
}

# ============================================================================
# Subcommand: gpu list / gpu status
# ============================================================================
cmd_gpu_list() {
  # v19.0.8: delegate --json path to the scarlix-gpu binary when present.
  # It emits the full 14-field inventory.GPU schema (data contract §2),
  # richer than the bash-native 4-field JSON below. Falls back to the
  # bash-native path if scarlix-gpu is not installed.
  if [ "$JSON_MODE" -eq 1 ]; then
    if command -v scarlix-gpu >/dev/null 2>&1; then
      scarlix-gpu 2>/dev/null
      return $?
    fi
    if command -v /usr/local/bin/scarlix-gpu >/dev/null 2>&1; then
      /usr/local/bin/scarlix-gpu 2>/dev/null
      return $?
    fi
    # else: fall through to the bash-native JSON below.
  fi

  if ! command -v nvidia-smi >/dev/null 2>&1; then
    if [ -r /var/lib/scarlix/gpu-layout ]; then
      warn "nvidia-smi unavailable — using cached /var/lib/scarlix/gpu-layout"
      _gpu_list_from_layout; return 0
    fi
    warn "nvidia-smi unavailable — no GPU data"
    if [ "$JSON_MODE" -eq 1 ]; then printf '[]\n'; fi
    return 0
  fi

  local data
  data=$(nvidia-smi --query-gpu=index,name,memory.total,compute_cap \
        --format=csv,noheader,nounits 2>/dev/null) || data=""
  if [ -z "$data" ]; then
    warn "nvidia-smi returned no GPUs"
    if [ "$JSON_MODE" -eq 1 ]; then printf '[]\n'; fi
    return 0
  fi

  local idx name total cap first=1
  if [ "$JSON_MODE" -eq 1 ]; then
    printf '['
    while IFS=',' read -r idx name total cap; do
      idx=$(trim "$idx"); name=$(trim "$name"); total=$(trim "$total"); cap=$(trim "$cap")
      [ $first -eq 0 ] && printf ','
      printf '{"index":%d,"name":%s,"vram_total_mb":%d,"compute_cap":%s}' \
        "${idx:-0}" "$(json_str "$name")" "${total:-0}" "$(json_str "$cap")"
      first=0
    done <<< "$data"
    printf ']\n'
    return 0
  fi

  printf '=== SCARLIX OS — GPU list ===\n'
  printf '%-6s %-32s %14s %12s\n' "IDX" "NAME" "VRAM (MiB)" "COMPUTE"
  printf '%s\n' "--------------------------------------------------------------"
  while IFS=',' read -r idx name total cap; do
    idx=$(trim "$idx"); name=$(trim "$name"); total=$(trim "$total"); cap=$(trim "$cap")
    printf '%-6s %-32s %14s %12s\n' "$idx" "$name" "$total" "sm_$cap"
  done <<< "$data"
}

# Fallback when nvidia-smi is missing: read install.sh's cached gpu-layout.
# Layout format (install.sh L530): index,name,pci.bus_id,compute_cap,memory.total
_gpu_list_from_layout() {
  local f=/var/lib/scarlix/gpu-layout
  local idx name _bus cap total first=1
  if [ "$JSON_MODE" -eq 1 ]; then
    printf '['
    while IFS=',' read -r idx name _bus cap total; do
      [ -z "$idx" ] && continue
      [ $first -eq 0 ] && printf ','
      printf '{"index":%d,"name":%s,"vram_total_mb":%d,"compute_cap":%s}' \
        "${idx:-0}" "$(json_str "$name")" "${total:-0}" "$(json_str "$cap")"
      first=0
    done < "$f"
    printf ']\n'
  else
    printf '=== SCARLIX OS — GPU list (from cache) ===\n'
    printf '%-6s %-32s %14s %12s\n' "IDX" "NAME" "VRAM (MiB)" "COMPUTE"
    while IFS=',' read -r idx name _bus cap total; do
      [ -z "$idx" ] && continue
      printf '%-6s %-32s %14s %12s\n' "$idx" "$name" "$total" "sm_$cap"
    done < "$f"
  fi
}

cmd_gpu_status() {
  # v19.0.8: delegate --json path to the scarlix-gpu binary when present.
  # It emits the full 14-field inventory.GPU schema (data contract §2) +
  # a per-GPU Health entry, richer than the bash-native 10-field JSON
  # below. Falls back to the bash-native path if scarlix-gpu is not installed.
  if [ "$JSON_MODE" -eq 1 ]; then
    if command -v scarlix-gpu >/dev/null 2>&1; then
      scarlix-gpu --health 2>/dev/null
      return $?
    fi
    if command -v /usr/local/bin/scarlix-gpu >/dev/null 2>&1; then
      /usr/local/bin/scarlix-gpu --health 2>/dev/null
      return $?
    fi
    # else: fall through to the bash-native JSON below.
  fi

  if ! command -v nvidia-smi >/dev/null 2>&1; then
    warn "nvidia-smi unavailable — no detailed GPU data"
    if [ "$JSON_MODE" -eq 1 ]; then printf '[]\n'; fi
    return 0
  fi

  local data
  data=$(nvidia-smi --query-gpu=index,name,memory.total,memory.used,memory.free,utilization.gpu,temperature.gpu,power.draw,driver_version,compute_cap \
        --format=csv,noheader,nounits 2>/dev/null) || data=""
  if [ -z "$data" ]; then
    warn "nvidia-smi returned no GPUs"
    if [ "$JSON_MODE" -eq 1 ]; then printf '[]\n'; fi
    return 0
  fi

  # driver + CUDA versions are host-global (one per host, not per-GPU).
  local driver="unknown" cuda="unknown"
  driver=$(nvidia-smi --query-gpu=driver_version --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr -d '[:space:]') || driver="unknown"
  [ -z "$driver" ] && driver="unknown"
  # CUDA version is printed in the nvidia-smi banner, not a --query-gpu field.
  cuda=$(nvidia-smi 2>/dev/null | sed -n 's/.*CUDA Version: \([0-9.][0-9.]*\).*/\1/p' | head -n1) || cuda="unknown"
  [ -z "$cuda" ] && cuda="unknown"

  local idx name total used free util temp power _drv cap first=1
  if [ "$JSON_MODE" -eq 1 ]; then
    printf '['
    while IFS=',' read -r idx name total used free util temp power _drv cap; do
      idx=$(trim "$idx"); name=$(trim "$name")
      total=$(trim "$total"); used=$(trim "$used"); free=$(trim "$free")
      util=$(trim "$util"); temp=$(trim "$temp"); power=$(trim "$power"); cap=$(trim "$cap")
      # power can be "[N/A]" on idle GPUs — normalise to 0 for the numeric field.
      case "$power" in N/A|"[N/A]"|'') power="0" ;; esac
      [ $first -eq 0 ] && printf ','
      printf '{"index":%d,"name":%s,"vram_total_mb":%d,"vram_used_mb":%d,"vram_free_mb":%d,"util_pct":%d,"temp_c":%d,"power_w":%s,"driver_version":%s,"compute_cap":%s}' \
        "${idx:-0}" "$(json_str "$name")" "${total:-0}" "${used:-0}" "${free:-0}" \
        "${util:-0}" "${temp:-0}" "$power" \
        "$(json_str "$driver")" "$(json_str "$cap")"
      first=0
    done <<< "$data"
    printf ']\n'
    return 0
  fi

  printf '=== SCARLIX OS — GPU status ===\n'
  printf '  Driver: %s   CUDA: %s\n' "$driver" "$cuda"
  printf '\n%-4s %-22s %8s %8s %8s %6s %5s %7s %s\n' \
    "IDX" "NAME" "VRAMtot" "VRAMused" "VRAMfree" "UTIL" "TEMP" "POWER" "CAP"
  local power_disp
  while IFS=',' read -r idx name total used free util temp power _drv cap; do
    idx=$(trim "$idx"); name=$(trim "$name")
    total=$(trim "$total"); used=$(trim "$used"); free=$(trim "$free")
    util=$(trim "$util"); temp=$(trim "$temp"); power=$(trim "$power"); cap=$(trim "$cap")
    power_disp="$power"
    case "$power" in N/A|"[N/A]"|'') power_disp="-" ;; esac
    printf '%-4s %-22s %7sM %7sM %7sM %5s%% %4sC %6sW sm_%s\n' \
      "$idx" "$name" "$total" "$used" "$free" "$util" "$temp" "$power_disp" "$cap"
  done <<< "$data"
}

# ============================================================================
# Subcommand: runtime list
# ============================================================================
# Static table of inference runtimes shipped in v19.0.7. Fields (tab-separated):
#   name \t host_port \t image \t container_name
# Sourced from ai/{sglang,vllm,llamacpp,ollama,litellm}/docker-compose.yml.
readonly RUNTIMES_TABLE=$'sglang|30000|lmsysorg/sglang:v0.4.9.post6-cu128-b200|sglang\nvllm|8089|vllm/vllm-openai:v0.8.5|vllm\nbeellama|11438|ghcr.io/ggml-org/llama.cpp@sha256:6d607629e3dd5e85f45c43d1494648126cb3f93f2122c9cd53f43242c94cde14|beellama\nollama|11435|ollama/ollama:0.5.4|ollama-agent\nlitellm|4001|ghcr.io/berriai/litellm:main-v1.21.7|litellm'

_runtime_status() {
  # Echoes "running" / "down" / "unknown" for the given container name.
  local container="$1" line
  if ! command -v docker >/dev/null 2>&1; then echo "unknown"; return; fi
  line=$(docker ps --filter "name=${container}" --format '{{.Status}}' 2>/dev/null | head -n1) || line=""
  case "$line" in
    Up*) echo "running" ;;
    *)   echo "down" ;;
  esac
}

cmd_runtime_list() {
  # v19.0.9: delegate --json path to the scarlix-inventory binary when present.
  # It emits the full 10-field inventory.Runtime schema (data contract §3) +
  # a per-runtime Health entry, richer than the bash-native 4-field JSON
  # below. Falls back to the bash-native path if scarlix-inventory is not
  # installed.
  if [ "$JSON_MODE" -eq 1 ]; then
    if command -v scarlix-inventory >/dev/null 2>&1; then
      scarlix-inventory --runtimes 2>/dev/null
      return $?
    fi
    if command -v /usr/local/bin/scarlix-inventory >/dev/null 2>&1; then
      /usr/local/bin/scarlix-inventory --runtimes 2>/dev/null
      return $?
    fi
    # else: fall through to the bash-native JSON below.
  fi

  if ! command -v docker >/dev/null 2>&1; then
    warn "docker not available — runtime status unknown"
  fi

  local name port image container status color first=1
  if [ "$JSON_MODE" -eq 1 ]; then
    printf '['
    while IFS='|' read -r name port image container; do
      [ -z "$name" ] && continue
      status=$(_runtime_status "$container")
      [ $first -eq 0 ] && printf ','
      printf '{"name":%s,"status":%s,"port":%d,"image":%s}' \
        "$(json_str "$name")" "$(json_str "$status")" "${port:-0}" "$(json_str "$image")"
      first=0
    done <<< "$RUNTIMES_TABLE"
    printf ']\n'
    return 0
  fi

  printf '=== SCARLIX OS — runtime list ===\n'
  printf '%-10s %-12s %-7s %s\n' "RUNTIME" "STATUS" "PORT" "IMAGE"
  while IFS='|' read -r name port image container; do
    [ -z "$name" ] && continue
    status=$(_runtime_status "$container")
    color="$RED"
    [ "$status" = "running" ] && color="$GREEN"
    [ "$status" = "unknown" ] && color="$YELLOW"
    printf '%-10s %s%-12s%s %-7s %s\n' "$name" "$color" "$status" "$NC" "$port" "$image"
  done <<< "$RUNTIMES_TABLE"
}

# ============================================================================
# Subcommand: model list
# ============================================================================
cmd_model_list() {
  # v19.0.9: delegate --json path to the scarlix-inventory binary when present.
  # It emits the full 10-field inventory.Model schema (data contract §4),
  # richer than the bash-native configured+files_present JSON below. Falls
  # back to the bash-native path if scarlix-inventory is not installed.
  if [ "$JSON_MODE" -eq 1 ]; then
    if command -v scarlix-inventory >/dev/null 2>&1; then
      scarlix-inventory --models 2>/dev/null
      return $?
    fi
    if command -v /usr/local/bin/scarlix-inventory >/dev/null 2>&1; then
      /usr/local/bin/scarlix-inventory --models 2>/dev/null
      return $?
    fi
    # else: fall through to the bash-native JSON below.
  fi

  local models_file=""
  for cand in "/etc/scarlix/models.yaml" "${SCARLIX_REPO:-}/models.yaml" "$PWD/models.yaml"; do
    if [ -n "$cand" ] && [ -f "$cand" ]; then models_file="$cand"; break; fi
  done
  local models_dir=""
  for cand in "/models" "${SCARLIX_REPO:-}/models" "$PWD/models"; do
    if [ -n "$cand" ] && [ -d "$cand" ]; then models_dir="$cand"; break; fi
  done

  if [ -z "$models_file" ]; then
    warn "models.yaml not found (looked in /etc/scarlix/, \$SCARLIX_REPO, \$PWD)"
  fi

  # configured[] holds pipe-separated records: name|engine|model_path|hf_repo
  # (pipe — not tab — because bash `read` collapses consecutive whitespace
  # IFS chars, which would lose empty model_path/hf_repo fields. Image/model
  # strings never contain `|`.)
  local configured=()
  if [ -n "$models_file" ]; then
    if command -v yq >/dev/null 2>&1; then
      local k engine mp hf val
      for k in sglang vllm beellama ollama; do
        case "$k" in
          sglang)   engine="sglang" ;;
          vllm)     engine="vllm" ;;
          beellama) engine="llamacpp" ;;
          ollama)   engine="ollama" ;;
        esac
        val=$(yq -r ".${k}" "$models_file" 2>/dev/null) || val="null"
        [ "$val" = "null" ] && continue
        mp=$(yq -r ".${k}.model_path // \"\"" "$models_file" 2>/dev/null) || mp=""
        hf=$(yq -r ".${k}.hf_repo // \"\"" "$models_file" 2>/dev/null) || hf=""
        configured+=("$(printf '%s|%s|%s|%s' "$k" "$engine" "$mp" "$hf")")
      done
    elif command -v python3 >/dev/null 2>&1 && python3 -c 'import yaml' 2>/dev/null; then
      warn "yq not available — falling back to python3+PyYAML"
      local recs k engine mp hf
      recs=$(python3 - "$models_file" <<'PY' 2>/dev/null
import sys, yaml
try:
    with open(sys.argv[1]) as f:
        data = yaml.safe_load(f) or {}
except Exception:
    data = {}
eng = {"sglang":"sglang","vllm":"vllm","beellama":"llamacpp","ollama":"ollama"}
for k in ("sglang","vllm","beellama","ollama"):
    if k in data and data[k]:
        d = data[k]
        # pipe-separated: empty fields preserved (tab would collapse)
        print("|".join([k, eng[k], str(d.get("model_path","")), str(d.get("hf_repo",""))]))
PY
) || recs=""
      while IFS='|' read -r k engine mp hf; do
        [ -z "$k" ] && continue
        configured+=("$(printf '%s|%s|%s|%s' "$k" "$engine" "$mp" "$hf")")
      done <<< "$recs"
    else
      warn "yq not available and python3+PyYAML not available — cannot parse models.yaml"
    fi
  fi

  local files_present=()
  if [ -n "$models_dir" ]; then
    local entry
    while IFS= read -r entry; do
      [ -n "$entry" ] && files_present+=("$entry")
    done < <(ls -1 "$models_dir" 2>/dev/null)
  fi

  if [ "$JSON_MODE" -eq 1 ]; then
    printf '{"configured":['
    local first=1 k engine mp hf
    if [ ${#configured[@]} -gt 0 ]; then
      for rec in "${configured[@]}"; do
        IFS='|' read -r k engine mp hf <<< "$rec"
        [ $first -eq 0 ] && printf ','
        printf '{"name":%s,"engine":%s,"model_path":%s,"hf_repo":%s}' \
          "$(json_str "$k")" "$(json_str "$engine")" "$(json_str "$mp")" "$(json_str "$hf")"
        first=0
      done
    fi
    printf '],"files_present":['
    first=1
    if [ ${#files_present[@]} -gt 0 ]; then
      local f
      for f in "${files_present[@]}"; do
        [ $first -eq 0 ] && printf ','
        printf '%s' "$(json_str "$f")"
        first=0
      done
    fi
    printf '],"models_dir":%s,"models_yaml":%s}\n' \
      "$(json_str "$models_dir")" "$(json_str "$models_file")"
    return 0
  fi

  printf '=== SCARLIX OS — model list ===\n'
  if [ -n "$models_file" ]; then printf '  Config: %s\n' "$models_file"
  else printf '  Config: %s(not found)%s\n' "$YELLOW" "$NC"; fi
  if [ -n "$models_dir" ];   then printf '  Dir   : %s\n' "$models_dir"
  else printf '  Dir   : %s(not found)%s\n' "$YELLOW" "$NC"; fi

  printf '\n  Configured models:\n'
  if [ ${#configured[@]} -eq 0 ]; then
    printf '    %s(none parsed)%s\n' "$YELLOW" "$NC"
  else
    printf '    %-10s %-10s %-40s %s\n' "NAME" "ENGINE" "MODEL_PATH" "HF_REPO"
    local k engine mp hf
    for rec in "${configured[@]}"; do
      IFS='|' read -r k engine mp hf <<< "$rec"
      printf '    %-10s %-10s %-40s %s\n' "$k" "$engine" "$mp" "$hf"
    done
  fi

  printf '\n  Files present in %s:\n' "${models_dir:-/models (not found)}"
  if [ ${#files_present[@]} -eq 0 ]; then
    printf '    %s(none / directory not found)%s\n' "$YELLOW" "$NC"
  else
    local f
    for f in "${files_present[@]}"; do
      printf '    %s\n' "$f"
    done
  fi
}

# ============================================================================
# Dispatch
# ============================================================================
case "$GROUP/$ACTION" in
  system/status)  cmd_system_status ;;
  gpu/list)       cmd_gpu_list ;;
  gpu/status)     cmd_gpu_status ;;
  runtime/list)   cmd_runtime_list ;;
  model/list)     cmd_model_list ;;
  *)
    err "internal dispatch error: $GROUP/$ACTION"
    exit 2
    ;;
esac
