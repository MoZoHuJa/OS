#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v19.1.11 — GPU Mode Switcher (Host-Bridge Architecture)
# v18.7.7 FIXES:
#   P0: TV mode uses systemctl restart (was: start on RemainAfterExit=yes oneshot
#       → service stays 'active' after first run → start doesn't re-run healthcheck
#       → container dead but mode=tv reported OK)
#   P0: Game stale-state repair (was: CURRENT_MODE=game → 'Already in Game mode' exit 0
#       even if Sunshine had crashed → never repaired)
#   P0: Creative stale-state repair (was: CURRENT_MODE=creative → 'Already in Creative
#       mode' exit 0 even if ComfyUI had crashed → never repaired)
#   P1: wait_for_healthy handles 'none' status (no healthcheck) + deadline-based
#       timeout (was: for-loop overshot by 5s, 'none' hung until full timeout)
#   P1: mkdir /run/scarlix fail-closed (was: || true → flock on missing dir →
#       cryptic error under set -e)
#   P1: sudo without -E (was: sudo -E preserved entire env → unnecessary surface
#       for a privileged mode switcher)

LOG_FILE="/var/log/scarlix-mode.log"
# v19.0.3 P2: Dynamic version for banners
SCARLIX_VER="$(cat /etc/scarlix/VERSION 2>/dev/null || echo unknown)"
STATE_FILE="/var/lib/scarlix/current-mode"
# v18.7.2 P0: Move lock to root-owned /run/scarlix/ (was: /tmp → symlink attack)
# v18.7.7 P1: Fail-closed on mkdir (was: || true → exec 200> on missing dir →
#   flock fails with cryptic error under set -e, no useful diagnostic).
if ! mkdir -p /run/scarlix 2>/dev/null; then
  echo "FATAL: cannot create /run/scarlix — aborting" >&2
  exit 1
fi
LOCK_FILE="/run/scarlix/scarlix-mode.lock"
MODELS_YAML="/etc/scarlix/models.yaml"
ENV_FILE="/opt/scarlix/.env"

# v17.8: Docker compose with --env-file (compose doesn't auto-read .env from parent dir)
DC="docker compose --env-file $ENV_FILE"

# v18.5 P0: Non-fatal log (was: tee fails on root-owned log → set -e abort)
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE" 2>/dev/null || echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# v19.0.0 P1-9: Ensure scarlix-net exists before any compose operation
#   (was: if a user/admin manually `docker network rm scarlix-net`'d it — or
#   it never got created on a fresh install — every `$DC up/down` failed with
#   a confusing "network scarlix-net declared as external, but could not be
#   found" error from compose, with no hint about how to recover. Now: inspect
#   → create if missing → fail loud if Docker itself is down.)
ensure_scarlix_net() {
  if ! docker network inspect scarlix-net >/dev/null 2>&1; then
    log "⚠ scarlix-net not found — creating..."
    docker network create scarlix-net >/dev/null 2>&1 || {
      log "ERROR: Cannot create scarlix-net — Docker may be down"
      return 1
    }
    log "  ✓ scarlix-net created"
  fi
}

# P0 FIX v17.9.1: MODE assigned BEFORE flock check (was after → set -u crash)
MODE="${1:-status}"
CURRENT_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
EXPERIMENTAL=0
[ -f /etc/scarlix/.experimental ] && EXPERIMENTAL=1

# v18.5 P0: If running as non-root, re-exec via sudo (was: user CLI dead — can't write root-owned .env/log/state)
# This is necessary because v18.5 made .env root:root 600 (LPE fix) — user can't write it directly.
# Docker group membership (Phase 3) gives docker access, but scarlix-mode needs root for .env + log + state writes.
# v18.7.7 P1: Drop -E (was: sudo -E preserved entire env — unnecessary surface for
#   a privileged mode switcher; scarlix-mode regenerates .env from models.yaml so
#   it doesn't need the caller's environment. Only HOME is implicitly preserved by sudo).
if [ "$(id -u)" -ne 0 ]; then
  exec sudo /usr/local/bin/scarlix-mode "$@"
fi

# flock only for write commands (status/vram are read-only)
exec 200>"$LOCK_FILE"
if [ "$MODE" != "status" ] && [ "$MODE" != "vram" ] && [ "$MODE" != "vram-check" ]; then
  flock -n 200 || { log "ERROR: another process is switching mode"; exit 1; }
fi

# v18.5 P1: Exclusive lock on /models during mode switch (was: race with model-manager)
# Uses FD 9 (separate from FD 200 above) — shared by model-manager.sh + download-models.sh
MODELS_LOCK="/var/lib/scarlix/.models.lock"
# v18.7.8 P1: Fail-closed mkdir for models lock dir (was: `|| true` → if /var/lib/scarlix
#   was RO/broken, mkdir silently failed, then `exec 9>` failed under set -e with a
#   cryptic error and no diagnostic. Now: explicit FATAL + exit 1, consistent with
#   the /run/scarlix mkdir fix from v18.7.7.)
if ! mkdir -p "$(dirname "$MODELS_LOCK")" 2>/dev/null; then
  echo "FATAL: cannot create models lock directory $(dirname "$MODELS_LOCK") — aborting" >&2
  exit 1
fi
exec 9>"$MODELS_LOCK"
# Only acquire exclusive lock for write operations (ai/turbo/offline that start containers)
# For status/vram (read-only), use shared lock
if [ "$MODE" != "status" ] && [ "$MODE" != "vram" ] && [ "$MODE" != "vram-check" ]; then
    # v18.5 P0: Non-blocking flock (was: without -n → blocked for hours during model download → dead dashboard)
    flock -n -x 9 || { log "ERROR: cannot acquire models lock (model-manager/download-models running?). Try again later."; exit 1; }
else
    flock -n -s 9 || true
fi

# yq null validation
yaml_get() {
  local key="$1" default="$2"
  local val
  # v18.8.7 P1-02: Distinguish yq parse error from missing key (was: `|| echo "$default"`
  #   masked yq syntax/YAML errors → silently used default → wrong model loaded).
  #   Now: if yq itself fails (non-zero exit), FATAL. If key is absent/null, use default.
  if ! val=$(yq -r "$key // empty" "$MODELS_YAML" 2>/dev/null); then
    log "ERROR: yq evaluation failed for key '$key' — models.yaml may be invalid"
    return 1
  fi
  if [ "$val" = "null" ] || [ -z "$val" ]; then
    echo "$default"
  else
    echo "$val"
  fi
}

# P1 FIX v17.9: ALWAYS regenerate .env (was cached → stale after models.yaml edit)
# P0 FIX v17.9: Always write .env file (even without yq/models.yaml) — --env-file needs it to exist
generate_env_file() {
  local sglang_path="/models/Qwen3-14B-AWQ"
  local vllm_path="/models/Qwen3-14B-AWQ"
  local llamacpp_file="Qwen3-14B-Q4_K_M.gguf"
  # v18.5 P2: mem-fraction from models.yaml (was: hardcoded 0.85 in compose — OOM on 8GB GPU)
  local sglang_mem_fraction="0.85"
  local vllm_gpu_util="0.85"
  # v18.8.3 P1 (D): Basic SGLang runtime params from models.yaml (no PyTorch env)
  local sglang_context_length="32768"
  local sglang_chunked_prefill="4096"
  local sglang_max_running="4"
  # v18.8.7 P1-06: shm_size from models.yaml (was: hardcoded 8gb in compose)
  local sglang_shm_size="8gb"
  # v18.8.8 P2-01: Ollama runtime config from models.yaml (was: hardcoded in compose)
  local ollama_keep_alive="15m"
  local ollama_num_parallel="2"
  # v18.8.9 P1-02: vLLM + BeeLlama runtime params from models.yaml
  local vllm_tensor_parallel="1"
  local vllm_max_model_len="32768"
  local beellama_context_size="32768"
  local beellama_threads="16"
  local beellama_cache_type_k="q4_0"
  local beellama_cache_type_v="q4_0"

  if [ -f "$MODELS_YAML" ] && command -v yq >/dev/null 2>&1; then
    # v18.8.7 P1-02: If yaml_get fails (yq parse error), abort generate_env_file.
    #   yaml_get returns 1 on yq failure. Each call must be checked.
    sglang_path=$(yaml_get '.sglang.model_path' "$sglang_path") || return 1
    vllm_path=$(yaml_get '.vllm.model_path' "$sglang_path") || return 1
    llamacpp_file=$(yaml_get '.beellama.hf_file' "$llamacpp_file") || return 1
    sglang_mem_fraction=$(yaml_get '.sglang.mem_fraction' "$sglang_mem_fraction") || return 1
    vllm_gpu_util=$(yaml_get '.vllm.gpu_memory_utilization' "$vllm_gpu_util") || return 1
    sglang_context_length=$(yaml_get '.sglang.context_length' "$sglang_context_length") || return 1
    sglang_chunked_prefill=$(yaml_get '.sglang.chunked_prefill_size' "$sglang_chunked_prefill") || return 1
    sglang_max_running=$(yaml_get '.sglang.max_running_requests' "$sglang_max_running") || return 1
    sglang_shm_size=$(yaml_get '.sglang.shm_size' "$sglang_shm_size") || return 1
    # v18.8.8 P2-01: Ollama runtime config from models.yaml
    ollama_keep_alive=$(yaml_get '.ollama.keep_alive' "$ollama_keep_alive") || return 1
    ollama_num_parallel=$(yaml_get '.ollama.num_parallel' "$ollama_num_parallel") || return 1
    # v18.8.9 P1-02: vLLM + BeeLlama runtime params
    vllm_tensor_parallel=$(yaml_get '.vllm.tensor_parallel_size' "$vllm_tensor_parallel") || return 1
    vllm_max_model_len=$(yaml_get '.vllm.max_model_len' "$vllm_max_model_len") || return 1
    beellama_context_size=$(yaml_get '.beellama.context_size' "$beellama_context_size") || return 1
    beellama_threads=$(yaml_get '.beellama.threads' "$beellama_threads") || return 1
    beellama_cache_type_k=$(yaml_get '.beellama.cache_type_k' "$beellama_cache_type_k") || return 1
    beellama_cache_type_v=$(yaml_get '.beellama.cache_type_v' "$beellama_cache_type_v") || return 1
  elif [ ! -f "$MODELS_YAML" ]; then
    log "WARNING: models.yaml not found — using defaults"
  elif ! command -v yq >/dev/null 2>&1; then
    log "WARNING: yq not installed — using defaults (run 'pacman -S yq' as root)"
  fi

  # P0 FIX v17.9: ALWAYS write .env (even with defaults) — --env-file needs it
  # v18.5 P0: Fix real_user detection under systemd timer.
  # Was: `local real_user="${SUDO_USER:-${USER:-scarlix}}"` — when systemd timer runs scarlix-mode
  # as root, $SUDO_USER is empty + $USER is "root" → chown root /opt/scarlix → user CLI breaks.
  # Now: detect REAL_USER from /opt/scarlix ownership (set by install.sh Phase 1) or UID 1000.
  local real_user
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    real_user="$SUDO_USER"
  elif [ "$(id -u)" -ne 0 ]; then
    real_user="${USER:-$(whoami 2>/dev/null || echo scarlix)}"
  else
    # Running as root (systemd timer) — detect real user from /opt/scarlix ownership
    real_user=$(stat -c %U /opt/scarlix 2>/dev/null || echo "")
    if [ -z "$real_user" ] || [ "$real_user" = "root" ]; then
      # Fallback: first non-system user (UID 1000)
      real_user=$(getent passwd 1000 2>/dev/null | cut -d: -f1 || echo "scarlix")
    fi
  fi
  # v18.5 P0: SECURITY — removed `chown "$real_user" "$(dirname "$ENV_FILE")"` here.
  # Was: chown /opt/scarlix to REAL_USER → LPE if user modifies .env (root service `source`s it).
  # Now: /opt/scarlix stays root:root (install.sh Phase 1 enforces). scarlix-mode writes .env as root.
  # (real_user detection above is preserved for backward-compat logging; chown to user is removed.)

  # v18.9.0 P2-17: Atomic .env write (was: cat > direct → partial on crash)
  local env_tmp
  env_tmp=$(mktemp "${ENV_FILE}.XXXXXX") || { log "ERROR: cannot create temp for .env"; return 1; }
  # v19.0.1 P2: .env header version read from /etc/scarlix/VERSION (was: hardcoded
  #   "v18.9.0" — drifted from the actual runtime version). Falls back to 'unknown'.
  local mode_ver
  mode_ver=$(cat /etc/scarlix/VERSION 2>/dev/null || echo unknown)
  if ! cat > "$env_tmp" 2>/dev/null << EOF
# Auto-generated by scarlix-mode v${mode_ver} from models.yaml
SGLANG_MODEL_PATH=$sglang_path
VLLM_MODEL_PATH=$vllm_path
LLAMACPP_MODEL_PATH=/models/$llamacpp_file
# v18.5 P2: GPU memory fractions (configurable in models.yaml — was hardcoded 0.85)
SGLANG_MEM_FRACTION=$sglang_mem_fraction
VLLM_GPU_UTIL=$vllm_gpu_util
# v18.8.3 P1 (D): SGLang runtime params (no PyTorch env — conservative for stability)
SGLANG_CONTEXT_LENGTH=$sglang_context_length
SGLANG_CHUNKED_PREFILL=$sglang_chunked_prefill
SGLANG_MAX_RUNNING=$sglang_max_running
# v18.8.7 P1-06: shm_size from models.yaml (was: hardcoded in compose)
SGLANG_SHM_SIZE=$sglang_shm_size
# v18.8.8 P2-01: Ollama runtime config from models.yaml
OLLAMA_KEEP_ALIVE=$ollama_keep_alive
OLLAMA_NUM_PARALLEL=$ollama_num_parallel
# v18.8.9 P1-02: vLLM runtime params
VLLM_TENSOR_PARALLEL=$vllm_tensor_parallel
VLLM_MAX_MODEL_LEN=$vllm_max_model_len
# v18.8.9 P1-02: BeeLlama runtime params
LLAMACPP_CONTEXT_SIZE=$beellama_context_size
LLAMACPP_THREADS=$beellama_threads
LLAMACPP_CACHE_TYPE_K=$beellama_cache_type_k
LLAMACPP_CACHE_TYPE_V=$beellama_cache_type_v
EOF
  then
    rm -f "$env_tmp" 2>/dev/null || true
    log "WARNING: cannot write .env temp file"
    return 1
  fi
  # v18.9.0 P2-17: umask 077 before mv (was: cat creates 644, then chmod 600 — window where file is 644)
  chmod 600 "$env_tmp" 2>/dev/null || { rm -f "$env_tmp"; return 1; }
  mv -f "$env_tmp" "$ENV_FILE" 2>/dev/null || { rm -f "$env_tmp"; return 1; }
  log "Generated $ENV_FILE (SGLang=$sglang_path, vLLM=$vllm_path, llama.cpp=/models/$llamacpp_file, mem=$sglang_mem_fraction)"

  # v18.5 P0: .env is root:root 600 — no user ownership (was: chown REAL_USER → LPE via source)
  # scarlix-mode runs as root (host-bridge) or user. If user, it can't write root-owned .env —
  # the host-bridge timer (root) regenerates it. docker compose runs as root anyway.
  if [ "$(id -u)" -eq 0 ]; then
    # v18.7 P1: Fail-closed on .env perms (was: || true → security inconsistency)
    chown root:root "$ENV_FILE" 2>/dev/null || { log "ERROR: cannot chown $ENV_FILE"; return 1; }
  fi

  export SGLANG_MODEL_PATH="$sglang_path"
  export VLLM_MODEL_PATH="$vllm_path"
  export LLAMACPP_MODEL_PATH="/models/$llamacpp_file"
  export SGLANG_CONTEXT_LENGTH="$sglang_context_length"
  export SGLANG_CHUNKED_PREFILL="$sglang_chunked_prefill"
  export SGLANG_MAX_RUNNING="$sglang_max_running"
  export SGLANG_SHM_SIZE="$sglang_shm_size"
  export OLLAMA_KEEP_ALIVE="$ollama_keep_alive"
  export OLLAMA_NUM_PARALLEL="$ollama_num_parallel"
  export VLLM_TENSOR_PARALLEL="$vllm_tensor_parallel"
  export VLLM_MAX_MODEL_LEN="$vllm_max_model_len"
  export LLAMACPP_CONTEXT_SIZE="$beellama_context_size"
  export LLAMACPP_THREADS="$beellama_threads"
  export LLAMACPP_CACHE_TYPE_K="$beellama_cache_type_k"
  export LLAMACPP_CACHE_TYPE_V="$beellama_cache_type_v"

  # v18.8.3 P1 (A-a): Regenerate LiteLLM config from models.yaml (was: hardcoded
  #   config.yaml → model ID mismatch. Now: if generate-litellm-config.sh exists,
  #   regenerate config before starting AI so LiteLLM always matches current model.)
  # v18.8.7 P1-01: FAIL CLOSED (was: || log "WARNING" → stale config could route
  #   to wrong model silently. Now: return 1 so scarlix-mode ai aborts.)
  if [ -x /usr/local/bin/generate-litellm-config.sh ] && [ -f "$MODELS_YAML" ]; then
    if ! /usr/local/bin/generate-litellm-config.sh "$MODELS_YAML" /opt/scarlix/ai/litellm/config.yaml >> "$LOG_FILE" 2>&1; then
      log "ERROR: LiteLLM config generation failed — refusing to start AI with stale config"
      return 1
    fi
  fi
}

# P1 FIX v17.8: Always regenerate, then source
# v18.7 P1: Replace source with safe env parsing (was: source → shell execution risk)
# Even though .env is now root:root 600, this is consistent with model-manager's load_env_safe()
# and prevents shell execution of user-modifiable file.
load_model_paths() {
  generate_env_file
  if [ -f "$ENV_FILE" ]; then
    # Safe KEY=VALUE parsing (same as model-manager's load_env_safe)
    while IFS='=' read -r key value; do
      [[ "$key" =~ ^[[:space:]]*# ]] && continue
      [[ -z "$key" ]] && continue
      [[ "$key" =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
      export "$key=$value"
    done < "$ENV_FILE" 2>/dev/null || true
  fi
}

# check_model_exists — dir needs config.json, file needs to exist
check_model_exists() {
  local engine="$1" path="$2"
  if [ -z "$path" ] || [ "$path" = "null" ]; then
    log "ERROR: $engine model path is empty — check models.yaml"
    return 1
  fi
  if [ -d "$path" ]; then
    if [ -f "$path/config.json" ]; then
      return 0
    else
      log "ERROR: $engine dir exists but no config.json — download incomplete?"
      return 1
    fi
  elif [ -f "$path" ]; then
    return 0
  fi
  log "ERROR: $engine model not found at $path"
  log "  Run: download-models.sh"
  return 1
}

# v18.9.2 P2: Atomic file write helper (was: echo > file → partial on crash)
# v18.9.3 P3: Add chmod 600 (was: no permissions set → file could be world-readable)
atomic_write() {
  local file="$1" content="$2"
  local tmp
  tmp=$(mktemp "${file}.XXXXXX") || return 1
  printf '%s\n' "$content" > "$tmp" || { rm -f "$tmp"; return 1; }
  chmod 600 "$tmp" 2>/dev/null || true  # v18.9.3 P3: ensure 600 even if umask differs
  mv -f "$tmp" "$file" || { rm -f "$tmp"; return 1; }
}

dump_vram() {
  log "Releasing VRAM..."
  # P1 v17.9.3: Read Ollama model from yaml (was hardcoded qwen2.5:3b)
  local ollama_model="qwen2.5:3b"
  if [ -f "$MODELS_YAML" ] && command -v yq >/dev/null 2>&1; then
    ollama_model=$(yq -r '.ollama.model // "qwen2.5:3b"' "$MODELS_YAML" 2>/dev/null || echo "qwen2.5:3b")
    [ "$ollama_model" = "null" ] && ollama_model="qwen2.5:3b"
  fi
  # v18.8.5 P0: Fallback to default Ollama port 11434 (was: only 11435 — our
  #   mapped port. If Ollama is listening on 11434 instead, keep_alive:0 never
  #   got sent → model stayed in RAM → VRAM leak on mode switch. Now: try 11435
  #   first, fall back to 11434, then `|| true` so dump_vram never aborts.)
  # v18.8.6 P1: --max-time 10 (was: no timeout → curl could hang on dead Ollama
  #   API → mode switch blocked indefinitely. Now: bounded 10s per attempt.)
  curl -s --max-time 10 -X POST "http://localhost:11435/api/generate" -d "{\"model\":\"$ollama_model\",\"keep_alive\":0}" >/dev/null 2>&1 || \
    curl -s --max-time 10 -X POST "http://localhost:11434/api/generate" -d "{\"model\":\"$ollama_model\",\"keep_alive\":0}" >/dev/null 2>&1 || true
  # v18.8.2 P1: Also stop LiteLLM gateway (was: only AI engines stopped → LiteLLM
  #   kept running pointing to dead backends → /v1/chat/completions would hang.)
  docker stop sglang vllm beellama ollama-agent litellm 2>/dev/null || true
  sleep 3
}

# P0 v17.9.3: Wait for container to be healthy after up -d
# Returns 0 if healthy, 1 if not healthy after timeout
# v18.7.7 P1: Deadline-based loop (was: for i in $(seq 1 $((timeout/5))) → could
#   overshoot by up to 5s because the final sleep always runs before the loop
#   condition is re-checked. Now uses SECONDS + deadline so total wait ≤ timeout.)
# v18.7.7 P1: Handle 'none' status (container has no healthcheck). Was: 'none'
#   matched neither 'healthy' nor 'unhealthy' → fell through to sleep → hung
#   until full timeout even though the container was already running fine.
#   Now: 'none' + 'running' → accept as OK (consistent with healthcheck_and_restart
#   line ~366 which already treats none+running as OK). This also prevents silent
#   breakage if someone removes a HEALTHCHECK from a compose file.
# v18.8.2 P1: Added optional 3rd param api_url — when health=none+running, probe
#   the HTTP API directly (was: none+running=OK blindly → container could be
#   running but API deadlocked. Now: if api_url given, curl it before accepting.)
wait_for_healthy() {
  local container="$1" timeout="${2:-60}" api_url="${3:-}"
  log "  Waiting for $container to become healthy (max ${timeout}s)..."
  local deadline=$((SECONDS + timeout))
  while [ "$SECONDS" -lt "$deadline" ]; do
    # v18.8.6 P1: Early exit on exited/dead (was: waited full 300s for dead container)
    local run_status
    run_status=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo "not_found")
    case "$run_status" in
      exited|dead|not_found)
        log "  ✗ $container: $run_status — not waiting (exited/dead)"
        return 1
        ;;
    esac
    local health status
    health=$(docker inspect -f '{{.State.Health.Status}}' "$container" 2>/dev/null || echo "none")
    case "$health" in
      healthy)
        log "  ✓ $container: healthy"
        return 0
        ;;
      unhealthy)
        log "  ✗ $container: unhealthy"
        return 1
        ;;
      none)
        # v18.7.7 P1: No healthcheck configured — accept if container is running.
        # v18.8.2 P1: If api_url provided, probe it before accepting (was: blind
        #   accept → running but deadlocked API counted as healthy).
        status=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo "not_found")
        if [ "$status" = "running" ]; then
          if [ -n "$api_url" ]; then
            if curl -sf --max-time 5 "$api_url" >/dev/null 2>&1; then
              log "  ✓ $container: running + API reachable ($api_url)"
              return 0
            else
              log "  ⏳ $container: running but API not ready yet ($api_url)..."
            fi
          else
            log "  ✓ $container: running (no healthcheck configured)"
            return 0
          fi
        fi
        ;;
    esac
    sleep 5
  done
  log "  ✗ $container: not healthy after ${timeout}s"
  return 1
}

show_vram() {
  echo "=== SCARLIX OS v${SCARLIX_VER} — VRAM Check ==="
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    echo "  nvidia-smi not available — NVIDIA driver not installed."
    return 0
  fi
  echo ""
  echo "GPU VRAM:"
  nvidia-smi --query-gpu=index,name,memory.total,memory.used,memory.free,utilization.gpu,compute_cap \
            --format=csv,noheader,nounits 2>/dev/null | while IFS=',' read -r idx name total used _free util cap; do
    idx=$(echo "$idx" | tr -d ' '); name=$(echo "$name" | tr -d ' ')
    total=$(echo "$total" | tr -d ' '); used=$(echo "$used" | tr -d ' '); util=$(echo "$util" | tr -d ' ')
    cap=$(echo "$cap" | tr -d ' ')
    if [ "$total" -gt 0 ] 2>/dev/null; then
      pct=$((used * 100 / total))
      bar=$(printf '█%.0s' $(seq 1 $((pct / 5))) 2>/dev/null)
      bar_empty=$(printf '░%.0s' $(seq 1 $((20 - pct / 5))) 2>/dev/null)
      warn=""; [ "$pct" -ge 90 ] && warn=" ⚠ CRITICAL"
      printf "  GPU %s %-18s %5d/%5d MiB [%s%s] %3d%% sm_%s%s\n" "$idx" "$name" "$used" "$total" "$bar" "$bar_empty" "$pct" "$cap" "$warn"
    fi
  done
  echo ""
  echo "Docker containers:"
  docker ps -a --format "table {{.Names}}\t{{.Status}}" 2>/dev/null | head -15
}

# Healthcheck respects stopped state + EXPERIMENTAL flag
healthcheck_and_restart() {
  if [ "$CURRENT_MODE" = "stopped" ]; then
    log "Mode is 'stopped' — no healthcheck/restart."
    return 0
  fi

  # P0-7 v17.9.2: Hash stored AFTER successful recreate (was before → failed recreate = no retry)
  local env_changed=false
  # v18.8.9 P1-01: Track first-run-without-containers so hash is stored only
  #   AFTER successful start (was: stored before recreate in the first-run
  #   branch → broken state persisted silently.)
  local first_run_no_containers=false
  local models_hash_file="/var/lib/scarlix/models.sha256"
  if [ -f "$MODELS_YAML" ]; then
    local current_hash stored_hash
    # P1 v17.9.5: Hash only model paths (not whole file — comments caused false recreates)
    # v18.5 P1: Include mem_fraction + gpu_util in hash (was: missing → config change didn't trigger recreate)
    # v18.8.3 P1 (P1-6): Hash includes all runtime-relevant SGLang params (was: only
    #   model_path + mem_fraction → changing context_length/chunked_prefill/max_running
    #   didn't trigger recreate → stale config kept running. Now: all fields included.)
    # v18.8.7 P1-03: Validate YAML first, fail if yq fails (was: `|| echo ""` →
    #   hash of empty stream = valid SHA256 → false "config OK" → stale config.)
    # v18.8.7 P1-04: Added .sglang.shm_size to hash (was: missing → shm_size
    #   change didn't trigger recreate.)
    # v18.8.7 P1-05: Removed .sglang.flashinfer from hash — it's not wired to
    #   compose (compose hardcodes --disable-flashinfer). Documented in models.yaml.
    if ! yq -e '.' "$MODELS_YAML" >/dev/null 2>&1; then
      log "ERROR: models.yaml is invalid YAML — cannot compute config hash"
      return 1
    fi
    # v18.8.8 P1-01: Hash now covers ALL runtime-relevant params (was: missing
    #   vllm.tensor_parallel_size, vllm.max_model_len, beellama.context_size/threads/
    #   cache_type_k/cache_type_v, ollama.keep_alive/num_parallel → changing these
    #   didn't trigger recreate → stale config kept running.)
    current_hash=$(yq -r '
      .sglang.model_path,
      .sglang.mem_fraction,
      .sglang.context_length,
      .sglang.chunked_prefill_size,
      .sglang.max_running_requests,
      .sglang.shm_size,
      .vllm.model_path,
      .vllm.gpu_memory_utilization,
      .vllm.tensor_parallel_size,
      .vllm.max_model_len,
      .beellama.hf_file,
      .beellama.context_size,
      .beellama.threads,
      .beellama.cache_type_k,
      .beellama.cache_type_v,
      .ollama.model,
      .ollama.keep_alive,
      .ollama.num_parallel
    ' "$MODELS_YAML" 2>/dev/null | sha256sum | awk '{print $1}')
    if [ -z "$current_hash" ]; then
      log "ERROR: models.yaml hash computation failed (yq returned empty)"
      return 1
    fi
    stored_hash=$(cat "$models_hash_file" 2>/dev/null || echo "")
    # P2-7 v17.9.2: Empty stored_hash = first run → don't recreate, just store hash
    if [ -n "$current_hash" ] && [ -n "$stored_hash" ] && [ "$current_hash" != "$stored_hash" ]; then
      log "models.yaml changed (hash mismatch) — will force-recreate"
      env_changed=true
    elif [ -n "$current_hash" ] && [ -z "$stored_hash" ]; then
      # v18.8.8 P2-02: First run must verify existing containers (was: stored
      #   hash without checking if containers exist with old config. Now: if
      #   AI containers already exist, force-recreate to ensure config matches.)
      # v18.8.9 P2-01: Check ALL AI containers, not just sglang (was: only sglang
      #   → if sglang was removed but vllm/beellama existed, system thought
      #   "no containers" → stale config persisted without recreate.)
      local any_existing=""
      for c in sglang vllm beellama ollama-agent; do
        if docker inspect "$c" >/dev/null 2>&1; then
          any_existing="$c"
          break
        fi
      done
      if [ -n "$any_existing" ]; then
        log "First run — container '$any_existing' already exists, forcing recreate to verify config"
        env_changed=true
      else
        log "First run — no existing AI containers, will store hash after successful start"
        first_run_no_containers=true
      fi
      # v18.8.9 P1-01: Do NOT store hash here (was: `echo "$current_hash" >
      #   "$models_hash_file"` ran BEFORE recreate → if recreate failed, hash
      #   was already on disk → next run saw hash match → no retry → stale
      #   config persisted forever. Now: hash stored ONLY after successful
      #   recreate (existing block below) or successful start (new block below
      #   for the first-install case.)
    fi
  fi

  log "Healthchecking AI containers..."
  local recreate_success=true
  for container in sglang vllm beellama; do
    local status
    status=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo "not_found")
    [ "$status" = "not_found" ] && continue
    if [ "$status" != "running" ]; then
      # P0-8 v17.9.2: Use $DC up -d (not docker start) — picks up new .env
      local compose_file
      case "$container" in
        sglang) compose_file="/opt/scarlix/ai/sglang/docker-compose.yml" ;;
        vllm) compose_file="/opt/scarlix/ai/vllm/docker-compose.yml" ;;
        beellama) compose_file="/opt/scarlix/ai/llamacpp/docker-compose.yml" ;;
        *) continue ;;
      esac
      log "  $container: $status — starting with $DC..."
      if $DC -f "$compose_file" up -d >> "$LOG_FILE" 2>&1; then
        log "  ✓ $container started"
        # v18.8.3 P1 (P1-4): wait_for_healthy after start (was: no wait → could
        #   report "not healthy" at end even though container would be healthy
        #   in 40s. Now: wait like start_verified_ai does.)
        local hc_timeout hc_url
        case "$container" in
          sglang) hc_timeout=300; hc_url="http://127.0.0.1:30000/health" ;;
          vllm) hc_timeout=300; hc_url="http://127.0.0.1:8089/v1/models" ;;
          beellama) hc_timeout=120; hc_url="http://127.0.0.1:11438/health" ;;
        esac
        wait_for_healthy "$container" "$hc_timeout" "$hc_url" 2>/dev/null || recreate_success=false
      else
        log "  ✗ $container start failed"
      fi
    elif [ "$env_changed" = true ]; then
      local compose_file
      case "$container" in
        sglang) compose_file="/opt/scarlix/ai/sglang/docker-compose.yml" ;;
        vllm) compose_file="/opt/scarlix/ai/vllm/docker-compose.yml" ;;
        beellama) compose_file="/opt/scarlix/ai/llamacpp/docker-compose.yml" ;;
        *) continue ;;
      esac
      log "  $container: recreating (env changed)..."
      if $DC -f "$compose_file" up -d --force-recreate >> "$LOG_FILE" 2>&1; then
        log "  ✓ $container recreated"
        # v18.8.3 P1 (P1-4): wait_for_healthy after recreate (was: no wait)
        local rc_timeout rc_url
        case "$container" in
          sglang) rc_timeout=300; rc_url="http://127.0.0.1:30000/health" ;;
          vllm) rc_timeout=300; rc_url="http://127.0.0.1:8089/v1/models" ;;
          beellama) rc_timeout=120; rc_url="http://127.0.0.1:11438/health" ;;
        esac
        wait_for_healthy "$container" "$rc_timeout" "$rc_url" 2>/dev/null || recreate_success=false
      else
        log "  ✗ $container recreate failed"
        recreate_success=false
      fi
    else
      # P0 v17.9.3: Check Docker health — unhealthy = recreate
      local health
      health=$(docker inspect -f '{{.State.Health.Status}}' "$container" 2>/dev/null || echo "none")
      if [ "$health" = "unhealthy" ]; then
        log "  $container: unhealthy — recreating..."
        local compose_file
        case "$container" in
          sglang) compose_file="/opt/scarlix/ai/sglang/docker-compose.yml" ;;
          vllm) compose_file="/opt/scarlix/ai/vllm/docker-compose.yml" ;;
          beellama) compose_file="/opt/scarlix/ai/llamacpp/docker-compose.yml" ;;
          *) continue ;;
        esac
        if $DC -f "$compose_file" up -d --force-recreate >> "$LOG_FILE" 2>&1; then
          log "  ✓ $container recreated"
          # v18.8.3 P1 (P1-4): wait_for_healthy after unhealthy recreate (was: no wait)
          local uh_timeout uh_url
          case "$container" in
            sglang) uh_timeout=300; uh_url="http://127.0.0.1:30000/health" ;;
            vllm) uh_timeout=300; uh_url="http://127.0.0.1:8089/v1/models" ;;
            beellama) uh_timeout=120; uh_url="http://127.0.0.1:11438/health" ;;
          esac
          wait_for_healthy "$container" "$uh_timeout" "$uh_url" 2>/dev/null || recreate_success=false
        else
          log "  ✗ $container recreate failed"
          # v18.5.2 P2: Update recreate_success (was: only logged, didn't update flag)
          recreate_success=false
        fi
      else
        log "  ✓ $container: running ($health)"
      fi
    fi
  done

  # P0-7 v17.9.2: Store hash only after successful recreate
  if [ "$env_changed" = true ] && [ "$recreate_success" = true ]; then
    echo "$current_hash" > "$models_hash_file" 2>/dev/null || true
    log "models.yaml hash stored (recreate successful)"
  fi
  # v18.8.9 P1-01: First-run with NO existing AI containers (first install) —
  #   store hash AFTER the healthcheck loop confirmed nothing failed (was:
  #   stored in the first-run branch BEFORE the healthcheck loop ran → if any
  #   downstream start failed, hash was already on disk → next run saw hash
  #   match → no retry → broken state persisted silently. Now: stored ONLY
  #   when recreate_success is still true. env_changed is false here by
  #   definition (first-install path), so this block is distinct from the
  #   recreate-success block above.)
  if [ "$first_run_no_containers" = true ] && [ "$recreate_success" = true ]; then
    echo "$current_hash" > "$models_hash_file" 2>/dev/null || true
    log "models.yaml hash stored (first run, no existing containers, start OK)"
  fi

  # Only check Ollama if it should be running (fallback mode)
  local ollama_status
  ollama_status=$(docker inspect -f '{{.State.Status}}' ollama-agent 2>/dev/null || echo "not_found")
  if [ "$ollama_status" = "running" ]; then
    log "  ✓ ollama-agent: running (fallback mode)"
  elif [ "$ollama_status" != "not_found" ]; then
    local sglang_st vllm_st
    sglang_st=$(docker inspect -f '{{.State.Status}}' sglang 2>/dev/null || echo "not_found")
    vllm_st=$(docker inspect -f '{{.State.Status}}' vllm 2>/dev/null || echo "not_found")
    if [ "$sglang_st" != "running" ] && { [ "$vllm_st" != "running" ] || [ "$EXPERIMENTAL" -eq 0 ]; }; then
      log "  ollama-agent: $ollama_status — restarting (SGLang+vLLM both down)..."
      $DC -f /opt/scarlix/ai/ollama/docker-compose.yml up -d >> "$LOG_FILE" 2>&1 && log "  ✓ ollama-agent restarted" || log "  ✗ ollama-agent restart failed"
    else
      log "  ℹ ollama-agent: stopped (SGLang or vLLM running — not needed)"
    fi
  fi

  # v18.8.3 P1 (P1-3): Check LiteLLM gateway health (was: not checked → if LiteLLM
  #   crashed but engines were healthy, scarlix-mode ai said "healthy" but gateway
  #   was down → clients couldn't reach unified API. Now: if LiteLLM container
  #   exists but not running/unhealthy, restart it + wait_for_healthy.)
  local litellm_status
  litellm_status=$(docker inspect -f '{{.State.Status}}' litellm 2>/dev/null || echo "not_found")
  if [ "$litellm_status" != "not_found" ]; then
    if [ "$litellm_status" != "running" ]; then
      log "  litellm: $litellm_status — restarting..."
      $DC -f /opt/scarlix/ai/litellm/docker-compose.yml up -d >> "$LOG_FILE" 2>&1 && log "  ✓ litellm restarted" || log "  ✗ litellm restart failed"
      wait_for_healthy "litellm" 60 http://127.0.0.1:4001/health/liveliness 2>/dev/null || true
    else
      local litellm_health
      litellm_health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' litellm 2>/dev/null || echo "none")
      if [ "$litellm_health" = "unhealthy" ]; then
        log "  litellm: unhealthy — recreating..."
        $DC -f /opt/scarlix/ai/litellm/docker-compose.yml up -d --force-recreate >> "$LOG_FILE" 2>&1 && log "  ✓ litellm recreated" || log "  ✗ litellm recreate failed"
        wait_for_healthy "litellm" 60 http://127.0.0.1:4001/health/liveliness 2>/dev/null || true
      else
        log "  ✓ litellm: running ($litellm_health)"
      fi
    fi
  fi

  # v18.9.0 P1-04: Detect LiteLLM config change and restart if needed (was: config.yaml
  #   regenerated but LiteLLM kept running with old config in memory → wrong routing)
  # v18.9.1 P1-03: Fix missing-hash edge case (was: hash missing + LiteLLM running
  #   → stored hash without recreate → stale config. Now: force recreate if hash
  #   missing AND LiteLLM is running.)
  # v18.9.1 P1-04: Unified into ensure_litellm_config_current() — called from
  #   both healthcheck_and_restart() AND start_verified_ai() (was: only in
  #   healthcheck → start_verified_ai could start LiteLLM with stale config.)
  if [ -f /opt/scarlix/ai/litellm/config.yaml ]; then
    local litellm_config_hash litellm_stored_hash
    litellm_config_hash=$(sha256sum /opt/scarlix/ai/litellm/config.yaml 2>/dev/null | awk '{print $1}')
    litellm_stored_hash=$(cat /var/lib/scarlix/litellm-config.sha256 2>/dev/null || echo "")

    # Determine if LiteLLM is running
    local litellm_running
    litellm_running=$(docker inspect -f '{{.State.Status}}' litellm 2>/dev/null || echo "not_found")

    if [ -n "$litellm_config_hash" ] && [ "$litellm_config_hash" != "$litellm_stored_hash" ]; then
      # Config changed → force recreate
      log "  litellm: config.yaml changed — restarting to load new routing config"
      $DC -f /opt/scarlix/ai/litellm/docker-compose.yml up -d --force-recreate >> "$LOG_FILE" 2>&1
      if wait_for_healthy "litellm" 60 http://127.0.0.1:4001/health/liveliness 2>/dev/null; then
        atomic_write /var/lib/scarlix/litellm-config.sha256 "$litellm_config_hash" 2>/dev/null || true
        log "  ✓ litellm restarted with new config"
      else
        log "  ✗ litellm not healthy after config restart"
      fi
    elif [ -n "$litellm_config_hash" ] && [ -z "$litellm_stored_hash" ] && [ "$litellm_running" = "running" ]; then
      # v18.9.1 P1-03: Hash missing + LiteLLM running → force recreate (was: just store hash → stale config)
      log "  litellm: no stored config hash but LiteLLM running — force recreate to verify config"
      $DC -f /opt/scarlix/ai/litellm/docker-compose.yml up -d --force-recreate >> "$LOG_FILE" 2>&1
      if wait_for_healthy "litellm" 60 http://127.0.0.1:4001/health/liveliness 2>/dev/null; then
        atomic_write /var/lib/scarlix/litellm-config.sha256 "$litellm_config_hash" 2>/dev/null || true
        log "  ✓ litellm recreated + config hash stored"
      else
        log "  ✗ litellm not healthy after recreate"
      fi
    elif [ -n "$litellm_config_hash" ] && [ -z "$litellm_stored_hash" ]; then
      # First run — LiteLLM not running yet, store hash for future comparison
      atomic_write /var/lib/scarlix/litellm-config.sha256 "$litellm_config_hash" 2>/dev/null || true
    fi
  fi

  # v18.5.2 P1: Return 1 if no inference engine running (was: always implicit 0)
  local any_ok=0
  # v18.6 P1: Check healthy, not just Running (was: running+unhealthy counted as OK)
  # v18.8.1 P1: Require "healthy" not just "not unhealthy" (was: running+starting
  #   counted as OK → "starting" means model still loading, not ready to serve →
  #   scarlix-mode ai returned SUCCESS but inference would fail. Now: only
  #   "healthy" OR "none"+running (no healthcheck configured) = OK.)
  for c in sglang vllm beellama ollama-agent; do
    st=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "not_found")
    [ "$st" = "not_found" ] && continue
    health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$c" 2>/dev/null || echo "none")
    # v18.8.1 P1: "starting" is NOT OK (model still loading). Only "healthy" or
    # "none"+running (no healthcheck) count as ready to serve inference.
    if [ "$st" = "running" ]; then
      case "$health" in
        healthy)
          any_ok=1
          ;;
        none)
          # No healthcheck — accept running (consistent with wait_for_healthy)
          any_ok=1
          ;;
        # "starting" and "unhealthy" → NOT ok
      esac
    fi
  done
  if [ "$any_ok" -eq 0 ]; then
    log "ERROR: healthcheck — no inference engine healthy (all starting/unhealthy/down)"
    return 1
  fi
  return 0
}

# Start verified AI path
start_verified_ai() {
  # P1 FIX v17.8: Always regenerate .env (was cached)
  load_model_paths

  log "Starting verified AI path..."
  local sglang_ok=0 vllm_ok=0 beellama_ok=0 ollama_ok=0

  # SGLang (GPU0) — P0 v17.9.3: wait_for_healthy after up -d
  if check_model_exists "SGLang" "$SGLANG_MODEL_PATH"; then
    if $DC -f /opt/scarlix/ai/sglang/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
      # P0 v17.9.3: Wait for healthy (up -d exit 0 ≠ model loaded)
      if wait_for_healthy "sglang" 300 http://127.0.0.1:30000/health; then
        log "  ✓ SGLang (GPU0, healthy)"
        sglang_ok=1
      else
        log "  ✗ SGLang not healthy after 300s — will try fallback"
        # P1 v17.9.5: Stop SGLang to free VRAM for fallback (was running with restart:unless-stopped)
        docker stop sglang 2>/dev/null || true
      fi
    else
      log "  ✗ SGLang failed to start — will try fallback"
    fi
  else
    log "  ⚠ SGLang model missing — skipping"
  fi

  # vLLM (GPU1, TP=1) — only if .experimental
  if [ "$EXPERIMENTAL" -eq 1 ]; then
    if check_model_exists "vLLM" "$VLLM_MODEL_PATH"; then
      if $DC -f /opt/scarlix/ai/vllm/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
        if wait_for_healthy "vllm" 300 http://127.0.0.1:8089/v1/models; then
          log "  ✓ vLLM (GPU1, TP=1, healthy)"
          vllm_ok=1
        else
          log "  ✗ vLLM not healthy after 300s"
          # P1 v17.9.6: Stop vLLM to free GPU1 VRAM (same as SGLang stop on fail)
          docker stop vllm 2>/dev/null || true
        fi
      else
        log "  ✗ vLLM failed"
      fi
    else
      log "  ⚠ vLLM model missing — skipping"
    fi
  fi

  # P1 FIX v17.8: BeeLlama ONLY when SGLang+vLLM fail (was "always on" → wasted RAM)
  if [ "$sglang_ok" -eq 0 ] && [ "$vllm_ok" -eq 0 ]; then
    log "  ⚠ SGLang + vLLM both failed — trying BeeLlama (CPU)"
    if check_model_exists "llama.cpp" "$LLAMACPP_MODEL_PATH"; then
      if $DC -f /opt/scarlix/ai/llamacpp/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
        # v18.7 P1: Wait for healthy before setting ok (was: immediate ok=1)
        if wait_for_healthy "beellama" 120 http://127.0.0.1:11438/health; then
          log "  ✓ BeeLlama (CPU, secondary fallback)"
          beellama_ok=1
        else
          log "  ✗ BeeLlama not healthy after 120s"
        fi
      else
        log "  ✗ BeeLlama failed"
      fi
    else
      log "  ⚠ BeeLlama model missing — skipping"
    fi
  else
    log "  ℹ SGLang or vLLM running — BeeLlama skipped (saves RAM)"
  fi

  # Ollama (CPU) — tertiary fallback (only if BeeLlama also failed)
  if [ "$sglang_ok" -eq 0 ] && [ "$vllm_ok" -eq 0 ] && [ "$beellama_ok" -eq 0 ]; then
    log "  ⚠ All engines failed — starting Ollama (qwen2.5:3b, tertiary fallback)"
    if $DC -f /opt/scarlix/ai/ollama/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
      # v18.7 P1: Wait for healthy (was: immediate ok=1)
      if wait_for_healthy "ollama-agent" 60 http://127.0.0.1:11435/api/tags; then
        log "  ✓ Ollama (CPU, tertiary fallback)"
        ollama_ok=1
      else
        log "  ✗ Ollama not healthy after 60s"
      fi
    else
      log "  ✗ Ollama failed"
    fi
  else
    log "  ℹ Primary engine running — Ollama skipped (saves RAM)"
    # v18.5.2 P2: Don't set ollama_ok=1 (was: misleading — Ollama isn't running)
  fi

  # v18.5 P1: Return non-zero if NO inference engine is healthy (was: always implicit 0).
  # This tells host-bridge the mode switch FAILED → retry/failed state triggers.
  if [ "$sglang_ok" -eq 0 ] && [ "$vllm_ok" -eq 0 ] && [ "$beellama_ok" -eq 0 ] && [ "${ollama_ok:-0}" -eq 0 ]; then
    log "ERROR: no inference engine healthy — mode switch FAILED"
    return 1
  fi

  # v18.8.2 P1 (A-a): Start LiteLLM gateway as part of AI mode lifecycle (was:
  #   LiteLLM was never started by scarlix-mode — doctor said "optional" + ručný
  #   compose up. Now: if /opt/scarlix/ai/litellm/docker-compose.yml exists AND
  #   /etc/scarlix/.env has LITELLM_MASTER_KEY, start LiteLLM on scarlix-net.
  #   Fail-soft: if LiteLLM fails to start, AI mode still succeeds (direct backend
  #   access works). LiteLLM is a unified gateway — clients can use either it OR
  #   the backends directly.)
  if [ -f /opt/scarlix/ai/litellm/docker-compose.yml ] && grep -q '^LITELLM_MASTER_KEY=' /etc/scarlix/.env 2>/dev/null; then
    # v18.9.1 P1-04: Check if LiteLLM config changed before starting (was: only
    #   checked in healthcheck_and_restart → start_verified_ai could start with stale config)
    # v18.9.2 P1: Fix exit status check (was: if/else then separate `if [ $? -eq 0 ]`
    #   → $? was from log() in else branch, not from docker compose → false success)
    local litellm_cfg_hash litellm_cfg_stored litellm_up_rc
    litellm_cfg_hash=$(sha256sum /opt/scarlix/ai/litellm/config.yaml 2>/dev/null | awk '{print $1}')
    litellm_cfg_stored=$(cat /var/lib/scarlix/litellm-config.sha256 2>/dev/null || echo "")
    if [ -n "$litellm_cfg_hash" ] && [ "$litellm_cfg_hash" != "$litellm_cfg_stored" ]; then
      log "  LiteLLM config changed since last run — force recreate to load new routing"
      $DC -f /opt/scarlix/ai/litellm/docker-compose.yml up -d --force-recreate >> "$LOG_FILE" 2>&1
      litellm_up_rc=$?
    else
      log "Starting LiteLLM gateway (unified API on :4001)..."
      $DC -f /opt/scarlix/ai/litellm/docker-compose.yml up -d >> "$LOG_FILE" 2>&1
      litellm_up_rc=$?
    fi
    if [ "$litellm_up_rc" -eq 0 ]; then
      # Wait for LiteLLM health (60s — LiteLLM starts fast, no model loading)
      if wait_for_healthy "litellm" 60 http://127.0.0.1:4001/health/liveliness 2>/dev/null; then
        # Store config hash after successful start
        [ -n "$litellm_cfg_hash" ] && atomic_write /var/lib/scarlix/litellm-config.sha256 "$litellm_cfg_hash" 2>/dev/null || true
        log "  ✓ LiteLLM gateway healthy (scarlix-default → backends)"
      else
        # Fail-soft: LiteLLM not healthy, but AI mode still succeeds
        log "  ⚠ LiteLLM not healthy after 60s — gateway unavailable (direct backend access still works)"
      fi
    else
      log "  ⚠ LiteLLM compose up failed — gateway unavailable (non-critical, direct backends OK)"
    fi
  else
    log "  ℹ LiteLLM gateway skipped (no compose file or no LITELLM_MASTER_KEY in /etc/scarlix/.env)"
  fi

  return 0
}

# v19.0.0 P1-9: Ensure scarlix-net exists before any compose-using mode
#   (ai/stop/creative/game/tv/turbo/offline). One call here at the top of the
#   dispatch covers all 7 modes — simpler than adding the call to each branch.
#   status/vram/vram-check are read-only and explicitly skipped: they must
#   keep working when Docker is down (the dashboard's `scarlix-mode status`
#   is the diagnostic users reach for when compose is broken — aborting it
#   on `docker network inspect` failure would hide the very information they
#   need). The unknown-mode `*)` branch is also skipped so usage text prints
#   cleanly without a spurious "Cannot create scarlix-net" error first.
case "$MODE" in
  ai|stop|creative|game|tv|turbo|offline)
    ensure_scarlix_net || { log "FATAL: scarlix-net unavailable — aborting mode switch"; exit 1; }
    ;;
esac

case "$MODE" in
  ai)
    # P1 FIX v17.8: Always regenerate .env before anything
    load_model_paths

    if [ "$CURRENT_MODE" = "stopped" ]; then
      log "Mode was 'stopped' — starting AI fresh..."
    elif [ "$CURRENT_MODE" = "ai" ]; then
      log "Already in AI mode — healthchecking (with .env regen)..."
      if healthcheck_and_restart; then
        exit 0
      else
        log "ERROR: healthcheck failed — no engine running"
        echo "failed" | tee "$STATE_FILE" >/dev/null
        exit 1
      fi
    fi

    log "Starting verified AI path..."
    killall steam lutris 2>/dev/null || true
    # v18.5 P1: systemctl needs root — if user, try sudo
    if [ "$(id -u)" -eq 0 ]; then
      systemctl stop sunshine 2>/dev/null || true
    else
      sudo systemctl stop sunshine 2>/dev/null || true
    fi
    $DC -f /opt/scarlix/ai/comfyui/docker-compose.yml --profile creative stop 2>/dev/null || true
    $DC -f /opt/scarlix/gaming/docker-compose.yml --profile tv stop 2>/dev/null || true
    # v18.5 P1: check return value — don't write "ai" to state if no engine started
    if start_verified_ai; then
      echo "ai" | tee "$STATE_FILE" >/dev/null
    else
      log "ERROR: AI mode switch failed — no engine healthy. State NOT changed to 'ai'."
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  stop)
    log "=== Stopping AI stack (keeping dashboard/infra) ==="
    docker stop sglang vllm beellama ollama-agent litellm 2>/dev/null || true
    $DC -f /opt/scarlix/ai/sglang/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    $DC -f /opt/scarlix/ai/vllm/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    $DC -f /opt/scarlix/ai/llamacpp/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    $DC -f /opt/scarlix/ai/ollama/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    # v18.8.3 P1 (L-a): Stop LiteLLM gateway (was: missing → gateway stayed open
    #   with no backends → clients got connection errors instead of clean shutdown)
    $DC -f /opt/scarlix/ai/litellm/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    echo "stopped" | tee "$STATE_FILE" >/dev/null
    log "AI stack + LiteLLM gateway stopped. Dashboard/infra still running. Run 'scarlix-mode ai' to restart."
    ;;
  game)
    # v18.7.7 P0: Stale-state repair (was: `[[ "$CURRENT_MODE" = "game" ]] && exit 0`
    #   → if Sunshine had crashed but current-mode still said 'game', re-running
    #   `scarlix-mode game` just logged 'Already in Game mode' and exited 0 —
    #   Sunshine was NEVER restarted. Now: only short-circuit if Sunshine is
    #   ACTUALLY active; otherwise fall through to the normal start path.)
    if [[ "$CURRENT_MODE" = "game" ]]; then
      if [ "$(id -u)" -eq 0 ]; then
        if systemctl is-active --quiet sunshine 2>/dev/null; then
          log "Already in Game mode — Sunshine active."
          exit 0
        fi
      else
        if sudo systemctl is-active --quiet sunshine 2>/dev/null; then
          log "Already in Game mode — Sunshine active."
          exit 0
        fi
      fi
      log "Mode says 'game' but Sunshine is not active — repairing..."
    fi
    log "=== GAME mode (native Sunshine) ==="
    dump_vram
    # v18.5.2 P1: fail-closed (was: systemctl fail → still wrote "game")
    game_ok=0
    if [ "$(id -u)" -eq 0 ]; then
      systemctl start sunshine 2>/dev/null && game_ok=1
    else
      sudo systemctl start sunshine 2>/dev/null && game_ok=1
    fi
    if [ "$game_ok" -eq 1 ]; then
      echo "game" | tee "$STATE_FILE" >/dev/null
    else
      log "ERROR: sunshine start failed — is sunshine.service installed?"
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  creative)
    # v18.7.7 P0: Stale-state repair (was: `[[ "$CURRENT_MODE" = "creative" ]] && exit 0`
    #   → if ComfyUI had crashed but current-mode still said 'creative', re-running
    #   `scarlix-mode creative` just logged 'Already in Creative mode' and exited 0 —
    #   ComfyUI was NEVER restarted. Now: only short-circuit if ComfyUI is ACTUALLY
    #   running; otherwise fall through to the normal start path.)
    if [[ "$CURRENT_MODE" = "creative" ]]; then
      # v18.8 P0: Removed `local` (was: SC2168 — 'local' is only valid in functions;
      #   creative) is a top-level case branch, not a function. shellcheck -S error
      #   failed CI. Now: plain assignment without local.)
      # v18.8.5 P2: comfyui_status/comfyui_health are intentionally global (case
      #   branch, not function — `local` would be SC2168). They leak into global
      #   scope but are overwritten on every creative-mode invocation, so no stale
      #   state persists across runs. Wrapping in a subshell `( )` would also work
      #   but adds an extra fork for no real benefit here.
      comfyui_status=""
      comfyui_health=""
      comfyui_status=$(docker inspect -f '{{.State.Status}}' comfyui 2>/dev/null || echo "missing")
      # v18.7.8 P1: Check health, not just running (was: only checked .State.Status
      #   = running → container could be running but API deadlocked → "Already in
      #   Creative mode — ComfyUI running" was a lie. Now: if a healthcheck exists,
      #   require it to be 'healthy' (not just 'running'); if no healthcheck, fall
      #   back to a real API probe at 127.0.0.1:8188 so we verify the HTTP server
      #   actually responds, not just that the process is alive.)
      if [[ "$comfyui_status" = "running" ]]; then
        comfyui_health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' comfyui 2>/dev/null || echo "none")
        case "$comfyui_health" in
          healthy)
            log "Already in Creative mode — ComfyUI healthy."
            exit 0
            ;;
          unhealthy)
            log "ComfyUI running but UNHEALTHY — repairing..."
            ;;
          none)
            # No healthcheck configured — probe the API directly (was: assumed
            # running = OK, but process could be deadlocked with dead HTTP).
            if curl -sf --max-time 3 http://127.0.0.1:8188/ >/dev/null 2>&1; then
              log "Already in Creative mode — ComfyUI API reachable."
              exit 0
            fi
            log "ComfyUI running but API not responding (port 8188) — repairing..."
            ;;
        esac
      else
        log "Mode says 'creative' but ComfyUI is not running ($comfyui_status) — repairing..."
      fi
    fi
    log "=== CREATIVE mode ==="
    dump_vram
    # v18.5 P1: systemctl needs root — if user, try sudo with clear error
    if [ "$(id -u)" -eq 0 ]; then
      systemctl stop sunshine 2>/dev/null || true
    else
      sudo systemctl stop sunshine 2>/dev/null || true
    fi
    # v18.5 P2: ensure .env exists before $DC (creative may run without prior scarlix-mode ai)
    [ -f "$ENV_FILE" ] || load_model_paths
    # v18.5.2 P1: fail-closed — at least ComfyUI must succeed
    creative_ok=0
    $DC -f /opt/scarlix/ai/comfyui/docker-compose.yml --profile creative up -d >> "$LOG_FILE" 2>&1 && creative_ok=1
    $DC -f /opt/scarlix/ai/video/docker-compose.yml --profile creative up -d 2>/dev/null || true
    $DC -f /opt/scarlix/ai/musicgen/docker-compose.yml --profile creative up -d 2>/dev/null || true
    # v18.8 P1: Wait for ComfyUI health before writing state (was: `up -d` exit 0
    #   → immediately wrote "creative" to state — but ComfyUI could still be
    #   starting/crashing. Now: wait_for_healthy comfyui 120s; if not healthy,
    #   state = failed, exit 1. Consistent with AI mode's wait_for_healthy pattern.)
    if [ "$creative_ok" -eq 1 ]; then
      # v18.8.2 P1: wait_for_healthy now takes api_url as 3rd param — it probes
      #   :8188 directly when health=none (no HEALTHCHECK). Was: separate curl
      #   after healthy (v18.8.1) — now unified into wait_for_healthy.
      if wait_for_healthy "comfyui" 120 http://127.0.0.1:8188/; then
        log "  ✓ ComfyUI healthy + API reachable — Creative mode active"
        echo "creative" | tee "$STATE_FILE" >/dev/null
      else
        log "ERROR: ComfyUI not healthy/API not responding after 120s — Creative mode FAILED"
        echo "failed" | tee "$STATE_FILE" >/dev/null
        exit 1
      fi
    else
      log "ERROR: ComfyUI failed to start"
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  turbo)
    log "=== TURBO mode (SGLang + vLLM + BeeLlama, max) ==="
    # v18.8.1 P1: Stale-state repair parity (was: only game/creative had this.
    #   If current-mode=turbo and AI engines are already healthy, short-circuit
    #   instead of dump_vram + restart everything — saves VRAM churn.)
    if [[ "$CURRENT_MODE" = "turbo" ]]; then
      if healthcheck_and_restart; then
        log "Already in Turbo mode — AI engines healthy."
        exit 0
      fi
      log "Mode says 'turbo' but AI not healthy — repairing..."
    fi
    # v18.5 P1: dump_vram before turbo (was: missing → CUDA OOM if creative/game still held VRAM)
    dump_vram
    # v18.5 P1: check return value
    if start_verified_ai; then
      echo "turbo" | tee "$STATE_FILE" >/dev/null
    else
      log "ERROR: TURBO mode switch failed — no engine healthy."
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  offline)
    log "=== OFFLINE mode (BeeLlama CPU, q4_0 KV) ==="
    # v18.8.1 P1: Stale-state repair parity (was: only game/creative had this.
    #   If current-mode=offline and BeeLlama had crashed, re-running
    #   `scarlix-mode offline` would just start fresh anyway (no "already in"
    #   short-circuit). But for consistency + to avoid unnecessary dump_vram
    #   when BeeLlama is already healthy, check + short-circuit.)
    if [[ "$CURRENT_MODE" = "offline" ]]; then
      beellama_status=$(docker inspect -f '{{.State.Status}}' beellama 2>/dev/null || echo "missing")
      if [[ "$beellama_status" = "running" ]]; then
        beellama_health=$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' beellama 2>/dev/null || echo "none")
        if [[ "$beellama_health" = "healthy" ]]; then
          log "Already in Offline mode — BeeLlama healthy."
          exit 0
        elif [[ "$beellama_health" = "none" ]]; then
          # v18.8.2 P1: No healthcheck — probe API directly (was: blind accept
          #   of none+running → could be running but API deadlocked).
          if curl -sf --max-time 5 http://127.0.0.1:11438/health >/dev/null 2>&1; then
            log "Already in Offline mode — BeeLlama API reachable."
            exit 0
          fi
          log "BeeLlama running but API not responding — repairing..."
        else
          log "BeeLlama running but $beellama_health — repairing..."
        fi
      else
        log "Mode says 'offline' but BeeLlama is not running ($beellama_status) — repairing..."
      fi
    fi
    dump_vram
    if [ "$(id -u)" -eq 0 ]; then
      systemctl stop sunshine 2>/dev/null || true
    else
      sudo systemctl stop sunshine 2>/dev/null || true
    fi
    load_model_paths
    # v18.5.2 P1: fail-closed if model missing (was: always wrote "offline")
    if ! check_model_exists "llama.cpp" "$LLAMACPP_MODEL_PATH"; then
      log "ERROR: BeeLlama model not found: $LLAMACPP_MODEL_PATH"
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    if $DC -f /opt/scarlix/ai/llamacpp/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
      # v18.6 P1: Wait for healthy before writing state (was: up -d → immediate "offline")
      # v18.8.5 P0: Pass api_url (http://127.0.0.1:11438/health) so wait_for_healthy
      #   actually probes the BeeLlama HTTP API. Without it, when BeeLlama has no
      #   HEALTHCHECK (health=none), wait_for_healthy accepts none+running as OK
      #   WITHOUT probing the API → container could be running but API deadlocked.
      if wait_for_healthy "beellama" 120 http://127.0.0.1:11438/health; then
        log "  ✓ BeeLlama started"
        echo "offline" | tee "$STATE_FILE" >/dev/null
      else
        log "ERROR: BeeLlama not healthy after 120s"
        echo "failed" | tee "$STATE_FILE" >/dev/null
        exit 1
      fi
    else
      log "ERROR: BeeLlama failed to start"
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  tv)
    log "=== TV mode (Docker Sunshine) ==="
    [ -f "$ENV_FILE" ] || load_model_paths
    # v18.6 P1: fail-closed (was: compose/systemctl fail → still wrote "tv")
    # v18.7.7 P0: systemctl RESTART (was: systemctl START). scarlix-tv-mode.service
    #   is Type=oneshot + RemainAfterExit=yes — after the first successful run the
    #   service stays 'active', and `systemctl start` on an already-active oneshot
    #   service does NOT re-run ExecStart. So if the Sunshine container later crashed,
    #   `scarlix-mode tv` would call `systemctl start` (no-op), see exit 0, write
    #   'tv' to state — but the healthcheck never ran and the container stayed dead.
    #   `systemctl restart` forces ExecStart to re-run every time, re-checking the
    #   container health on each invocation.)
    tv_ok=0
    if $DC -f /opt/scarlix/gaming/docker-compose.yml --profile tv up -d >> "$LOG_FILE" 2>&1; then
      if [ "$(id -u)" -eq 0 ]; then
        systemctl restart scarlix-tv-mode.service 2>/dev/null && tv_ok=1
      else
        sudo systemctl restart scarlix-tv-mode.service 2>/dev/null && tv_ok=1
      fi
    fi
    if [ "$tv_ok" -eq 1 ]; then
      echo "tv" | tee "$STATE_FILE" >/dev/null
    else
      log "ERROR: TV mode failed to start (compose or systemctl)"
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  vram|vram-check)
    show_vram
    exit $?
    ;;
  status)
    echo "=== SCARLIX OS v${SCARLIX_VER} (EndeavourOS) Status ==="
    echo "Mode: $CURRENT_MODE"
    echo "Experimental: $([ $EXPERIMENTAL -eq 1 ] && echo 'YES (vLLM enabled)' || echo 'no (SGLang + BeeLlama only)')"
    echo "Base: $(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo 'EndeavourOS')"
    echo "Kernel: $(uname -r)"
    echo "LTS: $(pacman -Q linux-lts 2>/dev/null || echo 'not installed')"
    echo ""
    echo "Inference containers:"
    echo "  SGLang: $(docker inspect -f '{{.State.Status}}' sglang 2>/dev/null || echo 'not running')"
    [ "$EXPERIMENTAL" -eq 1 ] && echo "  vLLM: $(docker inspect -f '{{.State.Status}}' vllm 2>/dev/null || echo 'not running')"
    echo "  BeeLlama: $(docker inspect -f '{{.State.Status}}' beellama 2>/dev/null || echo 'not running')"
    echo "  Ollama: $(docker inspect -f '{{.State.Status}}' ollama-agent 2>/dev/null || echo 'not running')"
    echo ""
    echo "Models:"
    [ -f "$MODELS_YAML" ] && echo "  Config: $MODELS_YAML" || echo "  Config: NOT FOUND"
    [ -f "$ENV_FILE" ] && echo "  Env: $ENV_FILE ($(stat -c %y "$ENV_FILE" 2>/dev/null | cut -d. -f1))" || echo "  Env: not generated"
    [ -d /models ] && echo "  Dir: /models ($(ls /models 2>/dev/null | wc -l) entries)" || echo "  Dir: /models NOT FOUND"
    echo ""
    echo "GPU:"
    nvidia-smi --query-gpu=index,name,memory.used,memory.free,compute_cap --format=csv,noheader 2>/dev/null || echo "  nvidia-smi not available"
    echo ""
    echo "Commands:"
    echo "  scarlix-mode ai       — Start/verify AI"
    echo "  scarlix-mode stop     — Stop AI stack"
    echo "  scarlix-mode vram     — VRAM details"
    echo "  download-models.sh    — Download models"
    ;;
  *)
    echo "Usage: scarlix-mode {ai|stop|game|creative|turbo|offline|tv|status|vram}"
    echo ""
    echo "  ai       — Verified AI path (SGLang + vLLM + BeeLlama + Ollama fallback)"
    echo "  stop     — Stop AI stack (no healthcheck restart)"
    echo "  turbo    — Max throughput"
    echo "  offline  — BeeLlama CPU only"
    echo "  game     — Native Steam/Sunshine"
    echo "  creative — ComfyUI + Video + Music"
    echo "  tv       — Docker Sunshine"
    echo "  status   — System summary"
    echo "  vram     — VRAM health check"
    exit 1
    ;;
esac
flock -u 200
