#!/usr/bin/env bash
set -euo pipefail

# SCARLIX OS v18.5 — GPU Mode Switcher (Host-Bridge Architecture)
# v18.5 FIXES:
#   P1: SGLang --disable-flashinfer (Blackwell sm_120 — see ai/sglang compose)
#   P1: .env permissions 600 (was 664 — secrets-readable-by-group risk)
#   P1: Version strings unified to v18.5
# v17.9.6 FIXES:
#   P0: wait_for_healthy after up -d (was exit 0 = OK, but model not loaded)
#   P0: healthcheck unhealthy = recreate (was just "running" = OK)
#   P1: dump_vram reads Ollama model from yaml (was hardcoded qwen2.5:3b)
#   P1: vLLM stopped on health fail (symmetric with SGLang)

LOG_FILE="/var/log/scarlix-mode.log"
STATE_FILE="/var/lib/scarlix/current-mode"
LOCK_FILE="/tmp/scarlix-mode.lock"
MODELS_YAML="/etc/scarlix/models.yaml"
ENV_FILE="/opt/scarlix/.env"

# v17.8: Docker compose with --env-file (compose doesn't auto-read .env from parent dir)
DC="docker compose --env-file $ENV_FILE"

# v18.5 P0: Non-fatal log (was: tee fails on root-owned log → set -e abort)
log() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE" 2>/dev/null || echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1"; }

# P0 FIX v17.9.1: MODE assigned BEFORE flock check (was after → set -u crash)
MODE="${1:-status}"
CURRENT_MODE=$(cat "$STATE_FILE" 2>/dev/null || echo "unknown")
EXPERIMENTAL=0
[ -f /etc/scarlix/.experimental ] && EXPERIMENTAL=1

# v18.5 P0: If running as non-root, re-exec via sudo (was: user CLI dead — can't write root-owned .env/log/state)
# This is necessary because v18.5 made .env root:root 600 (LPE fix) — user can't write it directly.
# Docker group membership (Phase 3) gives docker access, but scarlix-mode needs root for .env + log + state writes.
if [ "$(id -u)" -ne 0 ]; then
  exec sudo -E /usr/local/bin/scarlix-mode "$@"
fi

# flock only for write commands (status/vram are read-only)
exec 200>"$LOCK_FILE"
if [ "$MODE" != "status" ] && [ "$MODE" != "vram" ] && [ "$MODE" != "vram-check" ]; then
  flock -n 200 || { log "ERROR: another process is switching mode"; exit 1; }
fi

# v18.5 P1: Exclusive lock on /models during mode switch (was: race with model-manager)
# Uses FD 9 (separate from FD 200 above) — shared by model-manager.sh + download-models.sh
MODELS_LOCK="/var/lib/scarlix/.models.lock"
mkdir -p "$(dirname "$MODELS_LOCK")" 2>/dev/null || true
exec 9>"$MODELS_LOCK"
# Only acquire exclusive lock for write operations (ai/turbo/offline that start containers)
# For status/vram (read-only), use shared lock
if [ "$MODE" != "status" ] && [ "$MODE" != "vram" ] && [ "$MODE" != "vram-check" ]; then
    # v18.5 P0: Non-blocking flock (was: without -n → blocked for hours during model download → dead dashboard)
    flock -n -x 9 || { log "ERROR: cannot acquire models lock (model-manager/download-models running?). Try again later."; exit 1; }
else
    flock -n -s 9 || true
fi

# yq null validation
yaml_get() {
  local key="$1" default="$2"
  local val
  val=$(yq -r "$key // \"$default\"" "$MODELS_YAML" 2>/dev/null || echo "$default")
  if [ "$val" = "null" ] || [ -z "$val" ]; then
    echo "$default"
  else
    echo "$val"
  fi
}

# P1 FIX v17.9: ALWAYS regenerate .env (was cached → stale after models.yaml edit)
# P0 FIX v17.9: Always write .env file (even without yq/models.yaml) — --env-file needs it to exist
generate_env_file() {
  local sglang_path="/models/Qwen3-14B-AWQ"
  local vllm_path="/models/Qwen3-14B-AWQ"
  local llamacpp_file="Qwen3-14B-Q4_K_M.gguf"
  # v18.5 P2: mem-fraction from models.yaml (was: hardcoded 0.85 in compose — OOM on 8GB GPU)
  local sglang_mem_fraction="0.85"
  local vllm_gpu_util="0.85"

  if [ -f "$MODELS_YAML" ] && command -v yq >/dev/null 2>&1; then
    sglang_path=$(yaml_get '.sglang.model_path' "$sglang_path")
    vllm_path=$(yaml_get '.vllm.model_path' "$sglang_path")
    llamacpp_file=$(yaml_get '.beellama.hf_file' "$llamacpp_file")
    sglang_mem_fraction=$(yaml_get '.sglang.mem_fraction' "$sglang_mem_fraction")
    vllm_gpu_util=$(yaml_get '.vllm.gpu_memory_utilization' "$vllm_gpu_util")
  elif [ ! -f "$MODELS_YAML" ]; then
    log "WARNING: models.yaml not found — using defaults"
  elif ! command -v yq >/dev/null 2>&1; then
    log "WARNING: yq not installed — using defaults (run 'pacman -S yq' as root)"
  fi

  # P0 FIX v17.9: ALWAYS write .env (even with defaults) — --env-file needs it
  # v18.5 P0: Fix real_user detection under systemd timer.
  # Was: `local real_user="${SUDO_USER:-${USER:-scarlix}}"` — when systemd timer runs scarlix-mode
  # as root, $SUDO_USER is empty + $USER is "root" → chown root /opt/scarlix → user CLI breaks.
  # Now: detect REAL_USER from /opt/scarlix ownership (set by install.sh Phase 1) or UID 1000.
  local real_user
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
    real_user="$SUDO_USER"
  elif [ "$(id -u)" -ne 0 ]; then
    real_user="${USER:-$(whoami 2>/dev/null || echo scarlix)}"
  else
    # Running as root (systemd timer) — detect real user from /opt/scarlix ownership
    real_user=$(stat -c %U /opt/scarlix 2>/dev/null || echo "")
    if [ -z "$real_user" ] || [ "$real_user" = "root" ]; then
      # Fallback: first non-system user (UID 1000)
      real_user=$(getent passwd 1000 2>/dev/null | cut -d: -f1 || echo "scarlix")
    fi
  fi
  # v18.5 P0: SECURITY — removed `chown "$real_user" "$(dirname "$ENV_FILE")"` here.
  # Was: chown /opt/scarlix to REAL_USER → LPE if user modifies .env (root service `source`s it).
  # Now: /opt/scarlix stays root:root (install.sh Phase 1 enforces). scarlix-mode writes .env as root.
  # (real_user detection above is preserved for backward-compat logging; chown to user is removed.)

  # Write .env (may fail if not root + dir not owned — catch + warn)
  if ! cat > "$ENV_FILE" 2>/dev/null << EOF
# Auto-generated by scarlix-mode v18.5 from models.yaml
SGLANG_MODEL_PATH=$sglang_path
VLLM_MODEL_PATH=$vllm_path
LLAMACPP_MODEL_PATH=/models/$llamacpp_file
# v18.5 P2: GPU memory fractions (configurable in models.yaml — was hardcoded 0.85)
SGLANG_MEM_FRACTION=$sglang_mem_fraction
VLLM_GPU_UTIL=$vllm_gpu_util
EOF
  then
    log "WARNING: cannot write $ENV_FILE (permission denied — run as root: scarlix-mode needs root to write root:root /opt/scarlix/.env)"
    return 1
  fi
  log "Generated $ENV_FILE (SGLang=$sglang_path, vLLM=$vllm_path, llama.cpp=/models/$llamacpp_file, mem=$sglang_mem_fraction)"

  # v18.5 P0: .env is root:root 600 — no user ownership (was: chown REAL_USER → LPE via source)
  # scarlix-mode runs as root (host-bridge) or user. If user, it can't write root-owned .env —
  # the host-bridge timer (root) regenerates it. docker compose runs as root anyway.
  if [ "$(id -u)" -eq 0 ]; then
    chown root:root "$ENV_FILE" 2>/dev/null || true
  fi
  chmod 600 "$ENV_FILE" 2>/dev/null || true

  export SGLANG_MODEL_PATH="$sglang_path"
  export VLLM_MODEL_PATH="$vllm_path"
  export LLAMACPP_MODEL_PATH="/models/$llamacpp_file"
}

# P1 FIX v17.8: Always regenerate, then source
load_model_paths() {
  generate_env_file
  [ -f "$ENV_FILE" ] && source "$ENV_FILE"
}

# check_model_exists — dir needs config.json, file needs to exist
check_model_exists() {
  local engine="$1" path="$2"
  if [ -z "$path" ] || [ "$path" = "null" ]; then
    log "ERROR: $engine model path is empty — check models.yaml"
    return 1
  fi
  if [ -d "$path" ]; then
    if [ -f "$path/config.json" ]; then
      return 0
    else
      log "ERROR: $engine dir exists but no config.json — download incomplete?"
      return 1
    fi
  elif [ -f "$path" ]; then
    return 0
  fi
  log "ERROR: $engine model not found at $path"
  log "  Run: download-models.sh"
  return 1
}

dump_vram() {
  log "Releasing VRAM..."
  # P1 v17.9.3: Read Ollama model from yaml (was hardcoded qwen2.5:3b)
  local ollama_model="qwen2.5:3b"
  if [ -f "$MODELS_YAML" ] && command -v yq >/dev/null 2>&1; then
    ollama_model=$(yq -r '.ollama.model // "qwen2.5:3b"' "$MODELS_YAML" 2>/dev/null || echo "qwen2.5:3b")
    [ "$ollama_model" = "null" ] && ollama_model="qwen2.5:3b"
  fi
  curl -s -X POST "http://localhost:11435/api/generate" -d "{\"model\":\"$ollama_model\",\"keep_alive\":0}" >/dev/null 2>&1 || true
  docker stop sglang vllm beellama ollama-agent 2>/dev/null || true
  sleep 3
}

# P0 v17.9.3: Wait for container to be healthy after up -d
# Returns 0 if healthy, 1 if not healthy after timeout
wait_for_healthy() {
  local container="$1" timeout="${2:-60}"
  log "  Waiting for $container to become healthy (max ${timeout}s)..."
  for i in $(seq 1 $((timeout / 5))); do
    local health
    health=$(docker inspect -f '{{.State.Health.Status}}' "$container" 2>/dev/null || echo "none")
    case "$health" in
      healthy)
        log "  ✓ $container: healthy"
        return 0
        ;;
      unhealthy)
        log "  ✗ $container: unhealthy"
        return 1
        ;;
    esac
    sleep 5
  done
  log "  ✗ $container: not healthy after ${timeout}s"
  return 1
}

show_vram() {
  echo "=== SCARLIX OS v18.5 — VRAM Check ==="
  if ! command -v nvidia-smi >/dev/null 2>&1; then
    echo "  nvidia-smi not available — NVIDIA driver not installed."
    return 0
  fi
  echo ""
  echo "GPU VRAM:"
  nvidia-smi --query-gpu=index,name,memory.total,memory.used,memory.free,utilization.gpu,compute_cap \
            --format=csv,noheader,nounits 2>/dev/null | while IFS=',' read -r idx name total used free util cap; do
    idx=$(echo "$idx" | tr -d ' '); name=$(echo "$name" | tr -d ' ')
    total=$(echo "$total" | tr -d ' '); used=$(echo "$used" | tr -d ' '); util=$(echo "$util" | tr -d ' ')
    cap=$(echo "$cap" | tr -d ' ')
    if [ "$total" -gt 0 ] 2>/dev/null; then
      pct=$((used * 100 / total))
      bar=$(printf '█%.0s' $(seq 1 $((pct / 5))) 2>/dev/null)
      bar_empty=$(printf '░%.0s' $(seq 1 $((20 - pct / 5))) 2>/dev/null)
      warn=""; [ "$pct" -ge 90 ] && warn=" ⚠ CRITICAL"
      printf "  GPU %s %-18s %5d/%5d MiB [%s%s] %3d%% sm_%s%s\n" "$idx" "$name" "$used" "$total" "$bar" "$bar_empty" "$pct" "$cap" "$warn"
    fi
  done
  echo ""
  echo "Docker containers:"
  docker ps -a --format "table {{.Names}}\t{{.Status}}" 2>/dev/null | head -15
}

# Healthcheck respects stopped state + EXPERIMENTAL flag
healthcheck_and_restart() {
  if [ "$CURRENT_MODE" = "stopped" ]; then
    log "Mode is 'stopped' — no healthcheck/restart."
    return 0
  fi

  # P0-7 v17.9.2: Hash stored AFTER successful recreate (was before → failed recreate = no retry)
  local env_changed=false
  local models_hash_file="/var/lib/scarlix/models.sha256"
  if [ -f "$MODELS_YAML" ]; then
    local current_hash stored_hash
    # P1 v17.9.5: Hash only model paths (not whole file — comments caused false recreates)
    # v18.5 P1: Include mem_fraction + gpu_util in hash (was: missing → config change didn't trigger recreate)
    current_hash=$(yq -r '.sglang.model_path, .sglang.mem_fraction, .vllm.model_path, .vllm.gpu_memory_utilization, .beellama.hf_file, .ollama.model' "$MODELS_YAML" 2>/dev/null | sha256sum | awk '{print $1}' || echo "")
    stored_hash=$(cat "$models_hash_file" 2>/dev/null || echo "")
    # P2-7 v17.9.2: Empty stored_hash = first run → don't recreate, just store hash
    if [ -n "$current_hash" ] && [ -n "$stored_hash" ] && [ "$current_hash" != "$stored_hash" ]; then
      log "models.yaml changed (hash mismatch) — will force-recreate"
      env_changed=true
    elif [ -n "$current_hash" ] && [ -z "$stored_hash" ]; then
      log "First run — storing models.yaml hash (no recreate)"
      echo "$current_hash" > "$models_hash_file" 2>/dev/null || true
    fi
  fi

  log "Healthchecking AI containers..."
  local recreate_success=true
  for container in sglang vllm beellama; do
    local status
    status=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo "not_found")
    [ "$status" = "not_found" ] && continue
    if [ "$status" != "running" ]; then
      # P0-8 v17.9.2: Use $DC up -d (not docker start) — picks up new .env
      local compose_file
      case "$container" in
        sglang) compose_file="/opt/scarlix/ai/sglang/docker-compose.yml" ;;
        vllm) compose_file="/opt/scarlix/ai/vllm/docker-compose.yml" ;;
        beellama) compose_file="/opt/scarlix/ai/llamacpp/docker-compose.yml" ;;
        *) continue ;;
      esac
      log "  $container: $status — starting with $DC..."
      $DC -f "$compose_file" up -d >> "$LOG_FILE" 2>&1 && log "  ✓ $container started" || log "  ✗ $container start failed"
    elif [ "$env_changed" = true ]; then
      local compose_file
      case "$container" in
        sglang) compose_file="/opt/scarlix/ai/sglang/docker-compose.yml" ;;
        vllm) compose_file="/opt/scarlix/ai/vllm/docker-compose.yml" ;;
        beellama) compose_file="/opt/scarlix/ai/llamacpp/docker-compose.yml" ;;
        *) continue ;;
      esac
      log "  $container: recreating (env changed)..."
      if $DC -f "$compose_file" up -d --force-recreate >> "$LOG_FILE" 2>&1; then
        log "  ✓ $container recreated"
      else
        log "  ✗ $container recreate failed"
        recreate_success=false
      fi
    else
      # P0 v17.9.3: Check Docker health — unhealthy = recreate
      local health
      health=$(docker inspect -f '{{.State.Health.Status}}' "$container" 2>/dev/null || echo "none")
      if [ "$health" = "unhealthy" ]; then
        log "  $container: unhealthy — recreating..."
        local compose_file
        case "$container" in
          sglang) compose_file="/opt/scarlix/ai/sglang/docker-compose.yml" ;;
          vllm) compose_file="/opt/scarlix/ai/vllm/docker-compose.yml" ;;
          beellama) compose_file="/opt/scarlix/ai/llamacpp/docker-compose.yml" ;;
          *) continue ;;
        esac
        $DC -f "$compose_file" up -d --force-recreate >> "$LOG_FILE" 2>&1 && log "  ✓ $container recreated" || log "  ✗ $container recreate failed"
      else
        log "  ✓ $container: running ($health)"
      fi
    fi
  done

  # P0-7 v17.9.2: Store hash only after successful recreate
  if [ "$env_changed" = true ] && [ "$recreate_success" = true ]; then
    echo "$current_hash" > "$models_hash_file" 2>/dev/null || true
    log "models.yaml hash stored (recreate successful)"
  fi

  # Only check Ollama if it should be running (fallback mode)
  local ollama_status
  ollama_status=$(docker inspect -f '{{.State.Status}}' ollama-agent 2>/dev/null || echo "not_found")
  if [ "$ollama_status" = "running" ]; then
    log "  ✓ ollama-agent: running (fallback mode)"
  elif [ "$ollama_status" != "not_found" ]; then
    local sglang_st vllm_st
    sglang_st=$(docker inspect -f '{{.State.Status}}' sglang 2>/dev/null || echo "not_found")
    vllm_st=$(docker inspect -f '{{.State.Status}}' vllm 2>/dev/null || echo "not_found")
    if [ "$sglang_st" != "running" ] && { [ "$vllm_st" != "running" ] || [ "$EXPERIMENTAL" -eq 0 ]; }; then
      log "  ollama-agent: $ollama_status — restarting (SGLang+vLLM both down)..."
      $DC -f /opt/scarlix/ai/ollama/docker-compose.yml up -d >> "$LOG_FILE" 2>&1 && log "  ✓ ollama-agent restarted" || log "  ✗ ollama-agent restart failed"
    else
      log "  ℹ ollama-agent: stopped (SGLang or vLLM running — not needed)"
    fi
  fi
}

# Start verified AI path
start_verified_ai() {
  # P1 FIX v17.8: Always regenerate .env (was cached)
  load_model_paths

  log "Starting verified AI path..."
  local sglang_ok=0 vllm_ok=0 beellama_ok=0 ollama_ok=0

  # SGLang (GPU0) — P0 v17.9.3: wait_for_healthy after up -d
  if check_model_exists "SGLang" "$SGLANG_MODEL_PATH"; then
    if $DC -f /opt/scarlix/ai/sglang/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
      # P0 v17.9.3: Wait for healthy (up -d exit 0 ≠ model loaded)
      if wait_for_healthy "sglang" 300; then
        log "  ✓ SGLang (GPU0, healthy)"
        sglang_ok=1
      else
        log "  ✗ SGLang not healthy after 300s — will try fallback"
        # P1 v17.9.5: Stop SGLang to free VRAM for fallback (was running with restart:unless-stopped)
        docker stop sglang 2>/dev/null || true
      fi
    else
      log "  ✗ SGLang failed to start — will try fallback"
    fi
  else
    log "  ⚠ SGLang model missing — skipping"
  fi

  # vLLM (GPU1, TP=1) — only if .experimental
  if [ "$EXPERIMENTAL" -eq 1 ]; then
    if check_model_exists "vLLM" "$VLLM_MODEL_PATH"; then
      if $DC -f /opt/scarlix/ai/vllm/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
        if wait_for_healthy "vllm" 300; then
          log "  ✓ vLLM (GPU1, TP=1, healthy)"
          vllm_ok=1
        else
          log "  ✗ vLLM not healthy after 300s"
          # P1 v17.9.6: Stop vLLM to free GPU1 VRAM (same as SGLang stop on fail)
          docker stop vllm 2>/dev/null || true
        fi
      else
        log "  ✗ vLLM failed"
      fi
    else
      log "  ⚠ vLLM model missing — skipping"
    fi
  fi

  # P1 FIX v17.8: BeeLlama ONLY when SGLang+vLLM fail (was "always on" → wasted RAM)
  if [ "$sglang_ok" -eq 0 ] && [ "$vllm_ok" -eq 0 ]; then
    log "  ⚠ SGLang + vLLM both failed — trying BeeLlama (CPU)"
    if check_model_exists "llama.cpp" "$LLAMACPP_MODEL_PATH"; then
      if $DC -f /opt/scarlix/ai/llamacpp/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
        log "  ✓ BeeLlama (CPU, secondary fallback)"
        beellama_ok=1
      else
        log "  ✗ BeeLlama failed"
      fi
    else
      log "  ⚠ BeeLlama model missing — skipping"
    fi
  else
    log "  ℹ SGLang or vLLM running — BeeLlama skipped (saves RAM)"
  fi

  # Ollama (CPU) — tertiary fallback (only if BeeLlama also failed)
  if [ "$sglang_ok" -eq 0 ] && [ "$vllm_ok" -eq 0 ] && [ "$beellama_ok" -eq 0 ]; then
    log "  ⚠ All engines failed — starting Ollama (qwen2.5:3b, tertiary fallback)"
    if $DC -f /opt/scarlix/ai/ollama/docker-compose.yml up -d >> "$LOG_FILE" 2>&1; then
      log "  ✓ Ollama (CPU, tertiary fallback)"
      ollama_ok=1
    else
      log "  ✗ Ollama failed"
    fi
  else
    log "  ℹ Primary engine running — Ollama skipped (saves RAM)"
    ollama_ok=1
  fi

  # v18.5 P1: Return non-zero if NO inference engine is healthy (was: always implicit 0).
  # This tells host-bridge the mode switch FAILED → retry/failed state triggers.
  if [ "$sglang_ok" -eq 0 ] && [ "$vllm_ok" -eq 0 ] && [ "$beellama_ok" -eq 0 ] && [ "${ollama_ok:-0}" -eq 0 ]; then
    log "ERROR: no inference engine healthy — mode switch FAILED"
    return 1
  fi
  return 0
}

case "$MODE" in
  ai)
    # P1 FIX v17.8: Always regenerate .env before anything
    load_model_paths

    if [ "$CURRENT_MODE" = "stopped" ]; then
      log "Mode was 'stopped' — starting AI fresh..."
    elif [ "$CURRENT_MODE" = "ai" ]; then
      log "Already in AI mode — healthchecking (with .env regen)..."
      healthcheck_and_restart
      exit 0
    fi

    log "Starting verified AI path..."
    killall steam lutris 2>/dev/null || true
    # v18.5 P1: systemctl needs root — if user, try sudo
    if [ "$(id -u)" -eq 0 ]; then
      systemctl stop sunshine 2>/dev/null || true
    else
      sudo systemctl stop sunshine 2>/dev/null || true
    fi
    $DC -f /opt/scarlix/ai/comfyui/docker-compose.yml --profile creative stop 2>/dev/null || true
    $DC -f /opt/scarlix/gaming/docker-compose.yml --profile tv stop 2>/dev/null || true
    # v18.5 P1: check return value — don't write "ai" to state if no engine started
    if start_verified_ai; then
      echo "ai" | tee "$STATE_FILE" >/dev/null
    else
      log "ERROR: AI mode switch failed — no engine healthy. State NOT changed to 'ai'."
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  stop)
    log "=== Stopping AI stack (keeping dashboard/infra) ==="
    docker stop sglang vllm beellama ollama-agent 2>/dev/null || true
    $DC -f /opt/scarlix/ai/sglang/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    $DC -f /opt/scarlix/ai/vllm/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    $DC -f /opt/scarlix/ai/llamacpp/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    $DC -f /opt/scarlix/ai/ollama/docker-compose.yml stop >> "$LOG_FILE" 2>&1 || true
    echo "stopped" | tee "$STATE_FILE" >/dev/null
    log "AI stack stopped. Dashboard/infra still running. Run 'scarlix-mode ai' to restart."
    ;;
  game)
    [[ "$CURRENT_MODE" = "game" ]] && { log "Already in Game mode."; exit 0; }
    log "=== GAME mode (native Sunshine) ==="
    dump_vram
    # v18.5 P1: systemctl needs root — if user (non-root), try sudo with clear error.
    # Was (v18.5): removed sudo → user `scarlix-mode game` fails silently on systemctl.
    if [ "$(id -u)" -eq 0 ]; then
      systemctl start sunshine
    else
      sudo systemctl start sunshine 2>/dev/null || {
        log "WARN: systemctl start sunshine needs root. Use: sudo scarlix-mode game"
        log "       Or run via host-bridge (dashboard button)."
      }
    fi
    echo "game" | tee "$STATE_FILE" >/dev/null
    ;;
  creative)
    [[ "$CURRENT_MODE" = "creative" ]] && { log "Already in Creative mode."; exit 0; }
    log "=== CREATIVE mode ==="
    dump_vram
    # v18.5 P1: systemctl needs root — if user, try sudo with clear error
    if [ "$(id -u)" -eq 0 ]; then
      systemctl stop sunshine 2>/dev/null || true
    else
      sudo systemctl stop sunshine 2>/dev/null || true
    fi
    # v18.5 P2: ensure .env exists before $DC (creative may run without prior scarlix-mode ai)
    [ -f "$ENV_FILE" ] || load_model_paths
    $DC -f /opt/scarlix/ai/comfyui/docker-compose.yml --profile creative up -d
    $DC -f /opt/scarlix/ai/video/docker-compose.yml --profile creative up -d 2>/dev/null || true
    $DC -f /opt/scarlix/ai/musicgen/docker-compose.yml --profile creative up -d 2>/dev/null || true
    echo "creative" | tee "$STATE_FILE" >/dev/null
    ;;
  turbo)
    log "=== TURBO mode (SGLang + vLLM + BeeLlama, max) ==="
    # v18.5 P1: dump_vram before turbo (was: missing → CUDA OOM if creative/game still held VRAM)
    dump_vram
    # v18.5 P1: check return value
    if start_verified_ai; then
      echo "turbo" | tee "$STATE_FILE" >/dev/null
    else
      log "ERROR: TURBO mode switch failed — no engine healthy."
      echo "failed" | tee "$STATE_FILE" >/dev/null
      exit 1
    fi
    ;;
  offline)
    log "=== OFFLINE mode (BeeLlama CPU, q4_0 KV) ==="
    dump_vram
    # v18.5 P1: systemctl needs root — if user, try sudo
    if [ "$(id -u)" -eq 0 ]; then
      systemctl stop sunshine 2>/dev/null || true
    else
      sudo systemctl stop sunshine 2>/dev/null || true
    fi
    load_model_paths
    if check_model_exists "llama.cpp" "$LLAMACPP_MODEL_PATH"; then
      $DC -f /opt/scarlix/ai/llamacpp/docker-compose.yml up -d && log "  ✓ BeeLlama started"
    else
      log "ERROR: BeeLlama model not found: $LLAMACPP_MODEL_PATH"
      log "  Run: download-models.sh"
    fi
    echo "offline" | tee "$STATE_FILE" >/dev/null
    ;;
  tv)
    log "=== TV mode (Docker Sunshine) ==="
    # v18.5 P2: ensure .env exists before $DC
    [ -f "$ENV_FILE" ] || load_model_paths
    $DC -f /opt/scarlix/gaming/docker-compose.yml --profile tv up -d
    # v18.5 P1: systemctl needs root — if user, try sudo
    if [ "$(id -u)" -eq 0 ]; then
      systemctl start scarlix-tv-mode.service 2>/dev/null || true
    else
      sudo systemctl start scarlix-tv-mode.service 2>/dev/null || true
    fi
    echo "tv" | tee "$STATE_FILE" >/dev/null
    ;;
  vram|vram-check)
    show_vram
    exit $?
    ;;
  status)
    echo "=== SCARLIX OS v18.5 (EndeavourOS) Status ==="
    echo "Mode: $CURRENT_MODE"
    echo "Experimental: $([ $EXPERIMENTAL -eq 1 ] && echo 'YES (vLLM enabled)' || echo 'no (SGLang + BeeLlama only)')"
    echo "Base: $(grep '^PRETTY_NAME=' /etc/os-release 2>/dev/null | cut -d'"' -f2 || echo 'EndeavourOS')"
    echo "Kernel: $(uname -r)"
    echo "LTS: $(pacman -Q linux-lts 2>/dev/null || echo 'not installed')"
    echo ""
    echo "Inference containers:"
    echo "  SGLang: $(docker inspect -f '{{.State.Status}}' sglang 2>/dev/null || echo 'not running')"
    [ "$EXPERIMENTAL" -eq 1 ] && echo "  vLLM: $(docker inspect -f '{{.State.Status}}' vllm 2>/dev/null || echo 'not running')"
    echo "  BeeLlama: $(docker inspect -f '{{.State.Status}}' beellama 2>/dev/null || echo 'not running')"
    echo "  Ollama: $(docker inspect -f '{{.State.Status}}' ollama-agent 2>/dev/null || echo 'not running')"
    echo ""
    echo "Models:"
    [ -f "$MODELS_YAML" ] && echo "  Config: $MODELS_YAML" || echo "  Config: NOT FOUND"
    [ -f "$ENV_FILE" ] && echo "  Env: $ENV_FILE ($(stat -c %y "$ENV_FILE" 2>/dev/null | cut -d. -f1))" || echo "  Env: not generated"
    [ -d /models ] && echo "  Dir: /models ($(ls /models 2>/dev/null | wc -l) entries)" || echo "  Dir: /models NOT FOUND"
    echo ""
    echo "GPU:"
    nvidia-smi --query-gpu=index,name,memory.used,memory.free,compute_cap --format=csv,noheader 2>/dev/null || echo "  nvidia-smi not available"
    echo ""
    echo "Commands:"
    echo "  scarlix-mode ai       — Start/verify AI"
    echo "  scarlix-mode stop     — Stop AI stack"
    echo "  scarlix-mode vram     — VRAM details"
    echo "  download-models.sh    — Download models"
    ;;
  *)
    echo "Usage: scarlix-mode {ai|stop|game|creative|turbo|offline|tv|status|vram}"
    echo ""
    echo "  ai       — Verified AI path (SGLang + vLLM + BeeLlama + Ollama fallback)"
    echo "  stop     — Stop AI stack (no healthcheck restart)"
    echo "  turbo    — Max throughput"
    echo "  offline  — BeeLlama CPU only"
    echo "  game     — Native Steam/Sunshine"
    echo "  creative — ComfyUI + Video + Music"
    echo "  tv       — Docker Sunshine"
    echo "  status   — System summary"
    echo "  vram     — VRAM health check"
    exit 1
    ;;
esac
flock -u 200
