#!/usr/bin/env bash
# SCARLIX OS v17.9.9 — Host Bridge (privileged ops for ScarliHQ dashboard)
#
# ARCHITECTURE (v17.9.8+): ScarliHQ container has NO docker.sock, NO nvidia runtime,
# NO scarlix-mode mount. It reads/writes status files in /var/lib/scarlix/.
# This host-side script (run by systemd timer every 5s) does the privileged work:
#   1. Applies desired-mode (if ScarliHQ wrote /var/lib/scarlix/bridge/desired-mode)
#   2. Refreshes /var/lib/scarlix/host-status.json (GPU + containers + mode + disk)
#
# v17.9.9 FIXES:
#   P0: df parsing fixed (was: read total=Used, free=Used-Avail — swapped columns)
#   P1: desired-mode KEPT on failure (was: rm -f always → lost retry info)
#   P1: structured error fields (was: "ERROR: ..." string in mode_applied)
#   P1: JSON via python3 json.dumps (was: shell heredoc — broke on quotes/backslashes)
#   P1: state machine fields: requested_mode, current_mode, transition, retry_count
#
# This is the privilege boundary: ScarliHQ (untrusted, LAN-facing) → file → host bridge → root ops.
set -uo pipefail

STATE_DIR="/var/lib/scarlix"
BRIDGE_DIR="$STATE_DIR/bridge"
DESIRED_MODE_FILE="$BRIDGE_DIR/desired-mode"
RETRY_FILE="$BRIDGE_DIR/.retry"  # tracks retry count + last error for desired-mode
CURRENT_MODE_FILE="$STATE_DIR/current-mode"
STATUS_FILE="$STATE_DIR/host-status.json"
LOCK_FILE="/var/lock/scarlix-host-bridge.lock"
MODE_BIN="/usr/local/bin/scarlix-mode"
MAX_RETRIES=3

# Prevent overlap (timer can fire every 5s; scarlix-mode ai may take minutes)
exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

mkdir -p "$BRIDGE_DIR"

# --- 1. Apply desired mode (if any) ---
requested_mode=""
transition="none"
retry_count=0
last_error=""

if [ -f "$DESIRED_MODE_FILE" ]; then
    requested_mode=$(tr -d '[:space:]' < "$DESIRED_MODE_FILE" 2>/dev/null || echo "")
    # Read retry state if exists (from previous failed attempt)
    if [ -f "$RETRY_FILE" ]; then
        retry_count=$(grep '^count=' "$RETRY_FILE" 2>/dev/null | cut -d= -f2 || echo 0)
        last_error=$(grep '^error=' "$RETRY_FILE" 2>/dev/null | cut -d= -f2- || echo "")
    fi

    # Validate against scarlix-mode's accepted modes
    case "$requested_mode" in
        ai|stop|game|creative|turbo|offline|tv)
            if [ -x "$MODE_BIN" ]; then
                if "$MODE_BIN" "$requested_mode" >/var/log/scarlix-host-bridge.log 2>&1; then
                    transition="applied"
                    # Success — clear retry state + desired-mode
                    rm -f "$DESIRED_MODE_FILE" "$RETRY_FILE" 2>/dev/null || true
                    last_error=""
                    retry_count=0
                else
                    retry_count=$((retry_count + 1))
                    last_error=$("$MODE_BIN" "$requested_mode" 2>&1 | tail -5 | tr '\n' ' ' | head -c 500)
                    if [ "$retry_count" -ge "$MAX_RETRIES" ]; then
                        transition="failed"
                        # Max retries reached — give up (don't delete, but mark failed)
                        rm -f "$DESIRED_MODE_FILE" "$RETRY_FILE" 2>/dev/null || true
                    else
                        transition="retrying"
                        # KEEP desired-mode for retry + save retry state
                        printf 'count=%s\nerror=%s\n' "$retry_count" "$last_error" > "$RETRY_FILE" 2>/dev/null || true
                    fi
                fi
            else
                transition="failed"
                last_error="$MODE_BIN not found"
                rm -f "$DESIRED_MODE_FILE" "$RETRY_FILE" 2>/dev/null || true
            fi
            ;;
        *)
            transition="failed"
            last_error="invalid mode '$requested_mode' (valid: ai,stop,game,creative,turbo,offline,tv)"
            rm -f "$DESIRED_MODE_FILE" "$RETRY_FILE" 2>/dev/null || true
            ;;
    esac
fi

# --- 2. Gather host status ---
current_mode="unknown"
[ -f "$CURRENT_MODE_FILE" ] && current_mode=$(tr -d '[:space:]' < "$CURRENT_MODE_FILE" 2>/dev/null || echo "unknown")
[ -z "$current_mode" ] && current_mode="unknown"

# GPU status (nvidia-smi if available)
gpu_data="[]"
if command -v nvidia-smi >/dev/null 2>&1; then
    # v17.9.9 P1: use python3 for safe JSON (was: shell awk → broke on GPU names with quotes)
    gpu_data=$(nvidia-smi --query-gpu=index,name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,compute_cap \
        --format=csv,noheader,nounits 2>/dev/null | python3 -c '
import sys, json
gpus = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    parts = [p.strip() for p in line.split(",")]
    if len(parts) < 8:
        continue
    try:
        gpus.append({
            "index": int(parts[0]),
            "name": parts[1],
            "temp": float(parts[2]) if parts[2] not in ("", "N/A") else 0,
            "util": float(parts[3]) if parts[3] not in ("", "N/A") else 0,
            "mem_used": float(parts[4]) if parts[4] not in ("", "N/A") else 0,
            "mem_total": float(parts[5]) if parts[5] not in ("", "N/A") else 0,
            "power": float(parts[6]) if parts[6] not in ("", "N/A") else 0,
            "compute_cap": parts[7],
        })
    except (ValueError, IndexError):
        continue
print(json.dumps(gpus))
' 2>/dev/null || echo "[]")
fi

# Container status (docker if available + socket accessible)
container_data="[]"
if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
    # v17.9.9 P1: use python3 for safe JSON (was: shell awk → broke on container names with quotes)
    container_data=$(docker ps -a --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | python3 -c '
import sys, json
containers = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line:
        continue
    parts = line.split("\t")
    if len(parts) < 3:
        parts = parts + [""] * (3 - len(parts))
    containers.append({
        "name": parts[0],
        "status": parts[1],
        "ports": parts[2],
    })
print(json.dumps(containers))
' 2>/dev/null || echo "[]")
fi

# v17.9.9 P0: Disk space on /models — FIXED df parsing
# df -m columns: Filesystem, 1M-blocks (size), Used, Available, Use%, Mounted-on
# Was: `read -r _ _ total used _ _` → total=Used(!!!), used=Available(!!!)
# Now: `read -r _ size used avail _ _` → size=Size, used=Used, avail=Available
models_disk_free_mb=0
models_disk_total_mb=0
if df -m /models >/dev/null 2>&1; then
    read -r _ size used avail _ < <(df -m /models | tail -1)
    models_disk_total_mb=${size:-0}
    models_disk_free_mb=${avail:-0}
    # Sanitize to integers (df may output non-numeric on weird FS)
    [[ "$models_disk_total_mb" =~ ^[0-9]+$ ]] || models_disk_total_mb=0
    [[ "$models_disk_free_mb" =~ ^[0-9]+$ ]] || models_disk_free_mb=0
fi

# Experimental flag
experimental=false
[ -f /etc/scarlix/.experimental ] && experimental=true

# ScarliHQ dashboard version
scarlix_version="unknown"
for vf in /etc/scarlix/VERSION /usr/local/share/scarlix/VERSION; do
    if [ -f "$vf" ]; then
        scarlix_version=$(tr -d '[:space:]' < "$vf" 2>/dev/null || echo "unknown")
        [ "$scarlix_version" = "unknown" ] || break
    fi
done

# v17.9.9 P1: Write status JSON via python3 (safe escaping — was: shell heredoc)
python3 -c '
import json, sys
data = {
    "timestamp": "'"$(date -Iseconds 2>/dev/null || date)"'",
    "version": "17.9.9",
    "scarlix_version": "'"$scarlix_version"'",
    "mode": "'"$current_mode"'",
    "experimental": '"$experimental"',
    "mode_transition": {
        "requested": "'"$requested_mode"'",
        "state": "'"$transition"'",
        "retry_count": '"$retry_count"',
        "last_error": '"$(python3 -c "import json; print(json.dumps(\"$last_error\"))" 2>/dev/null || echo '""')"'
    },
    "gpus": '"$gpu_data"',
    "containers": '"$container_data"',
    "disk": {
        "models_free_mb": '"$models_disk_free_mb"',
        "models_total_mb": '"$models_disk_total_mb"'
    }
}
print(json.dumps(data))
' > "$STATUS_FILE.tmp" 2>/dev/null || {
    # Fallback: write minimal JSON if python3 unavailable
    printf '{"timestamp":"%s","version":"17.9.9","mode":"%s","error":"python3 unavailable"}' \
        "$(date -Iseconds 2>/dev/null || date)" "$current_mode" > "$STATUS_FILE.tmp"
}
mv -f "$STATUS_FILE.tmp" "$STATUS_FILE" 2>/dev/null || true
chmod 644 "$STATUS_FILE" 2>/dev/null || true

exit 0
