#!/usr/bin/env bash
# SCARLIX OS v19.0.0 — Host Bridge (privileged ops for ScarliHQ dashboard)
#
# ARCHITECTURE (v18.0.0): ScarliHQ container has NO docker.sock, NO nvidia runtime.
# It writes ONLY to /var/lib/scarlix/bridge-input/desired-mode (writable by nonroot 65532).
# Host bridge reads from bridge-input/ but writes ALL state to bridge-state/ (root:root 700).
# This prevents symlink attacks: ScarliHQ cannot create symlinks in bridge-state/ (not writable).
#
# v18.0.0 FIXES (vs v17.9.9):
#   P0: Separate bridge-input/ (65532 writable) from bridge-state/ (root 700)
#       — was: ScarliHQ owned bridge/ + root wrote .retry there = symlink attack surface
#   P0: Single scarlix-mode execution per transition
#       — was: ran scarlix-mode TWICE on failure (once for check, once for error capture)
#   P1: Persistent failed transition state (last_transition, last_failure, last_error)
#       — was: cleared on next timer tick → diagnostic info lost
#   P1: Input validation: ownership + symlink + type checks on desired-mode
#       — was: no validation → root could follow symlink created by nonroot
#   P1: No hardcoded version (reads from /etc/scarlix/VERSION)
#
# v18.7.6 P1: ATOMIC file read via scarlix-bridge-reader (Go binary).
#   Old shell pattern (validate + cat + re-validate) had a TOCTOU window — ScarliHQ
#   could swap the file between validate and read. New Go binary opens with
#   O_NOFOLLOW, fstats the fd, validates UID/mode/type/size, and reads from the
#   SAME fd — no TOCTOU window.
# v18.7.6 P0: bridge-reader is now REQUIRED. If the Go binary isn't installed,
#   the host-bridge rejects the desired-mode and logs a FATAL line (was: fell
#   back to the shell validate+cat+re-validate pattern, which still had the
#   TOCTOU window). install.sh Phase 4 now crit()s if the build fails.
# v18.7.6 P0: stderr now goes to /var/log/scarlix/bridge-reader.log (was:
#   /tmp/sbr.err — predictable path, world-writable parent, symlink risk).
# v18.7.7 P1: Timeouts on all external commands (nvidia-smi, docker info, docker ps)
#   — was: a hung nvidia-smi (GPU reset/driver hang) or a frozen Docker daemon
#   would block the 5s host-bridge timer indefinitely → host-status.json stops
#   updating → dashboard goes stale with no error. Now: timeout 10s/5s wraps
#   each external call so the timer always completes.
# v18.7.7 P1: Fail-closed retry-state write (was: `printf > $RETRY_FILE || true`
#   → on disk-full/RO-fs the retry state was silently lost → next timer tick
#   saw retry_count=0 → retry state lost mid-transition). Now: mktemp + mv with
#   exit 1 on failure (same pattern as last-transition + status file).
# v18.7.7 P1: Validate last_retry regex (was: int(os.environ["..."]) could
#   panic on a corrupted state file → fallback JSON → missing mode_transition).
# v18.7.7 P2: All logs under /var/log/scarlix/ (was: host-bridge log at
#   /var/log/scarlix-host-bridge.log while bridge-reader log was at
#   /var/log/scarlix/bridge-reader.log → inconsistent during debugging).
#
# This is the privilege boundary: ScarliHQ (untrusted, LAN-facing) → file → host bridge → root ops.
set -uo pipefail

STATE_DIR="/var/lib/scarlix"
# v18.0.0 P0: SEPARATE directories — ScarliHQ can ONLY write to INPUT_DIR
INPUT_DIR="$STATE_DIR/bridge-input"      # owner 65532:65532, mode 700 (ScarliHQ writes desired-mode here)
STATE_DIR_ROOT="$STATE_DIR/bridge-state" # owner root:root, mode 700 (host bridge writes retry/state here)
DESIRED_MODE_FILE="$INPUT_DIR/desired-mode"
RETRY_FILE="$STATE_DIR_ROOT/.retry"
LAST_TRANSITION_FILE="$STATE_DIR_ROOT/last-transition"  # persistent (survives timer cycles)
CURRENT_MODE_FILE="$STATE_DIR/current-mode"
STATUS_FILE="$STATE_DIR/host-status.json"
LOCK_FILE="/var/lock/scarlix-host-bridge.lock"
MODE_BIN="/usr/local/bin/scarlix-mode"
MAX_RETRIES=3

# v18.8.5 P1: Ensure /var/lock exists (was: missing → exec 200> failed → flock failed
#   → script exit 0 → host-bridge silently did nothing → stale dashboard).
#   On minimal Arch installs /var/lock may be absent or a dangling symlink to
#   /run/lock which itself may not exist. mkdir both, tolerate failure.
mkdir -p /var/lock 2>/dev/null || mkdir -p /run/lock 2>/dev/null || true
exec 200>"$LOCK_FILE"
flock -n 200 || exit 0

mkdir -p "$INPUT_DIR" "$STATE_DIR_ROOT"
# v18.7.6 P0: bridge-reader stderr log dir (was: /tmp/sbr.err — predictable path).
# v18.7.7 P2: All scarlix logs under /var/log/scarlix/ (was: host-bridge log at
#   /var/log/scarlix-host-bridge.log → inconsistent with bridge-reader.log).
# Created unconditionally so the bridge-reader redirect below never silently drops errors.
mkdir -p /var/log/scarlix 2>/dev/null || true
# v18.7.7 P2: unified log path
BRIDGE_LOG="/var/log/scarlix/host-bridge.log"
# v18.3 P1: fail-closed on security boundary dirs (was: `|| true` → continued on failure)
# bridge-state/ MUST be root:root 700 — if we can't enforce that, abort (don't continue).
if ! chown root:root "$STATE_DIR_ROOT" 2>/dev/null; then
    echo "[$(date '+%H:%M:%S')] FATAL: cannot chown root:root $STATE_DIR_ROOT — aborting" >> "$BRIDGE_LOG" 2>/dev/null || true
    exit 1
fi
if ! chmod 700 "$STATE_DIR_ROOT" 2>/dev/null; then
    echo "[$(date '+%H:%M:%S')] FATAL: cannot chmod 700 $STATE_DIR_ROOT — aborting" >> "$BRIDGE_LOG" 2>/dev/null || true
    exit 1
fi

# v18.7.6 P1: Verify bridge-input integrity at every run (was: only checked at install time)
input_owner=$(stat -c '%u:%g' "$INPUT_DIR" 2>/dev/null || echo "?")
input_mode=$(stat -c '%a' "$INPUT_DIR" 2>/dev/null || echo "?")
if [ "$input_owner" != "65532:65532" ] || [ "$input_mode" != "700" ]; then
    echo "[$(date '+%H:%M:%S')] FATAL: bridge-input integrity compromised (owner=$input_owner, mode=$input_mode, expected 65532:65532/700)" >> "$BRIDGE_LOG" 2>/dev/null || true
    exit 1
fi

# --- v18.0.0 P1: Input validation (prevent symlink/ownership attacks) ---
validate_input_file() {
    local f="$1"
    # v18.3 P0: FIXED octal permission check (was: `$((perms & 022))` interpreted 600 as DECIMAL
    # not octal → 600 & 022 = 16 (not 0) → REJECTED legit 0600 files from Go CreateTemp).
    # Now: explicit whitelist of safe permission modes.
    [ -f "$f" ] || { log_warn "REJECTED: $f not a regular file"; return 1; }
    # Must NOT be a symlink (root could follow to arbitrary path)
    [ -L "$f" ] && { log_warn "REJECTED: $f is a symlink (possible attack)"; return 1; }
    # v18.2 P1: explicit FIFO/pipe/socket/block/char device rejection
    [ -p "$f" ] && { log_warn "REJECTED: $f is a FIFO/pipe (DoS risk)"; return 1; }
    [ -S "$f" ] && { log_warn "REJECTED: $f is a socket"; return 1; }
    [ -b "$f" ] && { log_warn "REJECTED: $f is a block device"; return 1; }
    [ -c "$f" ] && { log_warn "REJECTED: $f is a char device"; return 1; }
    # Must be owned by the expected UID (65532 = nonroot in ScarliHQ container)
    local owner_uid
    owner_uid=$(stat -c %u "$f" 2>/dev/null || echo 0)
    [ "$owner_uid" = "65532" ] || { log_warn "REJECTED: $f owned by uid $owner_uid (expected 65532)"; return 1; }
    # v18.3 P0: Permission check — explicit whitelist (was: octal arithmetic bug).
    # Go os.CreateTemp() creates 0600 files; old code rejected them due to decimal interpretation.
    # Allowed: 600 (owner-only), 640 (owner+group read), 700 (owner rwx)
    local mode
    mode=$(stat -c %a "$f" 2>/dev/null || echo "000")
    case "$mode" in
        600|640|700)
            # Safe: no world-writable, no world-readable (600/640/700 all have 0 in others field)
            ;;
        *)
            log_warn "REJECTED: $f has unsafe perms $mode (allowed: 600, 640, 700)"
            return 1
            ;;
    esac
    # Max size (prevent DoS — mode name is max 20 chars)
    local size
    size=$(stat -c %s "$f" 2>/dev/null || echo 0)
    [ "$size" -le 100 ] || { log_warn "REJECTED: $f too large ($size bytes)"; return 1; }
    return 0
}

log_warn() { echo "[$(date '+%H:%M:%S')] WARN: $1" >> "$BRIDGE_LOG" 2>/dev/null || true; }

# --- 1. Apply desired mode (if any) ---
requested_mode=""
transition="none"
retry_count=0
last_error=""

# Read retry state from previous attempt (persistent across timer cycles)
if [ -f "$RETRY_FILE" ]; then
    retry_count=$(grep '^count=' "$RETRY_FILE" 2>/dev/null | cut -d= -f2 || echo 0)
    last_error=$(grep '^error=' "$RETRY_FILE" 2>/dev/null | cut -d= -f2- || echo "")
    # Sanitize
    [[ "$retry_count" =~ ^[0-9]+$ ]] || retry_count=0
fi

if [ -f "$DESIRED_MODE_FILE" ]; then
    # v18.7.6 P0: bridge-reader is REQUIRED (was: shell validate+cat+re-validate
    # fallback had a TOCTOU window — ScarliHQ could swap the file between validate
    # and read). The Go binary opens with O_NOFOLLOW, fstats the fd, validates
    # UID/mode/type/size, and reads from the SAME fd — the kernel holds the inode
    # reference via the fd (rename/unlink/recreate of `path` cannot affect the
    # read). No shell fallback: if the binary is missing, we reject and log FATAL.
    # v18.7.6 P0: stderr now appends to /var/log/scarlix/bridge-reader.log (was:
    # /tmp/sbr.err — predictable path, symlink risk).
    if [ -x /usr/local/bin/scarlix-bridge-reader ]; then
        requested_mode=$(/usr/local/bin/scarlix-bridge-reader "$DESIRED_MODE_FILE" 2>>/var/log/scarlix/bridge-reader.log | tr -d '[:space:]' || echo "")
        if [ -z "$requested_mode" ]; then
            transition="rejected"
            last_error="bridge-reader: file validation failed (see /var/log/scarlix/bridge-reader.log)"
            rm -f "$DESIRED_MODE_FILE" 2>/dev/null || true
        fi
    else
        # v18.7.6 P0: No fallback — atomic reader is required for security.
        # (was: fell back to validate+cat+re-validate shell pattern → TOCTOU window.)
        echo "[$(date '+%H:%M:%S')] FATAL: scarlix-bridge-reader not installed — cannot process desired-mode safely" >> "$BRIDGE_LOG" 2>/dev/null || true
        rm -f "$DESIRED_MODE_FILE" 2>/dev/null || true
        transition="rejected"
        last_error="scarlix-bridge-reader not installed (run install.sh to build)"
    fi

    # v18.7.6 P1: Only process if not rejected by TOCTOU check / bridge-reader
    if [ -n "$requested_mode" ] && [ "$transition" != "rejected" ]; then
    # Validate mode against whitelist
    case "$requested_mode" in
        ai|stop|game|creative|turbo|offline|tv)
            if [ -x "$MODE_BIN" ]; then
                # v18.1 P0: capture exit code correctly (was: `|| true` masked rc to 0
                # → transition always "applied" even on failure → retry never triggered)
                # Note: script uses `set -uo pipefail` (NOT -e), so command substitution
                # assignment doesn't abort — rc is captured correctly without || true.
                # v18.0.0: SINGLE execution (was: ran twice on failure for error capture)
                mode_output=$("$MODE_BIN" "$requested_mode" 2>&1)
                mode_rc=$?
                echo "$mode_output" >> "$BRIDGE_LOG" 2>/dev/null || true

                if [ "$mode_rc" -eq 0 ]; then
                    transition="applied"
                    rm -f "$DESIRED_MODE_FILE" "$RETRY_FILE" 2>/dev/null || true
                    last_error=""
                    retry_count=0
                else
                    retry_count=$((retry_count + 1))
                    # v18.1: sanitize last_error — strip newlines, truncate to 500 chars
                    last_error=$(printf '%s' "$mode_output" | tr '\n' ' ' | tr -d '\r' | head -c 500)
                    if [ "$retry_count" -ge "$MAX_RETRIES" ]; then
                        transition="failed"
                        rm -f "$DESIRED_MODE_FILE" "$RETRY_FILE" 2>/dev/null || true
                    else
                        transition="retrying"
                        # v18.7.7 P1: Fail-closed retry-state write (was: `printf > $RETRY_FILE || true`
                        #   → on disk-full/RO-fs the retry state was silently lost → next timer tick
                        #   saw retry_count=0 → retry state lost mid-transition). Now: mktemp + mv
                        #   with exit 1 on failure (same pattern as last-transition + status file).
                        RETRY_TMP=$(mktemp "${RETRY_FILE}.XXXXXX") || exit 1
                        if ! printf 'count=%s\nerror=%s\n' "$retry_count" "$last_error" > "$RETRY_TMP" 2>/dev/null; then
                            rm -f "$RETRY_TMP" 2>/dev/null || true
                            echo "[$(date '+%H:%M:%S')] FATAL: cannot persist retry state" >> "$BRIDGE_LOG" 2>/dev/null || true
                            transition="failed"
                            rm -f "$DESIRED_MODE_FILE" 2>/dev/null || true
                        else
                            mv -f "$RETRY_TMP" "$RETRY_FILE" 2>/dev/null || {
                                rm -f "$RETRY_TMP" 2>/dev/null || true
                                echo "[$(date '+%H:%M:%S')] FATAL: cannot mv retry state" >> "$BRIDGE_LOG" 2>/dev/null || true
                                transition="failed"
                                rm -f "$DESIRED_MODE_FILE" 2>/dev/null || true
                            }
                        fi
                    fi
                fi
            else
                transition="failed"
                last_error="$MODE_BIN not found"
                rm -f "$DESIRED_MODE_FILE" 2>/dev/null || true
            fi
            ;;
        *)
            transition="failed"
            last_error="invalid mode '$requested_mode' (valid: ai,stop,game,creative,turbo,offline,tv)"
            rm -f "$DESIRED_MODE_FILE" 2>/dev/null || true
            ;;
    esac
    fi  # v18.7.6 P1: end rejection guard (TOCTOU or bridge-reader)

    # v18.0.0 P1: Persist last transition (survives timer cycles — diagnostic info not lost)
    # v18.7.6 P1: ATOMIC write via mktemp + mv (was: printf > file → partial on crash).
    #   The previous `> "$LAST_TRANSITION_FILE" 2>/dev/null || true` could leave a
    #   truncated file if the host lost power mid-write (e.g. yank cord during mode
    #   switch). ScarliHQ's status.go then parsed a half-written file and reported a
    #   misleading transition state. Same mktemp + mv pattern as STATUS_FILE below:
    #   fail-closed (exit 1) on disk error so the timer surfaces the problem rather
    #   than silently dropping diagnostic state.
    LAST_TMP=$(mktemp "${LAST_TRANSITION_FILE}.XXXXXX") || exit 1
    printf 'requested=%s\nstate=%s\ntimestamp=%s\nretry_count=%s\nerror=%s\n' \
        "$requested_mode" "$transition" "$(date -Iseconds 2>/dev/null || date)" "$retry_count" "$last_error" \
        > "$LAST_TMP" 2>/dev/null || { rm -f "$LAST_TMP" 2>/dev/null || true; exit 1; }
    mv -f "$LAST_TMP" "$LAST_TRANSITION_FILE" 2>/dev/null || { rm -f "$LAST_TMP" 2>/dev/null || true; exit 1; }
fi

# Read persistent last_transition (for status even when no new request)
# v18.2 P2: also restore retry_count + last_error (was: only requested/state/timestamp)
last_requested=""
last_state=""
last_timestamp=""
if [ -f "$LAST_TRANSITION_FILE" ]; then
    last_requested=$(grep '^requested=' "$LAST_TRANSITION_FILE" 2>/dev/null | cut -d= -f2 || echo "")
    last_state=$(grep '^state=' "$LAST_TRANSITION_FILE" 2>/dev/null | cut -d= -f2 || echo "")
    last_timestamp=$(grep '^timestamp=' "$LAST_TRANSITION_FILE" 2>/dev/null | cut -d= -f2- || echo "")
    # v18.2 P2: restore retry_count + last_error from last-transition file
    # v18.7.7 P1: Validate last_retry regex (was: int(os.environ["..."]) could
    #   panic on a corrupted state file → fallback JSON → missing mode_transition).
    last_retry=$(grep '^retry_count=' "$LAST_TRANSITION_FILE" 2>/dev/null | cut -d= -f2 || echo "0")
    [[ "$last_retry" =~ ^[0-9]+$ ]] || last_retry=0
    # Clamp to MAX_RETRIES so a corrupted file can't set an absurd value
    (( last_retry <= MAX_RETRIES )) || last_retry=$MAX_RETRIES
    last_error_stored=$(grep '^error=' "$LAST_TRANSITION_FILE" 2>/dev/null | cut -d= -f2- || echo "")
    # If current transition is "none", use last_transition for status
    if [ "$transition" = "none" ]; then
        requested_mode="$last_requested"
        transition="$last_state"
        retry_count="$last_retry"
        [ -z "$last_error" ] && last_error="$last_error_stored"
    fi
fi

# --- 2. Gather host status ---
current_mode="unknown"
[ -f "$CURRENT_MODE_FILE" ] && current_mode=$(tr -d '[:space:]' < "$CURRENT_MODE_FILE" 2>/dev/null || echo "unknown")
[ -z "$current_mode" ] && current_mode="unknown"

# GPU status
# v18.7.7 P1: timeout 10s on nvidia-smi (was: bare nvidia-smi → a hung GPU
#   reset or driver hang would block the 5s host-bridge timer indefinitely →
#   host-status.json goes stale, dashboard shows no error). timeout returns 124
#   on expiry; gpu_data stays "[]" which the dashboard renders as "no GPUs".
gpu_data="[]"
if command -v nvidia-smi >/dev/null 2>&1; then
    gpu_data=$(timeout 10s nvidia-smi --query-gpu=index,name,temperature.gpu,utilization.gpu,memory.used,memory.total,power.draw,compute_cap \
        --format=csv,noheader,nounits 2>/dev/null | python3 -c '
import sys, json
gpus = []
for line in sys.stdin:
    line = line.strip()
    if not line: continue
    parts = [p.strip() for p in line.split(",")]
    if len(parts) < 8: continue
    try:
        gpus.append({
            "index": int(parts[0]), "name": parts[1],
            "temp": float(parts[2]) if parts[2] not in ("","N/A") else 0,
            "util": float(parts[3]) if parts[3] not in ("","N/A") else 0,
            "mem_used": float(parts[4]) if parts[4] not in ("","N/A") else 0,
            "mem_total": float(parts[5]) if parts[5] not in ("","N/A") else 0,
            "power": float(parts[6]) if parts[6] not in ("","N/A") else 0,
            "compute_cap": parts[7],
        })
    except (ValueError, IndexError): continue
print(json.dumps(gpus))
' 2>/dev/null || echo "[]")
fi

# Container status
# v18.7.7 P1: timeout 5s on docker info + timeout 10s on docker ps (was: bare
#   calls → a frozen Docker daemon would block the timer indefinitely). If the
#   daemon is unresponsive, container_data stays "[]" which renders as "no
#   containers" — the dashboard still shows the last known GPU/mode status.
container_data="[]"
if command -v docker >/dev/null 2>&1 && timeout 5s docker info >/dev/null 2>&1; then
    container_data=$(timeout 10s docker ps -a --format '{{.Names}}\t{{.Status}}\t{{.Ports}}' 2>/dev/null | python3 -c '
import sys, json
containers = []
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line: continue
    parts = line.split("\t")
    if len(parts) < 3: parts = parts + [""] * (3 - len(parts))
    containers.append({"name": parts[0], "status": parts[1], "ports": parts[2]})
print(json.dumps(containers))
' 2>/dev/null || echo "[]")
fi

# v18.3 P1: locale-independent df (was: `df -m` without --output — breaks on LANG=sk_SK)
# --output=source,size,used,avail,target gives deterministic columns regardless of locale
models_disk_free_mb=0
models_disk_total_mb=0
if df -m --output=size,avail /models >/dev/null 2>&1; then
    read -r size avail < <(df -m --output=size,avail /models | tail -1)
    models_disk_total_mb=${size:-0}
    models_disk_free_mb=${avail:-0}
    [[ "$models_disk_total_mb" =~ ^[0-9]+$ ]] || models_disk_total_mb=0
    [[ "$models_disk_free_mb" =~ ^[0-9]+$ ]] || models_disk_free_mb=0
fi

# Experimental flag
experimental=false
[ -f /etc/scarlix/.experimental ] && experimental=true

# v18.0.0 P1: version from VERSION file (was: hardcoded "17.9.9")
scarlix_version="unknown"
for vf in /etc/scarlix/VERSION /usr/local/share/scarlix/VERSION; do
    if [ -f "$vf" ]; then
        scarlix_version=$(tr -d '[:space:]' < "$vf" 2>/dev/null || echo "unknown")
        [ "$scarlix_version" = "unknown" ] || break
    fi
done

# v18.0.0 P1: Write status JSON via single python3 call with env vars (was: nested string interpolation)
# v18.4 P1: Use mktemp for status file (was: fixed .tmp name — predictable)
STATUS_TMP=$(mktemp "${STATUS_FILE}.XXXXXX") || exit 1
BRIDGE_INPUT_DIR="$INPUT_DIR" \
BRIDGE_STATE_DIR="$STATE_DIR_ROOT" \
STATUS_TIMESTAMP="$(date -Iseconds 2>/dev/null || date)" \
STATUS_VERSION="$scarlix_version" \
STATUS_MODE="$current_mode" \
STATUS_EXPERIMENTAL="$experimental" \
STATUS_REQUESTED="$requested_mode" \
STATUS_TRANSITION="$transition" \
STATUS_RETRY_COUNT="$retry_count" \
STATUS_LAST_ERROR="$last_error" \
STATUS_LAST_TIMESTAMP="$last_timestamp" \
STATUS_GPUS="$gpu_data" \
STATUS_CONTAINERS="$container_data" \
STATUS_DISK_FREE="$models_disk_free_mb" \
STATUS_DISK_TOTAL="$models_disk_total_mb" \
python3 -c '
import json, os
data = {
    "timestamp": os.environ["STATUS_TIMESTAMP"],
    "version": os.environ["STATUS_VERSION"],  # v18.0.0: no hardcoded version
    "scarlix_version": os.environ["STATUS_VERSION"],
    "mode": os.environ["STATUS_MODE"],
    "experimental": os.environ["STATUS_EXPERIMENTAL"] == "true",
    "mode_transition": {
        "requested": os.environ["STATUS_REQUESTED"],
        "state": os.environ["STATUS_TRANSITION"],
        "retry_count": int(os.environ["STATUS_RETRY_COUNT"] or 0),
        "last_error": os.environ["STATUS_LAST_ERROR"],
        "last_timestamp": os.environ["STATUS_LAST_TIMESTAMP"],
    },
    "gpus": json.loads(os.environ["STATUS_GPUS"] or "[]"),
    "containers": json.loads(os.environ["STATUS_CONTAINERS"] or "[]"),
    "disk": {
        "models_free_mb": int(os.environ["STATUS_DISK_FREE"] or 0),
        "models_total_mb": int(os.environ["STATUS_DISK_TOTAL"] or 0),
    },
}
print(json.dumps(data))
' > "$STATUS_TMP" 2>/dev/null || {
    # v18.5 P1: Include stale:true + empty arrays so Go HostStatus parses correctly (was: missing fields → valid-looking status)
    printf '{"timestamp":"%s","version":"%s","mode":"%s","error":"python3 unavailable","stale":true,"gpus":[],"containers":[]}' \
        "$(date -Iseconds 2>/dev/null || date)" "$scarlix_version" "$current_mode" > "$STATUS_TMP"
}
# v18.7.2 P1: Fail-closed on status write (was: || true → systemd saw SUCCESS on failure)
if ! mv -f "$STATUS_TMP" "$STATUS_FILE" 2>/dev/null; then
    echo "[$(date '+%H:%M:%S')] FATAL: cannot publish host status" >> "$BRIDGE_LOG" 2>/dev/null || true
    rm -f "$STATUS_TMP" 2>/dev/null || true
    exit 1
fi
# v18.7.6 P2: chmod also fail-closed (was: || true → host-status.json stayed 600 from
# mktemp if chmod failed, so non-root readers e.g. Caddy reverse-proxy got 403 →
# dashboard showed stale "host-status.json not found" forever). Now log + exit 1
# so the timer goes "failed" and scarlix-doctor surfaces it. (v18.7.2 P1 made the
# mv fail-closed; this closes the second || true in the same block.)
# v18.7.7 P2: use $BRIDGE_LOG (was: hardcoded /var/log/scarlix-host-bridge.log).
chmod 644 "$STATUS_FILE" 2>/dev/null || { echo "FATAL: cannot chmod status" >> "$BRIDGE_LOG"; exit 1; }

exit 0
