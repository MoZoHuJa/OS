[Unit]
Description=SCARLIX OS Host Bridge (privileged ops for ScarliHQ dashboard)
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# v19.0.0 P1-13: flock in script already prevents overlap, but document it
# If the script is already running, the timer's start request is queued
# and executed after the current run completes.
ExecStart=/usr/local/bin/scarlix-host-bridge
# Runs as root (needs nvidia-smi, docker, scarlix-mode)
User=root

# v17.9.9 P1: systemd hardening (root daemon that reads untrusted input from ScarliHQ container)
# Note: Cannot use ProtectSystem=strict or ReadOnlyPaths=/etc because scarlix-mode
# writes to /var/lib/scarlix/current-mode + docker compose needs /opt/scarlix.
# NoNewPrivileges + Restrict* are safe and don't break functionality.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictNamespaces=true
# Restrict to needed address families (docker needs AF_UNIX for socket, AF_INET for pulls)
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Limit capabilities: scarlix-mode needs CAP_SYS_ADMIN (systemctl), CAP_NET_RAW (network)
# v18.8.6 P0-1: +CAP_CHOWN (host-bridge chowns bridge-state/ root:root)
#               +CAP_FOWNER (chmod 700 on files not owned by current user)
#   Without these, chown fails EPERM → host-bridge exits 1 → host-status.json
#   not generated → dashboard shows stale data → mode transitions break.
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_KILL CAP_CHOWN CAP_FOWNER
