[Unit]
Description=SCARLIX OS v19.2.0 — Weekly Model Manager Timer
# v19.1.15 P1-5: Removed Requires=model-manager.service (was systemd anti-pattern
#   that could trigger the service at boot instead of waiting for OnCalendar).
#   Timer automatically targets model-manager.service by basename convention.

[Timer]
OnCalendar=Mon *-*-* 04:00:00
Persistent=true
RandomizedDelaySec=900
AccuracySec=1min

[Install]
WantedBy=timers.target
