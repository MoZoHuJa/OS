[Unit]
Description=SCARLIX OS v19.1.20 — Host Bridge timer (refreshes host-status.json every 5s)
# v19.1.19 P2 (Zmor-2): Removed Requires=scarlix-host-bridge.service. Was: same
#   anti-pattern as model-manager.timer (fixed in v19.1.15). Requires= pulls the
#   service when the timer is enabled, even outside OnUnitActiveSec cycle. Timer
#   targets the service by basename convention — explicit Requires= is redundant
#   and can cause unexpected service starts.

[Timer]
# Every 5 seconds — ScarliHQ dashboard reads host-status.json (fresh data)
OnBootSec=10s
OnUnitActiveSec=5s
# v19.0.0 P1-13: Oneshot + flock prevents overlap (was: concern about stacking
#   instances — but flock -n in the script already exits 0 if another instance
#   is running. This is intentional and documented.)
AccuracySec=1s
Unit=scarlix-host-bridge.service

[Install]
WantedBy=timers.target
