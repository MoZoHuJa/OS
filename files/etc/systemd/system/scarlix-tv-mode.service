[Unit]
Description=SCARLIX OS v19.2.0 — TV mode helpers
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# v18.7.4 P1: Real TV container health check (was: || /bin/true → always SUCCESS)
# v18.7.5 P1: Retry container check (was: single inspect → fail if pull slow).
#   `docker inspect` runs as soon as ExecStartPre finishes, but if docker compose
#   up -d is still pulling the sunshine-tv image, the container doesn't exist
#   yet → inspect fails → oneshot fails → scarlix-mode tv reports failure even
#   though the pull would have finished a second later.
# v18.7.6 P1: 30 retries × 2s = 60s (was: 3 × 2s = 6s → too short for cold pull).
# v18.7.7 P1: 60 retries × 2s = 120s + TimeoutStartSec=300 (was: 30×2s=60s +
#   TimeoutStartSec=90 → cold pulls of multi-GB Sunshine images on slow
#   connections routinely exceed 60s → scarlix-mode tv exits 1 even though
#   the pull was still progressing fine). Now budget is 120s with a 300s
#   systemd safety net so the timer doesn't kill mid-pull.
# NOTE: scarlix-mode v18.7.7 uses `systemctl restart` (not `start`) for this
#   service — RemainAfterExit=yes means the service stays 'active' after the
#   first successful run, and `systemctl start` on an already-active oneshot
#   service does NOT re-run ExecStart. `restart` forces the healthcheck to
#   re-run on every `scarlix-mode tv` invocation.
ExecStartPre=/usr/bin/docker info
TimeoutStartSec=300
ExecStart=/bin/bash -c 'for i in $(seq 1 60); do /usr/bin/docker inspect -f "{{.State.Running}}" sunshine-tv 2>/dev/null | grep -qx true && exit 0; sleep 2; done; exit 1'

[Install]
WantedBy=multi-user.target
