[Unit]
Description=SCARLIX TV mode helpers
After=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# v18.7.4 P1: Real TV container health check (was: || /bin/true → always SUCCESS)
# v18.7.5 P1: Retry container check (was: single inspect → fail if pull slow).
#   `docker inspect` runs as soon as ExecStartPre finishes, but if docker compose
#   up -d is still pulling the sunshine-tv image, the container doesn't exist
#   yet → inspect fails → oneshot fails → scarlix-mode tv reports failure even
#   though the pull would have finished a second later. Now we retry up to 3
#   times with a 2s sleep between attempts (6s total budget — enough for a warm
#   pull, cold pulls still need a longer ExecStartPre timeout, but this fixes
#   the common "first boot after install" race).
ExecStartPre=/usr/bin/docker info
ExecStart=/bin/bash -c 'for i in 1 2 3; do /usr/bin/docker inspect -f "{{.State.Running}}" sunshine-tv 2>/dev/null | grep -qx true && exit 0; sleep 2; done; exit 1'

[Install]
WantedBy=multi-user.target
