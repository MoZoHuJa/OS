[Unit]
Description=SCARLIX OS v16.5 — Weekly Model Manager Timer
Requires=model-manager.service

[Timer]
# FIX 6-b: Run weekly on Monday at 04:00 (low-traffic window)
OnCalendar=Mon *-*-* 04:00:00
# If the system was off at that time, run on next boot
Persistent=true
# Random delay 0-15min to avoid thundering herd on shared HF endpoint
RandomizedDelaySec=900
AccuracySec=1min

[Install]
WantedBy=timers.target
